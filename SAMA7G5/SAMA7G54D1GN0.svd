                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>URAD_1</name>
                           <description>At least one undefined register access has been detected since the last SWRST.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
