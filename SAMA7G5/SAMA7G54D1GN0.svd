                        <enumeratedValue>
                           <name>WPCTEN_0</name>
                           <description>Disables the write protection of the control if WPKEY matches to 0x493253 (I2S in ASCII).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WPCTEN_1</name>
                           <description>Enables the write protection of the control if WPKEY matches to 0x493253 (I2S in ASCII).</description>
                           <value>1</value>
                        </enumeratedValue>
