                     <enumeratedValues>
                        <name>PPOLSelect</name>
                        <enumeratedValue>
                           <name>PPOL_0</name>
                           <description>The pixel stream is sampled on the rising edge of the pixel clock.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PPOL_1</name>
                           <description>The pixel stream is sampled on the falling edge of the pixel clock.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FPOL</name>
