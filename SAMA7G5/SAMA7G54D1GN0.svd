                              <description>Peripheral clock/2</description>
                              <value>1</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>MCK_DIV_4</name>
                              <description>Peripheral clock/4</description>
                              <value>2</value>
                           </enumeratedValue>
                           <enumeratedValue>
