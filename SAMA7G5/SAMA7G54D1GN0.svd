               <resetValue>0x00000070</resetValue>
               <fields>
                  <field>
                     <name>AAON</name>
                     <description>Analog Always On</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>AAONSelect</name>
                        <enumeratedValue>
                           <name>AAON_0</name>
                           <description>The analog part of the pad calibration circuitry is switched off after each calibration (long delay for each calibration).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AAON_1</name>
                           <description>The analog part of the pad calibration circuitry is not switched off after each calibration (shorter delay after the first calibration).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DAPCAL</name>
                     <description>Disable Automatic Pad Calibration</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DAPCALSelect</name>
                        <enumeratedValue>
                           <name>DAPCAL_0</name>
                           <description>Pad calibration is started automatically depending on the configuration of QSPI_REFRESH.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DAPCAL_1</name>
                           <description>Pad calibration is not started automatically.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DIFFPM</name>
                     <description>Differential Pad Mode</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DIFFPMSelect</name>
                        <enumeratedValue>
                           <name>DIFFPM_0</name>
                           <description>Pad differential mode is not enabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIFFPM_1</name>
                           <description>Pad differential mode is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CLKDIV</name>
                     <description>Calibration Clock Division</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>3</bitWidth>
                  </field>
                  <field>
                     <name>CALCNT</name>
                     <description>Pad Calibration Counter</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>9</bitWidth>
                  </field>
                  <field>
                     <name>CALP</name>
                     <description>Calibration Code for P-channel (Read-only)</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>CALN</name>
                     <description>Calibration Code for N-channel (Read-only)</description>
                     <bitOffset>28</bitOffset>
                     <bitWidth>4</bitWidth>
