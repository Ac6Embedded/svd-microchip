                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXFFF_1</name>
                           <description>Transmit FIFO has been filled since the last read of FLEX_TWI_FSR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
