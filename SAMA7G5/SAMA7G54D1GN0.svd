                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>FPHY_1</name>
                              <description>Freezes the following configuration fields of Secure I/O lines if FRZKEY corresponds to 0x494F46 ('IOF' in ASCII):</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>FINT</name>
                        <description>Freeze Interrupt Configuration</description>
