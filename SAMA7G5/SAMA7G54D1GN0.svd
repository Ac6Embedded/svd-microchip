                           <description>Only rising edge of comparator output</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FALLING</name>
                           <description>Falling edge of comparator output</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ANY</name>
                           <description>Any edge of comparator output</description>
                           <value>2</value>
