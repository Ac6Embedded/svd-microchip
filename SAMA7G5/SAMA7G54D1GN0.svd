            </register>
            <register>
               <name>INTSTA</name>
               <description>UDPHS Interrupt Status Register</description>
               <addressOffset>0x14</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>SPEED</name>
                     <description>Speed Status</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SPEEDSelect</name>
                        <enumeratedValue>
                           <name>SPEED_0</name>
                           <description>Reset by hardware when the hardware is in Full Speed mode.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SPEED_1</name>
                           <description>Set by hardware when the hardware is in High Speed mode.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DET_SUSPD</name>
                     <description>Suspend Interrupt</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DET_SUSPDSelect</name>
                        <enumeratedValue>
                           <name>DET_SUSPD_0</name>
                           <description>Cleared by setting the DET_SUSPD bit in UDPHS_CLRINT register.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DET_SUSPD_1</name>
                           <description>Set by hardware when a UDPHS Suspend (Idle bus for three frame periods, a J state for 3 ms) is detected. This triggers a UDPHS interrupt when the DET_SUSPD bit is set in UDPHS_IEN register.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MICRO_SOF</name>
                     <description>Micro Start Of Frame Interrupt</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>MICRO_SOFSelect</name>
                        <enumeratedValue>
                           <name>MICRO_SOF_0</name>
                           <description>Cleared by setting the MICRO_SOF bit in UDPHS_CLRINT register.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MICRO_SOF_1</name>
                           <description>Set by hardware when an UDPHS micro start of frame PID (SOF) has been detected (every 125 us) or synthesized by UDPHS. This triggers a UDPHS interrupt when the MICRO_SOF bit is set in UDPHS_IEN. In case of detected SOF, the MICRO_FRAME_NUM field in UDPHS_FNUM register is incremented and the FRAME_NUMBER field does not change.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>INT_SOF</name>
                     <description>Start Of Frame Interrupt</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>INT_SOFSelect</name>
                        <enumeratedValue>
                           <name>INT_SOF_0</name>
                           <description>Cleared by setting the INT_SOF bit in UDPHS_CLRINT.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>INT_SOF_1</name>
                           <description>Set by hardware when an UDPHS Start Of Frame PID (SOF) has been detected (every 1 ms) or synthesized by UDPHS. This triggers a UDPHS interrupt when the INT_SOF bit is set in UDPHS_IEN register. In case of detected SOF, in High Speed mode, the MICRO_FRAME_NUMBER field is cleared in UDPHS_FNUM register and the FRAME_NUMBER field is updated.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ENDRESET</name>
                     <description>End Of Reset Interrupt</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ENDRESETSelect</name>
                        <enumeratedValue>
                           <name>ENDRESET_0</name>
                           <description>Cleared by setting the ENDRESET bit in UDPHS_CLRINT.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENDRESET_1</name>
                           <description>Set by hardware when an End Of Reset has been detected by the UDPHS controller. This triggers a UDPHS interrupt when the ENDRESET bit is set in UDPHS_IEN.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WAKE_UP</name>
                     <description>Wake Up CPU Interrupt</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WAKE_UPSelect</name>
                        <enumeratedValue>
                           <name>WAKE_UP_0</name>
                           <description>Cleared by setting the WAKE_UP bit in UDPHS_CLRINT.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WAKE_UP_1</name>
                           <description>Set by hardware when the UDPHS controller is in SUSPEND state and is re-activated by a filtered non-idle signal from the UDPHS line (not by an upstream resume). This triggers a UDPHS interrupt when the WAKE_UP bit is set in UDPHS_IEN register. When receiving this interrupt, the user has to enable the device controller clock prior to operation.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ENDOFRSM</name>
                     <description>End Of Resume Interrupt</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ENDOFRSMSelect</name>
                        <enumeratedValue>
                           <name>ENDOFRSM_0</name>
                           <description>Cleared by setting the ENDOFRSM bit in UDPHS_CLRINT.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENDOFRSM_1</name>
                           <description>Set by hardware when the UDPHS controller detects a good end of resume signal initiated by the host. This triggers a UDPHS interrupt when the ENDOFRSM bit is set in UDPHS_IEN.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>UPSTR_RES</name>
                     <description>Upstream Resume Interrupt</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>UPSTR_RESSelect</name>
                        <enumeratedValue>
                           <name>UPSTR_RES_0</name>
                           <description>Cleared by setting the UPSTR_RES bit in UDPHS_CLRINT.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UPSTR_RES_1</name>
                           <description>Set by hardware when the UDPHS controller is sending a resume signal called 'upstream resume'. This triggers a UDPHS interrupt when the UPSTR_RES bit is set in UDPHS_IEN.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EPT_0</name>
                     <description>Endpoint 0 Interrupt (cleared upon USB reset)</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EPT_0Select</name>
                        <enumeratedValue>
                           <name>EPT_0_0</name>
                           <description>Reset when the UDPHS_EPTSTAx interrupt source is cleared.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EPT_0_1</name>
                           <description>Set by hardware when an interrupt is triggered by the UDPHS_EPTSTAx register and this endpoint interrupt is enabled by the EPT_x bit in UDPHS_IEN.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EPT_1</name>
                     <description>Endpoint 1 Interrupt (cleared upon USB reset)</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EPT_1Select</name>
                        <enumeratedValue>
                           <name>EPT_1_0</name>
                           <description>Reset when the UDPHS_EPTSTAx interrupt source is cleared.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EPT_1_1</name>
                           <description>Set by hardware when an interrupt is triggered by the UDPHS_EPTSTAx register and this endpoint interrupt is enabled by the EPT_x bit in UDPHS_IEN.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EPT_2</name>
                     <description>Endpoint 2 Interrupt (cleared upon USB reset)</description>
                     <bitOffset>10</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EPT_2Select</name>
                        <enumeratedValue>
                           <name>EPT_2_0</name>
                           <description>Reset when the UDPHS_EPTSTAx interrupt source is cleared.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EPT_2_1</name>
                           <description>Set by hardware when an interrupt is triggered by the UDPHS_EPTSTAx register and this endpoint interrupt is enabled by the EPT_x bit in UDPHS_IEN.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EPT_3</name>
                     <description>Endpoint 3 Interrupt (cleared upon USB reset)</description>
                     <bitOffset>11</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EPT_3Select</name>
                        <enumeratedValue>
                           <name>EPT_3_0</name>
                           <description>Reset when the UDPHS_EPTSTAx interrupt source is cleared.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EPT_3_1</name>
                           <description>Set by hardware when an interrupt is triggered by the UDPHS_EPTSTAx register and this endpoint interrupt is enabled by the EPT_x bit in UDPHS_IEN.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EPT_4</name>
                     <description>Endpoint 4 Interrupt (cleared upon USB reset)</description>
                     <bitOffset>12</bitOffset>
