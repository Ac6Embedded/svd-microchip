                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SEQE_1</name>
                           <description>A peripheral internal sequencer error has occurred since the last read of PDMC_WPSR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
