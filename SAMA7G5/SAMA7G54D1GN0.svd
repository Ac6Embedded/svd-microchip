                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>NYET_DIS_1</name>
                              <description>Forces an ACK response to the next High Speed Bulk OUT transfer instead of a NYET response.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>ERR_OVFLW</name>
                        <description>Overflow Error Interrupt Enabled (cleared upon USB reset)</description>
