                     </writeConstraint>
                     <enumeratedValues>
                        <name>ENDSelect</name>
                        <enumeratedValue>
                           <name>END_0</name>
                           <description>Data are sent in little-endian format to the memory.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>END_1</name>
                           <description>Data are sent in big-endian format to the memory.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SMRM</name>
                     <description>Serial Memory Register Mode</description>
                     <bitOffset>23</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SMRMSelect</name>
                        <enumeratedValue>
                           <name>SMRM_0</name>
                           <description>Serial Memory registers are written via system bus access.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SMRM_1</name>
                           <description>Serial Memory registers are written via peripheral bus access.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>APBTFRTYP</name>
                     <description>Peripheral Bus Transfer Type</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>APBTFRTYPSelect</name>
                        <enumeratedValue>
                           <name>APBTFRTYP_0</name>
                           <description>Register transfer to the memory is a write transfer. Used when TRFTYP is written to 0 and SMRM to 1.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>APBTFRTYP_1</name>
                           <description>Register transfer to the memory is a read transfer. Used when TRFTYP is written to 0 and SMRM to 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DQSEN</name>
                     <description>DQS Sampling Enable</description>
                     <bitOffset>25</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DQSENSelect</name>
                        <enumeratedValue>
                           <name>DQSEN_0</name>
                           <description>Data from the memory are not sampled with the DQS signal.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DQSEN_1</name>
                           <description>Data from the memory are sampled with the DQS signal.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DDRCMDEN</name>
                     <description>DDR Mode Command Enable</description>
                     <bitOffset>26</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DDRCMDENSelect</name>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>Transfer of instruction field is performed in Single Data Rate mode even if DDREN is written to 1.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLED</name>
                           <description>Transfer of instruction field is performed in Double Data Rate mode if DDREN bit is written to 1. If DDREN is written to 0, the instruction field is sent in Single Data Rate mode.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HFWBEN</name>
                     <description>HyperFlash Write Buffer Enable</description>
                     <bitOffset>27</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>HFWBENSelect</name>
                        <enumeratedValue>
                           <name>HFWBEN_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HFWBEN_1</name>
                           <description>Each write access received on the system bus interface generates a new command. IMPORTANT: Mandatory if the HyperFlash Write Buffer feature is used.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PROTTYP</name>
                     <description>Protocol Type</description>
                     <bitOffset>28</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PROTTYPSelect</name>
                        <enumeratedValue>
                           <name>STD_SPI</name>
                           <description>Standard (Q)SPI protocol (to be selected if no other value matches the device)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TWIN_QUAD</name>
                           <description>Twin-Quad protocol</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OCTAFLASH</name>
                           <description>OctaFlash protocol or Octal DDR protocol with 16-bit instruction code</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HYPERFLASH</name>
                           <description>HyperFlash protocol</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
