                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DM_1</name>
                           <description>DM is high.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CHGDCP</name>
                     <description>Charging Port Detection, Dedicated Charging Port Detection</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CHGDCPSelect</name>
                        <enumeratedValue>
                           <name>CHGDCP_0</name>
