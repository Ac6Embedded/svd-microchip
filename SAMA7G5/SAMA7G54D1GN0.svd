                     <enumeratedValues>
                        <name>WKDSCNNT_ESelect</name>
                        <enumeratedValue>
                           <name>WKDSCNNT_E_0</name>
                           <description>Disables the port to be sensitive to device disconnects as wake-up events.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WKDSCNNT_E_1</name>
                           <description>Enables the port to be sensitive to device disconnects as wake-up events.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WKOC_E</name>
