                     <name>RANGE</name>
                     <description>DLL Range</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RANGESelect</name>
                        <enumeratedValue>
                           <name>RANGE_0</name>
                           <description>The QSPI core clock runs at 25 MHz to 100 MHz.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RANGE_1</name>
                           <description>The QSPI core clock runs at 50 MHz to 208 MHz.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
