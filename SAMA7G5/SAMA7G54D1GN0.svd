                        <enumeratedValue>
                           <name>MCACK_0</name>
                           <description>No host code has been received.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MCACK_1</name>
                           <description>A host code has been received.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
