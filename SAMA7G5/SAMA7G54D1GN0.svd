                     <name>MONTH</name>
                     <description>Month of the Tamper (cleared by reading RTC_TSSRx)</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>5</bitWidth>
                  </field>
                  <field>
                     <name>DAY</name>
                     <description>Day of the Tamper (cleared by reading RTC_TSSRx)</description>
                     <bitOffset>21</bitOffset>
                     <bitWidth>3</bitWidth>
                  </field>
                  <field>
                     <name>DATE</name>
                     <description>Date of the Tamper (cleared by reading RTC_TSSRx)</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>6</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>TSDR1_UTC_MODE</name>
               <description>Timestamp Date Register 1</description>
               <alternateRegister>TSDR1</alternateRegister>
               <addressOffset>0xC0</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>UTC_TIME</name>
