            <register>
               <name>RSR</name>
               <description>Status Register</description>
               <addressOffset>0x20</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>ULOCK</name>
                     <description>Unlocked Receiver</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ULOCKSelect</name>
                        <enumeratedValue>
                           <name>ULOCK_0</name>
                           <description>The receiver is synchronized and loads data, or the receiver is disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ULOCK_1</name>
                           <description>The receiver is not locked because it is searching for SPDIF receive line frequency or preambles. See BADF, LOWF, and NOSIGNAL for reasons of unlocked state.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BADF</name>
                     <description>Bad Format Detected on SPDIF RX Line</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BADFSelect</name>
                        <enumeratedValue>
                           <name>BADF_0</name>
                           <description>The receiver is synchronized or the receiver is searching for SPDIF receive line frequency or preambles.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BADF_1</name>
                           <description>The receiver is not able to detect a SPDIF format on the receive line.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LOWF</name>
                     <description>Low Clock Frequency provided on GCLK Clock</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>LOWFSelect</name>
                        <enumeratedValue>
                           <name>LOWF_0</name>
                           <description>The receiver is synchronized or the receiver is determining the sample frequency of the receive line or searching preambles.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOWF_1</name>
                           <description>The receiver is not able to recover the protocol because the GCLK clock frequency is lower than the minimum required.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOSIGNAL</name>
                     <description>No Signal on Receive Line</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NOSIGNALSelect</name>
                        <enumeratedValue>
                           <name>NOSIGNAL_0</name>
                           <description>The receiver is synchronized or searching for receive line frequency or preambles.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOSIGNAL_1</name>
                           <description>The receiver is not able to find any activity (no edge) on RX line.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IFS</name>
                     <description>Image of Sampling Frequency</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>12</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>RHR</name>
