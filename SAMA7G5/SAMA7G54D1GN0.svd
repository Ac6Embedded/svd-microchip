                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TST</name>
                     <description>Test Pin Monitor (cleared on read)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>JTAG</name>
                     <description>JTAG Pins Monitor (cleared on read)</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DET0</name>
                     <description>PIOBU Intrusion Detector (cleared on read)</description>
                     <bitOffset>18</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DET1</name>
                     <description>PIOBU Intrusion Detector (cleared on read)</description>
                     <bitOffset>19</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DET2</name>
                     <description>PIOBU Intrusion Detector (cleared on read)</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DET3</name>
                     <description>PIOBU Intrusion Detector (cleared on read)</description>
