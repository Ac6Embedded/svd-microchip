                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WKCNNT_E_1</name>
                           <description>Enables the port to be sensitive to device connects as wake-up events.</description>
                           <value>1</value>
                        </enumeratedValue>
