                        </enumeratedValue>
                        <enumeratedValue>
                           <name>XT32KERR_1</name>
                           <description>The frequency of the 32.768 kHz crystal oscillator is incorrect or has been incorrect for an elapsed period of time since the monitoring has been enabled.</description>
                           <value>1</value>
