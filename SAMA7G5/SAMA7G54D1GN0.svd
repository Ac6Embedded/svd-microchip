                        <name>PROC_DEBUG_MONSelect</name>
                        <enumeratedValue>
                           <name>PROC_DEBUG_MON_0</name>
                           <description>The Arm processor pin DBGACK is not monitored; as a consequence, the software can access debug features of the processor without causing an intrusion in the SECUMOD.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PROC_DEBUG_MON_1</name>
                           <description>The Arm processor pin DBGACK is monitored. Processor entering in Debug mode triggers an intrusion</description>
