                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENGCLR_1</name>
                           <description>Enables the GPBR immediate clear on tamper detection event.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
