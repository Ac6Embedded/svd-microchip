                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>FRCESTALL_1</name>
                              <description>Set this bit to request a STALL answer to the host for the next handshake</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>RXRDY_TXKL</name>
                        <description>KILL Bank Set (for IN Endpoint)</description>
                        <bitOffset>9</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
