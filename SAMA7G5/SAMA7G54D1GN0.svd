                  <field>
                     <name>CH31</name>
                     <description>Channel 31 Status</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CH31Select</name>
                        <enumeratedValue>
                           <name>CH31_0</name>
