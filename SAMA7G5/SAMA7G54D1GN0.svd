                  </field>
                  <field>
                     <name>PPCM0</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM1</name>
                     <description>Port Power Control Mask for Downstream Port 1</description>
                     <bitOffset>17</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PPCM1Select</name>
                        <enumeratedValue>
                           <name>PPCM1_0</name>
                           <description>Global power control is implemented for downstream port 1.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PPCM1_1</name>
                           <description>Per-port power control is implemented for downstream port 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PPCM2</name>
                     <description>Port Power Control Mask for Downstream Port 2</description>
                     <bitOffset>18</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PPCM2Select</name>
                        <enumeratedValue>
                           <name>PPCM2_0</name>
                           <description>Global power control is implemented for downstream port 2.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PPCM2_1</name>
                           <description>Per-port power control is implemented for downstream port 2.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PPCM3</name>
                     <description>Port Power Control Mask for Downstream Port 3</description>
                     <bitOffset>19</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PPCM3Select</name>
                        <enumeratedValue>
                           <name>PPCM3_0</name>
                           <description>Global power control is implemented for downstream port 3.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PPCM3_1</name>
                           <description>Per-port power control is implemented for downstream port 3.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PPCM4</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM5</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>21</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM6</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>22</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM7</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>23</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM8</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM9</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>25</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM10</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>26</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM11</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>27</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM12</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>28</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM13</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>29</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM14</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>30</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PPCM15</name>
                     <description>Port Power Control Mask</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>HcRhStatus</name>
               <description>HC Root Hub Status Register</description>
               <addressOffset>0x50</addressOffset>
               <fields>
                  <field>
                     <name>LPS</name>
                     <description>Local Power Status (read/write)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>LPSSelect</name>
                        <enumeratedValue>
                           <name>LPS_0</name>
                           <description>Because the root hub does not support the local power status feature, this bit defaults to 0 and has no effect. This bit has no relationship to the OTG controller register bits that relate to VBUS. System software can update this register to simplify host controller driver and/or OTG driver coding.</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OCI</name>
                     <description>Overcurrent Indicator (read-only)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OCISelect</name>
                        <enumeratedValue>
                           <name>OCI_0</name>
                           <description>Because the device does not provide signals for external hardware to report overcurrent status to the USB1.1 host controller, this bit is always 0. This bit has no relationship to the OTG controller register bits that relate to VBUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DRWE</name>
                     <description>Device Remote Wakeup Enable (read/write)</description>
                     <bitOffset>15</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DRWESelect</name>
                        <enumeratedValue>
                           <name>DRWE_0</name>
                           <description>A write of 0 has no effect. Connect status change events do not cause a transition from USB suspend to USB resume state and the resume detected interrupt is not changed.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DRWE_1</name>
                           <description>A write of 1 sets the device remote wakeup enable bit. This bit enables a connect status change event to be treated as a resume event, which causes a transition from USB suspend to USB resume state and sets the resume detected interrupt status bit.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LPSC</name>
                     <description>Local Power Status Change (read/write)</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>LPSCSelect</name>
                        <enumeratedValue>
                           <name>LPSC_0</name>
                           <description>Because the root hub does not support the local power status feature, this bit defaults to 0 and has no effect. This bit has no relationship to the OTG controller register bits that relate to VBUS. System software can update this register to simplify host controller driver and/or OTG driver coding.</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OCIC</name>
                     <description>Overcurrent Indication Change (read/write)</description>
                     <bitOffset>17</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OCICSelect</name>
                        <enumeratedValue>
                           <name>OCIC_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OCIC_1</name>
                           <description>Clears this bit.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CRWE</name>
                     <description>Clear Remote Wakeup Enable (read/write)</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CRWESelect</name>
                        <enumeratedValue>
                           <name>CRWE_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CRWE_1</name>
                           <description>Clears the device remote wakeup enable bit.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <dim>3</dim>
               <dimIncrement>4</dimIncrement>
               <name>HcRhPortStatus[%s]</name>
               <description>HC Port Status and Control Register (ndp = 0)</description>
               <addressOffset>0x54</addressOffset>
               <resetValue>0x00000100</resetValue>
               <fields>
                  <field>
                     <name>CCS</name>
                     <description>Port Current Connection Status/clear Port Enable (read/write)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CCSSelect</name>
                        <enumeratedValue>
                           <name>CCS_0</name>
                           <description>No USB device is attached to port x.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CCS_1</name>
                           <description>USB device is attached to port x.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PES</name>
                     <description>Port Enable Status/set Port Enable (read/write)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PESSelect</name>
                        <enumeratedValue>
                           <name>PES_0</name>
                           <description>Port x is disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PES_1</name>
                           <description>Port x is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PSS</name>
                     <description>Port Suspend Status/set Port Suspend (read/write)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PSSSelect</name>
                        <enumeratedValue>
                           <name>PSS_0</name>
                           <description>Port x is not in the USB suspend state.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PSS_1</name>
                           <description>Port x is in the USB suspend state or is in the resume sequence.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CSS</name>
                     <description>Port Overcurrent Indicator/clear Suspend Status (read/write)</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CSSSelect</name>
                        <enumeratedValue>
                           <name>CSS_0</name>
                           <description>Port x port overcurrent condition has not occurred.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CSS_1</name>
                           <description>Port x port overcurrent condition has occurred.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PRS</name>
                     <description>Port Reset Status/set Port Reset (read/write)</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PRSSelect</name>
                        <enumeratedValue>
                           <name>PRS_0</name>
                           <description>USB reset is not being sent to port x.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PRS_1</name>
                           <description>Port x is signaling the USB reset.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PPS</name>
                     <description>Port Power Status/set Port Power (read/write)</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PPSSelect</name>
                        <enumeratedValue>
                           <name>PPS_0</name>
                           <description>Port x power is disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PPS_1</name>
                           <description>Port x power is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CPP</name>
                     <description>Low-speed Device Attached/clear Port Power (read/write)</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CPPSelect</name>
                        <enumeratedValue>
                           <name>CPP_0</name>
                           <description>Full-speed device is attached to port x.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CPP_1</name>
                           <description>Low-speed device is attached to port x.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CSC</name>
                     <description>Connect Status Change (read/write, write '1' to clear)</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CSCSelect</name>
                        <enumeratedValue>
                           <name>CSC_0</name>
                           <description>Port x current connect status has not changed.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CSC_1</name>
                           <description>Port x current connect status has changed due to a connect or disconnect event. If current connect status is 0 when a set port reset, set port enable, or set port suspend write occurs, then this bit is set.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PESC</name>
                     <description>Port Enable Status Change (read/write, write '1' to clear)</description>
                     <bitOffset>17</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PESCSelect</name>
                        <enumeratedValue>
                           <name>PESC_0</name>
                           <description>Port x port enable status has not changed.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PESC_1</name>
                           <description>Port x port enable status has changed.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PSSC</name>
                     <description>Port Suspend Status Change (read/write, write '1' to clear)</description>
                     <bitOffset>18</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PSSCSelect</name>
                        <enumeratedValue>
                           <name>PSSC_0</name>
                           <description>Port x port suspend status has not changed.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PSSC_1</name>
                           <description>Port x port suspend status has changed. Suspend status is considered to have changed only after the resume pulse, low-speed EOP, and 3-ms synchronization delays have been completed.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OCIC</name>
                     <description>Overcurrent Indicator Change (read/write)</description>
                     <bitOffset>19</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OCICSelect</name>
                        <enumeratedValue>
                           <name>OCIC_0</name>
                           <description>Because the device does not provide inputs for signaling external overcurrent indication to the USB1.1 host controller, this bit is always 0. Overcurrent monitoring, if required, must be handled through some other mechanism. This bit has no relationship to the OTG controller register bits that relate to VBUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PRSC</name>
                     <description>Port Reset Status Change (read/write, write '1' to clear)</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PRSCSelect</name>
                        <enumeratedValue>
                           <name>PRSC_0</name>
                           <description>Port x port reset status bit has not changed.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PRSC_1</name>
                           <description>Port x port reset status bit has changed.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>UHPHS</name>
         <version>63540</version>
         <description>USB Host High Speed Port</description>
         <baseAddress>0x00500000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0xB0</size>
            <usage>registers</usage>
         </addressBlock>
         <interrupt>
            <name>UHPHS</name>
            <description>USB Host Controller High Speed</description>
            <value>138</value>
         </interrupt>
         <registers>
            <register>
               <name>HCCAPBASE</name>
               <description>UHPHS Host Controller Capability Register</description>
               <addressOffset>0x0</addressOffset>
               <access>read-only</access>
               <resetValue>0x01000010</resetValue>
               <fields>
                  <field>
                     <name>CAPLENGTH</name>
                     <description>Capability Registers Length</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
                  <field>
                     <name>HCIVERSION</name>
                     <description>Host Controller Interface Version Number</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>HCSPARAMS</name>
               <description>UHPHS Host Controller Structural Parameters Register</description>
               <addressOffset>0x4</addressOffset>
               <access>read-only</access>
               <resetValue>0x00001303</resetValue>
               <fields>
                  <field>
                     <name>N_PORTS</name>
                     <description>Number of Ports</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>PPC</name>
                     <description>Port Power Control</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>N_PCC</name>
                     <description>Number of Ports per Companion Controller</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>N_CC</name>
                     <description>Number of Companion Controllers</description>
                     <bitOffset>12</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>P_INDICATOR</name>
                     <description>Port Indicators</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>N_DP</name>
                     <description>Debug Port Number</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>HCCPARAMS</name>
               <description>UHPHS Host Controller Capability Parameters Register</description>
               <addressOffset>0x8</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000026</resetValue>
               <fields>
                  <field>
                     <name>AC</name>
                     <description>64-bit Addressing Capability</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ACSelect</name>
                        <enumeratedValue>
                           <name>AC_0</name>
                           <description>Data structures using 32-bit address memory pointers</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AC_1</name>
                           <description>Data structures using 64-bit address memory pointers</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PFLF</name>
                     <description>Programmable Frame List Flag</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PFLFSelect</name>
                        <enumeratedValue>
                           <name>PFLF_0</name>
                           <description>System software must use a frame list length of 1024 elements with this host controller. The UHPHS_USBCMD register Frame List Size field is a read-only register and must be set to 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PFLF_1</name>
                           <description>System software can specify and use a smaller frame list and configure the host controller via the UHPHS_USBCMD register Frame List Size field. The frame list must always be aligned on a 4-Kbyte page boundary. This requirement ensures that the frame list is always physically contiguous.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ASPC</name>
                     <description>Asynchronous Schedule Park Capability</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ASPCSelect</name>
                        <enumeratedValue>
                           <name>ASPC_0</name>
                           <description>Host controller does not supports the park feature for high-speed queue.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ASPC_1</name>
                           <description>Host controller supports the park feature for high-speed queue heads in the Asynchronous Schedule.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IST</name>
                     <description>Isochronous Scheduling Threshold</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>EECP</name>
                     <description>EHCI Extended Capabilities Pointer</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>USBCMD</name>
               <description>UHPHS USB Command Register</description>
               <addressOffset>0x10</addressOffset>
               <resetValue>0x00080B00</resetValue>
               <fields>
                  <field>
                     <name>RS</name>
                     <description>Run/Stop (read/write)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RSSelect</name>
                        <enumeratedValue>
                           <name>RS_0</name>
                           <description>Host Controller completes the current and any actively pipelined transactions on the USB and then halts.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RS_1</name>
                           <description>Host Controller proceeds with execution of the schedule.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HCRESET</name>
                     <description>Host Controller Reset (read/write)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>FLS</name>
                     <description>Frame List Size (read/write or read-only)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>FLSSelect</name>
                        <enumeratedValue>
                           <name>FLS_0</name>
                           <description>1024 elements (4096 bytes).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FLS_1</name>
                           <description>512 elements (2048 bytes).</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FLS_2</name>
                           <description>256 elements (1024 bytes), for resource-constrained environments.</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PSE</name>
                     <description>Periodic Schedule Enable (read/write)</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PSESelect</name>
                        <enumeratedValue>
                           <name>PSE_0</name>
                           <description>Do not process the Periodic Schedule.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PSE_1</name>
                           <description>Use the UHPHS_PERIODICLISTBASE register to access the Periodic Schedule.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ASE</name>
                     <description>Asynchronous Schedule Enable (read/write)</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ASESelect</name>
                        <enumeratedValue>
                           <name>ASE_0</name>
                           <description>Do not process the Asynchronous Schedule.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ASE_1</name>
                           <description>Use the UHPHS_ASYNCLISTADDR register to access the Asynchronous Schedule.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IAAD</name>
                     <description>Interrupt on Async Advance Doorbell (read/write)</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>LHCR</name>
                     <description>Light Host Controller Reset (optional) (read/write)</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>ASPMC</name>
                     <description>Asynchronous Schedule Park Mode Count (optional) (read/write or read-only)</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>2</bitWidth>
                  </field>
                  <field>
                     <name>ASPME</name>
                     <description>Asynchronous Schedule Park Mode Enable (optional) (read/write or read-only)</description>
                     <bitOffset>11</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
