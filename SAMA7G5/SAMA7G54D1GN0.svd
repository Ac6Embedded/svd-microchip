                           <enumeratedValue>
                              <name>RXRDY_TXKL_0</name>
                              <description>No effect.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>RXRDY_TXKL_1</name>
                              <description>Kill the last written bank.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>TXRDY</name>
                        <description>TX Packet Ready Set</description>
                        <bitOffset>11</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>TXRDYSelect</name>
                           <enumeratedValue>
                              <name>TXRDY_0</name>
                              <description>No effect.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>TXRDY_1</name>
                              <description>Set this bit after a packet has been written into the endpoint FIFO for IN data transfers</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                  </fields>
               </register>
