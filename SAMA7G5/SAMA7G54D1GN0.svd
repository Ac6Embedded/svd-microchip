      <peripheral>
         <name>DWDT</name>
         <version>441490</version>
         <description>Dual Watchdog Timer</description>
         <baseAddress>0xE001C000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x11B0</size>
            <usage>registers</usage>
         </addressBlock>
         <interrupt>
            <name>DWDT_SW</name>
            <description>Dual Watchdog Timer, Secure World</description>
            <value>32</value>
         </interrupt>
         <interrupt>
            <name>DWDT_NSW</name>
            <description>Dual Watchdog Timer, Non Secure World, interrupt</description>
            <value>33</value>
         </interrupt>
         <interrupt>
            <name>DWDT_NSW_ALARM</name>
            <description>Dual Watchdog Timer, Non Secure World Alarm, interrupt</description>
            <value>34</value>
         </interrupt>
         <registers>
            <register>
               <name>NS_WDT_CR</name>
               <description>Never Secure Control Register</description>
               <addressOffset>0x0</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>WDRSTT</name>
                     <description>Watchdog Restart</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WDRSTTSelect</name>
                        <enumeratedValue>
                           <name>WDRSTT_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WDRSTT_1</name>
                           <description>Restarts the watchdog if KEY is written to 0xA5.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LOCKMR</name>
                     <description>Lock Mode Register Write Access</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>LOCKMRSelect</name>
                        <enumeratedValue>
                           <name>LOCKMR_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LOCKMR_1</name>
                           <description>Locks the configuration registers if KEY is written to 0xA5. Write accesses to NS_WDT_MR, NS_WDT_VR, NS_WDT_WL and NS_WDT_IL have no effect.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>KEY</name>
                     <description>Password</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>8</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>KEYSelect</name>
                        <enumeratedValue>
                           <name>PASSWD</name>
                           <description>Writing any other value in this field aborts the write operation.</description>
                           <value>0xA5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>NS_WDT_MR</name>
               <description>Never Secure Mode Register</description>
               <addressOffset>0x4</addressOffset>
               <resetValue>0x00000030</resetValue>
               <fields>
                  <field>
                     <name>WDDIS</name>
                     <description>Watchdog Disable</description>
                     <bitOffset>12</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WDDISSelect</name>
                        <enumeratedValue>
                           <name>WDDIS_0</name>
                           <description>Enables the Watchdog Timer.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WDDIS_1</name>
                           <description>Disables the Watchdog Timer.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WDIDLEHLT</name>
                     <description>Watchdog Idle Halt</description>
                     <bitOffset>28</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WDIDLEHLTSelect</name>
                        <enumeratedValue>
                           <name>WDIDLEHLT_0</name>
                           <description>The watchdog runs when the system is in Idle state.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WDIDLEHLT_1</name>
                           <description>The watchdog stops when the system is in Idle state.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WDDBGHLT</name>
                     <description>Watchdog Debug Halt</description>
                     <bitOffset>29</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WDDBGHLTSelect</name>
                        <enumeratedValue>
                           <name>WDDBGHLT_0</name>
                           <description>The watchdog runs when the processor is in Debug state.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WDDBGHLT_1</name>
                           <description>The watchdog stops when the processor is in Debug state.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>NS_WDT_VR</name>
               <description>Never Secure Value Register</description>
               <addressOffset>0x8</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000FFF</resetValue>
               <fields>
                  <field>
                     <name>COUNTER</name>
                     <description>Watchdog Down Counter Value</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>12</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>NS_WDT_WL</name>
               <description>Never Secure Window Level Register</description>
               <addressOffset>0xC</addressOffset>
               <resetValue>0x00000FFF</resetValue>
               <fields>
                  <field>
                     <name>PERIOD</name>
                     <description>Watchdog Period</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>12</bitWidth>
                  </field>
                  <field>
                     <name>RPTH</name>
                     <description>Repeat Threshold</description>
