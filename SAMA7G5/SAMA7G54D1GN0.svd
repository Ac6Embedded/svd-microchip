                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>BL</name>
                     <description>Blanking Data Interrupt Disable Bit</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>EB</name>
                     <description>Embedded 8-bit Non-Image Data Interrupt Disable Bit</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>RE</name>
                     <bitOffset>12</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>GLPIMR</name>
               <description>GLP Interrupt Mask Register</description>
               <addressOffset>0x84</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>NU</name>
                     <description>Null Packet Interrupt Mask Bit</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NUSelect</name>
                        <enumeratedValue>
                           <name>NU_0</name>
                           <description>A bit cleared at position i in the field NU indicates that the Null Packet interrupt is masked for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NU_1</name>
                           <description>A bit set at position i in field NU indicates that the Null Packet interrupt is activated for virtual channel i.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BL</name>
                     <description>Blanking Data Packet Interrupt Mask Bit</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BLSelect</name>
                        <enumeratedValue>
                           <name>BL_0</name>
                           <description>A bit cleared at position i in the field BL indicates that the Blanking Data Packet interrupt is masked for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BL_1</name>
                           <description>A bit set at position i in field BL indicates that the Blanking Data Packet interrupt is activated for virtual channel i.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EB</name>
                     <description>Embedded 8-bit Non-Image Data Packet Interrupt Mask Bit</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EBSelect</name>
                        <enumeratedValue>
                           <name>EB_0</name>
                           <description>A bit cleared at position i in the field EB indicates that the embedded data packet interrupt is masked for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EB_1</name>
                           <description>A bit set at position i in field EB indicates that the embedded data packet interrupt is activated for virtual channel i.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RE</name>
                     <bitOffset>12</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RESelect</name>
                        <enumeratedValue>
                           <name>RE_0</name>
                           <description>A bit cleared at position i in the field RE indicates that the Reserved Packet interrupt is masked for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RE_1</name>
                           <description>A bit set at position i in field NU indicates that the Reserved Packet interrupt is activated for virtual channel i.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>GLPISR</name>
               <description>GLP Interrupt Status Register</description>
               <addressOffset>0x88</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>NU</name>
                     <description>Null Generic Long Packet Ready Interrupt Status Bit</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NUSelect</name>
                        <enumeratedValue>
                           <name>NU_0</name>
                           <description>A bit cleared at position i in the field NU indicates that no null packet interrupt is pending for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NU_1</name>
                           <description>A bit set at position i in the field NU indicates that a null packet interrupt is pending for virtual channel i. This bit is reset after the register read operation.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BL</name>
                     <description>Blanking Data Generic Long Packet Ready Interrupt Status Bit</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BLSelect</name>
                        <enumeratedValue>
                           <name>BL_0</name>
                           <description>A bit cleared at position i in the field BL indicates that no blanking data packet interrupt is pending for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BL_1</name>
                           <description>A bit set at position i in the field BL indicates that a blanking packet interrupt is pending for virtual channel i. This bit is reset after the register read operation.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EB</name>
                     <description>Embedded 8-bit data Generic Long Packet Ready Interrupt Status Bit</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EBSelect</name>
                        <enumeratedValue>
                           <name>EB_0</name>
                           <description>A bit cleared at position i in the field EB indicates that no embedded data packet interrupt is pending for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EB_1</name>
                           <description>A bit set at position i in the field EB indicates that an embedded data packet interrupt is pending for virtual channel i. This bit is reset after the register read operation.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RE</name>
                     <bitOffset>12</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RESelect</name>
                        <enumeratedValue>
                           <name>RE_0</name>
                           <description>A bit cleared at position i in the field BL indicates that no reserved packet interrupt is pending for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RE_1</name>
                           <description>A bit set at position i in the field BL indicates that a reserved packet interrupt is pending for virtual channel i. This bit is reset after the register read operation.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IDSCR</name>
               <description>IDS Control Register</description>
               <addressOffset>0x8C</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>SWRST</name>
                     <description>Software Reset</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SWRSTSelect</name>
                        <enumeratedValue>
                           <name>SWRST_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SWRST_1</name>
                           <description>Performs an IDS software reset of the table. Read value when set indicates that the software reset is in progress.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IDSIER</name>
               <description>IDS Interrupt Enable Register</description>
               <addressOffset>0x90</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>IDS</name>
                     <description>Image Data Snoop Interrupt Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>IDSSelect</name>
                        <enumeratedValue>
                           <name>IDS_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDS_1</name>
                           <description>Setting a bit at position i in the IDS field will set the interrupt mask bit for table entry i, and this entry can generate an interrupt when an image data packet is captured by the snoop controller.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVF</name>
                     <description>Image Data Snoop Overflow Interrupt Enable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVFSelect</name>
                        <enumeratedValue>
                           <name>OVF_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVF_1</name>
                           <description>Enables the Image Data Snoop Overflow interrupt.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IDSIDR</name>
               <description>IDS Interrupt Disable Register</description>
               <addressOffset>0x94</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>IDS</name>
                     <description>Image Data Snoop Interrupt Disable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>IDSSelect</name>
                        <enumeratedValue>
                           <name>IDS_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDS_1</name>
                           <description>Setting a bit at position i in the IDS field will clear the interrupt mask bit for table entry i.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVF</name>
                     <description>Image Data Snoop Overflow Interrupt Disable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVFSelect</name>
                        <enumeratedValue>
                           <name>OVF_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVF_1</name>
                           <description>Disables the Image Data Snoop Overflow interrupt.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IDSIMR</name>
               <description>IDS Interrupt Mask Register</description>
               <addressOffset>0x98</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>IDS</name>
                     <description>Image Data Snoop Interrupt Mask Bit</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>IDSSelect</name>
                        <enumeratedValue>
                           <name>IDS_0</name>
                           <description>A bit cleared at position i in the field IDS indicates that the Image Data Snoop interrupt is masked for table entry i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDS_1</name>
                           <description>A bit set at position i in field IDS indicates that Image Data Snoop interrupt is activated for table entry i.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVF</name>
                     <description>Image Data Snoop Overflow Interrupt Mask</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVFSelect</name>
                        <enumeratedValue>
                           <name>OVF_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVF_1</name>
                           <description>Indicates that the Image Data Snoop Overflow interrupt is activated.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IDSISR</name>
               <description>IDS Interrupt Status Register</description>
               <addressOffset>0x9C</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>IDS</name>
                     <description>Image Data Snoop Interrupt Status Bit</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>IDSSelect</name>
                        <enumeratedValue>
                           <name>IDS_0</name>
                           <description>A bit cleared at position i in the field IDS indicates that no Image Data Snoop interrupt is pending for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IDS_1</name>
                           <description>A bit set at position i in the field IDS indicates that a new Image Data Snoop entry interrupt is pending for table entry i. This bit is reset after the register read operation.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVF</name>
                     <description>Image Data Snoop Overflow Interrupt Status</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVFSelect</name>
                        <enumeratedValue>
                           <name>OVF_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVF_1</name>
                           <description>Indicates that the IDS controller captured more than 4 entries. This bit is reset after the register read operation.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <cluster>
               <dim>4</dim>
               <dimIncrement>0x8</dimIncrement>
               <name>CSI2DC_IDSEW[%s]</name>
               <description/>
               <addressOffset>0xA0</addressOffset>
               <register>
                  <name>IDSEW0R</name>
                  <description>IDS Entry Word 0 Register </description>
                  <addressOffset>0x0</addressOffset>
                  <access>read-only</access>
                  <fields>
                     <field>
                        <name>DT</name>
                        <description>Data Type</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>6</bitWidth>
                     </field>
                     <field>
                        <name>VC</name>
                        <description>Virtual Channel Identifier</description>
                        <bitOffset>6</bitOffset>
                        <bitWidth>2</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>VCSelect</name>
                           <enumeratedValue>
                              <name>VC0</name>
                              <description>Virtual Channel 0</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>VC1</name>
                              <description>Virtual Channel 1</description>
                              <value>1</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>VC2</name>
                              <description>Virtual Channel 2</description>
                              <value>2</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>VC3</name>
                              <description>Virtual Channel 3</description>
                              <value>3</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>IDSEW1R</name>
                  <description>IDS Entry Word 1 Register </description>
                  <addressOffset>0x4</addressOffset>
                  <access>read-only</access>
                  <fields>
                     <field>
                        <name>WC</name>
                        <description>Word Count for Image Data Packet Captured</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>16</bitWidth>
                     </field>
                     <field>
                        <name>RC</name>
                        <description>Row Count for Image Data Packet Captured</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>16</bitWidth>
                     </field>
                  </fields>
               </register>
            </cluster>
            <register>
               <name>PUR</name>
               <description>Pipe Update Register</description>
               <addressOffset>0xC0</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>VP</name>
                     <description>Video Pipe Attributes Update</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>VPSelect</name>
                        <enumeratedValue>
                           <name>VP_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VP_1</name>
                           <description>Transfers current configuration to Video Pipe Configuration registers on the next Frame Start packet detection if the FS packet virtual channel ID matches the CSI2DC_VPCFG.VC field. This field must be set after video pipe configuration, otherwise the settings will not be updated.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DP</name>
                     <description>Data Pipe Attributes Update</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DPSelect</name>
                        <enumeratedValue>
                           <name>DP_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DP_1</name>
                           <description>Transfers current configuration to Data Pipe Configuration registers on the next Frame Start packet detection if the FS packet virtual channel ID matches the CSI2DC_DPCFG.VC field. This field must be set after data pipe configuration, otherwise the settings will not be updated.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>PUSR</name>
               <description>Pipe Update Status Register</description>
               <addressOffset>0xC4</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>VP</name>
                     <description>Video Pipe Update</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>VPSelect</name>
                        <enumeratedValue>
                           <name>VP_0</name>
                           <description>No video pipe in progress.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VP_1</name>
                           <description>Video pipe configuration is in progress. This bit is cleared at the next Frame Start packet if the virtual channel identifier matches the CSI2DC_VPCFG.VC field.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DP</name>
                     <description>Data Pipe Update</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DPSelect</name>
                        <enumeratedValue>
                           <name>DP_0</name>
                           <description>No data pipe in progress.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DP_1</name>
                           <description>Data pipe configuration is in progress. This bit is cleared at the next Frame Start packet if the virtual channel identifier matches the CSI2DC_DPCFG.VC field.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SIP</name>
                     <description>Synchronization In Progress</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SIPSelect</name>
                        <enumeratedValue>
                           <name>SIP_0</name>
                           <description>No synchronization pending.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SIP_1</name>
                           <description>Synchronization across clock domain boundary is in progress. If the MIPI interface clock is gated, the synchronization procedure will wait for the first valid MIPI packet to activate the receiver clock.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DPIER</name>
               <description>Data Pipe Interrupt Enable Register</description>
               <addressOffset>0xC8</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>CAPTURE</name>
                     <description>Data Pipe Capture Done Interrupt Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RXRDY0</name>
                     <description>Bank 0, Packet Received Interrupt Enable</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RXRDY1</name>
                     <description>Bank 1, Packet Received Interrupt Enable</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RXOVF0</name>
                     <description>Bank 0, Packet Overflow Interrupt Enable</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RXOVF1</name>
                     <description>Bank 1, Packet Overflow Interrupt Enable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DATOVF</name>
                     <description>Data Pipe Overflow Interrupt Enable</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>STE</name>
                     <description>Shorter Than Expected Packet Received Interrupt Enable</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>LTE</name>
                     <description>Longer Than Expected Packet Received Interrupt Enable Bit</description>
                     <bitOffset>7</bitOffset>
