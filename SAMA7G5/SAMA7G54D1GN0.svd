                        <enumeratedValue>
                           <name>WPCTEN_0</name>
                           <description>Disables the write protection of the control if WPKEY matches to 0x4F5450 (OTP in ASCII).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WPCTEN_1</name>
                           <description>Enables the write protection of the control if WPKEY matches to 0x4F5450 (OTP in ASCII).</description>
                           <value>1</value>
