                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RECEIVE</name>
                           <description>Receive start</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TF_LOW</name>
