                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EPSelect</name>
                        <enumeratedValue>
                           <name>EP_0</name>
                           <description>The MCAN is in the Error_Active state. It normally takes part in bus communication and sends an active error flag when an error has been detected.</description>
                           <value>0</value>
