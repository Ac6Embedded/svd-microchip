                        <enumeratedValue>
                           <name>WKOC_E_0</name>
                           <description>Disables the port to be sensitive to over-current conditions as wake-up events.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WKOC_E_1</name>
                           <description>Enables the port to be sensitive to over-current conditions as wake-up events.</description>
