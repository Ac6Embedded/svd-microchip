                     <enumeratedValues>
                        <name>PKRSSelect</name>
                        <enumeratedValue>
                           <name>PKRS_0</name>
                           <description>The key used by the TZAESB is in the TZAESB_KEYWRx.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PKRS_1</name>
                           <description>The key used by the TZAESB is in the Private Key internal registers written through the Private Key bus.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
