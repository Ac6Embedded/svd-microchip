                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BCIDPSRCE_1</name>
                           <description>Battery charging IDP current source is enabled for data contact detection.</description>
                           <value>1</value>
                        </enumeratedValue>
