                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WPCFEN_1</name>
                           <description>Enables the write protection of the configuration if WPKEY matches to 0x4F5450 (OTP in ASCII).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
