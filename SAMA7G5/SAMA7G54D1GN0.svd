            <register>
               <name>CH_CONF</name>
               <description>Channel Configuration Register</description>
               <addressOffset>0x20</addressOffset>
               <fields>
                  <field>
                     <name>THROPMODE</name>
                     <description>Transmit Holding Registers Operating Mode</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>3</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>THROPMODESelect</name>
                        <enumeratedValue>
                           <name>THRX_UPTO_2CH</name>
                           <description>The ASRC_THRx can receive up to 2 audio streams (e.g. 1 stereo channel for each ASRC_THR). Each ASRC_THRx is routed on each Stereo DSP x.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>THR0_UPTO_4CH</name>
                           <description>The ASRC_THR0 can receive up to 4 audio streams (e.g. up to 2 stereo channels on ASRC_THR0). The ARSC_THR1 can receive up to 2 audio streams (e.g. 1 stereo channel on ASRC_THR1). The ARSC_THR2 can receive up to 2 audio streams (e.g. 1 stereo channel on ASRC_THR2). ASRC_THR3 must not be used.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>THR01_UPTO_4CH</name>
                           <description>The ASRC_THR0 can receive up to 4 audio streams (e.g. up to 2 stereo channels on ASRC_THR0). The ASRC_THR1 can receive up to 4 audio streams (e.g. up to 2 stereo channels on ASRC_THR1). ASRC_THR2 and ASRC_THR3 must not be used.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>THR0_UPTO_6CH</name>
                           <description>The ASRC_THR0 can receive up to 6 audio streams (e.g. up to 3 stereo channels on ASRC_THR0). The ARSC_THR1 can receive up to 2 audio streams (e.g. 1 stereo channel on ASRC_THR1) ASRC_THR2 and ASRC_THR3 must not be used.</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>THR0_UPTO_8CH</name>
                           <description>The ASRC_THR0 can receive up to 8 audio streams (e.g. up to 4 stereo channels on ASRC_THR0). ASRC_THR1,ASRC_THR2 and ASRC_RHR3 must not be used.</description>
                           <value>4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RHROPMODE</name>
                     <description>Receive Holding Registers Operating Mode</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>3</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RHROPMODESelect</name>
                        <enumeratedValue>
                           <name>RHRX_UPTO_2CH</name>
                           <description>The ASRC_RHRx can receive up to 2 audio streams (e.g. 1 stereo channel for each ASRC_RHR). Each ASRC_RHRx is routed on each Stereo DSP x.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RHR0_UPTO_4CH</name>
                           <description>The ASRC_RHR0 can receive up to 4 audio streams (e.g. up to 2 stereo channels on ASRC_RHR0). The ARSC_RHR1 can receive up to 2 audio streams (e.g. 1 stereo channel on ASRC_RHR1). The ARSC_RHR2 can receive up to 2 audio streams (e.g. 1 stereo channel on ASRC_RHR2). ASRC_RHR3 must not be used.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RHR01_UPTO_4CH</name>
                           <description>The ASRC_RHR0 can receive up to 4 audio streams (e.g. up to 2 stereo channels on ASRC_RHR0). The ASRC_RHR1 can receive up to 4 audio streams (e.g. up to 2 stereo channels on ASRC_RHR1). ASRC_RHR2 and ASRC_RHR3 must not be used.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RHR0_UPTO_6CH</name>
                           <description>The ASRC_RHR0 can receive up to 6 audio streams (e.g. up to 3 stereo channels on ASRC_RHR0). The ARSC_RHR1 can receive up to 2 audio streams (e.g. 1 stereo channel on ASRC_RHR1) ASRC_RHR2 and ASRC_RHR3 must not be used.</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RHR0_UPTO_8CH</name>
                           <description>The ASRC_RHR0 can receive up to 8 audio streams (e.g. up to 4 stereo channels on ASRC_RHR0). ASRC_RHR1,ASRC_RHR2 and ASRC_RHR3 must not be used.</description>
                           <value>4</value>
                        </enumeratedValue>
                     </enumeratedValues>
