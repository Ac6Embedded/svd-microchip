                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TAMPFRZSelect</name>
                        <enumeratedValue>
                           <name>TAMPFRZ_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TAMPFRZ_1</name>
                           <description>Freezes Secure I/O lines on tamper event detection if FRZKEY corresponds to 0x545046 ('TPF' in ASCII).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FRZKEY</name>
                     <description>Freeze Key</description>
