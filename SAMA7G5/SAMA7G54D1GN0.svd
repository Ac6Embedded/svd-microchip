                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLE_1</name>
                           <description>Gamma correction is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BENABLE</name>
