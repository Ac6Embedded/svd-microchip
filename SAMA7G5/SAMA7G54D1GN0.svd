                  </field>
                  <field>
                     <name>RXFFF</name>
                     <description>Receive FIFO Full Flag</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXFFFSelect</name>
                        <enumeratedValue>
                           <name>RXFFF_0</name>
                           <description>Receive FIFO is not empty.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXFFF_1</name>
                           <description>Receive FIFO has been filled since the last read of FLEX_TWI_FSR.</description>
                           <value>1</value>
