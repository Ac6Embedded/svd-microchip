                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FPOL_1</name>
                           <description>Top field is sampled when F value is 1; Bottom field is sampled when F value is 0.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
