                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CHGDCP_1</name>
                           <description>Charging port detected</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CC1ID</name>
                     <description>Type-C CC1 Comparator</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CC1IDSelect</name>
                        <enumeratedValue>
                           <name>CC1ID_0</name>
                           <description>The CC1 comparator output is low. Voltage is below the selected TCPC_UPC.TCIDCTSEL threshold for Power Source Detection at Sink and is above the selected TCPC_UPC.TCIDCTSEL threshold for Sink Detection at Power Source.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CC1ID_1</name>
                           <description>The CC1 comparator output is high. Voltage is above the selected TCPC_UPC.TCIDCTSEL threshold for Power Source Detection at Sink and is below the selected TCPC_UPC.TCIDCTSEL threshold for Sink Detection at Power Source.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CC2RDT</name>
                     <description>Type-C CC2 Comparator</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CC2RDTSelect</name>
                        <enumeratedValue>
                           <name>CC2RDT_0</name>
                           <description>The CC2 comparator output is low. Voltage is below the selected TCUPC.TCIDCTSEL threshold for Power Source Detection at Sink and is above the selected TCPC_UPC.TCIDCTSEL threshold for Sink Detection at Power Source.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CC2RDT_1</name>
                           <description>The CC2 comparator output is high. Voltage is above the selected TCUPC.TCIDCTSEL threshold for Power Source Detection at Sink and is below the selected TCPC_UPC.TCIDCTSEL threshold for Sink Detection at Power Source.</description>
                           <value>1</value>
                        </enumeratedValue>
