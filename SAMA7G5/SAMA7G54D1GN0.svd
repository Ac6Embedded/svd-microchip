                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RDY0_1</name>
                           <description>The interrupt line x glitch filter configuration is done and the glitch filter is active. The glitch filter can be programmed in EIC_SCFGxR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
