                           <description>Static detection intrusion (default).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DYNSTAT_1</name>
                           <description>Dynamic detection intrusion.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
