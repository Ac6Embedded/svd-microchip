                     </writeConstraint>
                     <enumeratedValues>
                        <name>FESelect</name>
                        <enumeratedValue>
                           <name>DIS</name>
                           <description>The FAULT output is tied to 0.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN</name>
                           <description>The FAULT output is driven by the signal defined by SELFS.</description>
