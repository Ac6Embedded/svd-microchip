                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXFTHF_1</name>
                           <description>Number of data in Transmit FIFO has reached TXFTHRES threshold since the last read of FLEX_TWI_FSR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXFEF</name>
                     <description>Receive FIFO Empty Flag</description>
