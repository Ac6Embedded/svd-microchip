                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ALWYSON_1</name>
                           <description>Calibration analog remains powered after calibration.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TUNDIS</name>
                     <description>Calibration During Tuning Disabled</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TUNDISSelect</name>
                        <enumeratedValue>
                           <name>TUNDIS_0</name>
                           <description>Calibration is launched before each tuning.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TUNDIS_1</name>
                           <description>Calibration is not launched at tuning.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
