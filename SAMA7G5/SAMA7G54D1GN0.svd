                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SCRKL_1</name>
                           <description>QSPI_SKR.USRK cannot be written until the next VDDCORE reset.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
