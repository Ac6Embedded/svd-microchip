                           <name>ADDREN_0</name>
                           <description>The transfer address is not sent to the serial Flash memory.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ADDREN_1</name>
                           <description>The transfer address is sent to the serial Flash memory.</description>
