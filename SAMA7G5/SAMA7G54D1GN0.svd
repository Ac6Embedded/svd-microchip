                  <field>
                     <name>CSC</name>
                     <description>Connect Status Change (read/write clear)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CSCSelect</name>
                        <enumeratedValue>
