                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BCVSRCE_1</name>
                           <description>Battery charging voltage source enable:</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BCDETE</name>
                     <description>Battery Charging Detection Enable</description>
                     <bitOffset>29</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
