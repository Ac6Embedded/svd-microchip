                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CKI_1</name>
                           <description>The data outputs (Data and Frame Sync signals) are shifted out on Transmit Clock rising edge. The Frame Sync signal input is sampled on Transmit Clock falling edge.</description>
                           <value>1</value>
                        </enumeratedValue>
