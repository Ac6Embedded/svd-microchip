                     <enumeratedValues>
                        <name>SELFSSelect</name>
                        <enumeratedValue>
                           <name>CE</name>
                           <description>The CE flag is used to drive the FAULT output.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OUTPUT</name>
                           <description>The output of the analog comparator flag is used to drive the FAULT output.</description>
