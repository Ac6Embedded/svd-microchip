                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BL_1</name>
                           <description>Setting a bit at position i in the BL field sets the interrupt mask bit for virtual channel i, and this virtual channel can generate an interrupt when a Blank packet is detected.</description>
                           <value>1</value>
                        </enumeratedValue>
