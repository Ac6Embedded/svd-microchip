                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>GENABLE_1</name>
                           <description>Piecewise interpolation is used to perform 12-bit to 10-bit compression for the green channel.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RENABLE</name>
