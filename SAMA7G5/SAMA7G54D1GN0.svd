                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CH31_1</name>
                           <description>The corresponding channel (or part of sequence, see ADC_SEQyR.USCHx) is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
