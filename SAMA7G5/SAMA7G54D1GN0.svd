                        <name>HPOLSelect</name>
                        <enumeratedValue>
                           <name>HPOL_0</name>
                           <description>HSYNC signal is active high, i.e. valid pixels are sampled when HSYNC is asserted.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HPOL_1</name>
                           <description>HSYNC signal is active low, i.e. valid pixels are sampled when HSYNC is deasserted.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
