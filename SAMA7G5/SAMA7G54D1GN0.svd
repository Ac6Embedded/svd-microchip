                     <enumeratedValues>
                        <name>DMPDFESelect</name>
                        <enumeratedValue>
                           <name>DMPDFE_0</name>
                           <description>DM pull-down is not forced to the active state by the TCPC.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DMPDFE_1</name>
                           <description>DM pull-down is forced to the active state by the TCPC for battery charging data contact detection.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BCIDPSRCE</name>
                     <description>Battery Charging IDP Source Enable</description>
                     <bitOffset>26</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
