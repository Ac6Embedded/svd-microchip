                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BCDETSEL_1</name>
                           <description>Battery charging secondary detection is selected.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BCVSRCE</name>
                     <description>Battery Charging Voltage Source Enable</description>
                     <bitOffset>28</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
