      <peripheral>
         <name>SECUMOD</name>
         <version>441800</version>
         <description>Security Module</description>
         <baseAddress>0xE0004000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0xA0</size>
            <usage>registers</usage>
         </addressBlock>
         <interrupt>
            <name>SECUMOD</name>
            <description>Security Module</description>
            <value>49</value>
         </interrupt>
         <registers>
            <register>
               <name>CR</name>
               <description>Control Register</description>
               <addressOffset>0x0</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>BACKUP</name>
                     <description>Backup Mode</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BACKUPSelect</name>
                        <enumeratedValue>
                           <name>BACKUP_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BACKUP_1</name>
                           <description>Switches to Backup mode.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NORMAL</name>
                     <description>Normal Mode</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NORMALSelect</name>
                        <enumeratedValue>
                           <name>NORMAL_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NORMAL_1</name>
                           <description>Switches to Normal mode.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SWPROT</name>
                     <description>Software Protection</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SWPROTSelect</name>
                        <enumeratedValue>
                           <name>SWPROT_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SWPROT_1</name>
                           <description>Starts the BUSRAM4KB and BUREG256b Clear content.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NIMP_EN</name>
                     <description>Non-Imprinting</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NIMP_ENSelect</name>
                        <enumeratedValue>
                           <name>EN_NIMP</name>
                           <description>The non-imprinting mechanism is authorized to start when core power is off or bus reset is asserted</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>The non-imprinting mechanism is disabled (default)</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN_NIMP_IDLE</name>
                           <description>The non-imprinting mechanism is authorized to start when core power is off or bus reset is asserted or the CPU is idle</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AUTOBKP</name>
                     <description>Automatic Normal to Backup Mode Switching</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>AUTOBKPSelect</name>
                        <enumeratedValue>
                           <name>AUTO_BCKP</name>
                           <description>When in Normal mode, the power-down of the core supply automatically switches to Backup mode simultaneously with core to backup isolation barrier activation (default).</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SW_BCKP</name>
                           <description>When in Normal mode, the software must switch to Backup mode before powering down the core.</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SCRAMB</name>
                     <description>Memory Scrambling Enable</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SCRAMBSelect</name>
                        <enumeratedValue>
                           <name>SCRAMB</name>
                           <description>Memories are scrambled (default).</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NO_SCRAMB</name>
                           <description>Memories are not scrambled.</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>KEY</name>
                     <description>Password</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYSR</name>
               <description>System Status Register</description>
               <addressOffset>0x4</addressOffset>
               <resetValue>0x000000D4</resetValue>
               <fields>
                  <field>
                     <name>ERASE_DONE</name>
                     <description>Erasable Memories State (RW)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ERASE_DONESelect</name>
                        <enumeratedValue>
                           <name>ERASE_DONE_0</name>
                           <description>Content of the secure memories has not been erased since the last clear.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ERASE_DONE_1</name>
                           <description>Content of the secure memories has been erased since the last clear. Write a '1' to this bit to clear this flag. The flag also activates the SECURAM interrupt line as long as it is not cleared.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ERASE_ON</name>
                     <description>Erase Process Ongoing (RO)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ERASE_ONSelect</name>
                        <enumeratedValue>
                           <name>ERASE_ON_0</name>
                           <description>Erase automaton is not running.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ERASE_ON_1</name>
                           <description>Erase automaton is currently running, memories are not accessible.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BACKUP</name>
                     <description>Backup Mode (RO)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BACKUPSelect</name>
                        <enumeratedValue>
                           <name>BACKUP_0</name>
                           <description>Normal mode active.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BACKUP_1</name>
                           <description>Backup mode active.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SWKUP</name>
                     <description>SWKUP State (RO)</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SWKUPSelect</name>
                        <enumeratedValue>
                           <name>SWKUP_0</name>
                           <description>No SWKUP signal sent since the last clear.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SWKUP_1</name>
                           <description>SWKUP signal has been sent since the last clear.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NIMP_EN</name>
                     <description>Non-Imprinting Enabled (RO)</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NIMP_ENSelect</name>
                        <enumeratedValue>
                           <name>NIMP_EN_0</name>
                           <description>Disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NIMP_EN_1</name>
                           <description>Enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>AUTOBKP</name>
                     <description>Automatic Backup Mode Enabled (RO)</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>AUTOBKPSelect</name>
                        <enumeratedValue>
                           <name>AUTOBKP_0</name>
                           <description>Disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AUTOBKP_1</name>
                           <description>Enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SCRAMB</name>
                     <description>Scrambling Enabled (RO)</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SCRAMBSelect</name>
                        <enumeratedValue>
                           <name>SCRAMB_0</name>
                           <description>Disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SCRAMB_1</name>
                           <description>Enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NIMP_IDLE</name>
                     <description>'CPU in Idle' Preliminary Condition for Non-Imprinting (RO)</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NIMP_IDLESelect</name>
                        <enumeratedValue>
                           <name>NIMP_IDLE_0</name>
                           <description>Idle is not part of the preliminary conditions list.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NIMP_IDLE_1</name>
                           <description>Idle is part of the preliminary conditions list.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
