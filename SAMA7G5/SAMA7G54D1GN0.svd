               </register>
               <register>
                  <name>CDS_MSP</name>
                  <description>Channel Data Stride Memory Set Pattern </description>
                  <addressOffset>0x2C</addressOffset>
                  <fields>
                     <field>
                        <name>SDS_MSP</name>
