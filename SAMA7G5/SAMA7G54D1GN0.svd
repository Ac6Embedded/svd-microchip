                     </writeConstraint>
                     <enumeratedValues>
                        <name>FSSelect</name>
                        <enumeratedValue>
                           <name>FS_0</name>
                           <description>A bit cleared at position i in the field FS indicates that the Frame Start interrupt is masked for virtual channel i.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FS_1</name>
