                           <name>EPT_ENABLSelect</name>
                           <enumeratedValue>
                              <name>EPT_ENABL_0</name>
                              <description>The endpoint is disabled according to the device configuration. Endpoint 0 should always be enabled after a hardware or UDPHS bus reset and participate in the device configuration.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_ENABL_1</name>
                              <description>The endpoint is enabled according to the device configuration.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
