                     <enumeratedValues>
                        <name>SRCMPSelect</name>
                        <enumeratedValue>
                           <name>SRCMP_0</name>
                           <description>No software command is being performed by the RSTC. The RSTC is ready for a software command.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SRCMP_1</name>
