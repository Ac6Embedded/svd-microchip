                     <enumeratedValues>
                        <name>BENABLESelect</name>
                        <enumeratedValue>
                           <name>BENABLE_0</name>
                           <description>12-bit to 10-bit compression is performed skipping two bits.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BENABLE_1</name>
                           <description>Piecewise interpolation is used to perform 112-bit to 10-bit compression for the blue channel.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>GENABLE</name>
