                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PED</name>
                     <description>Port Enabled/Disabled (read/write)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PEDSelect</name>
                        <enumeratedValue>
                           <name>PED_0</name>
                           <description>Disable.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PED_1</name>
                           <description>Enable.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PEDC</name>
                     <description>Port Enable/Disable Change (read/write clear)</description>
