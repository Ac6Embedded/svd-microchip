                     <bitWidth>24</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>FRZKEYSelect</name>
                        <enumeratedValue>
                           <name>PASSWD</name>
