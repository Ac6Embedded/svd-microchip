                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>URSTENSelect</name>
                        <enumeratedValue>
                           <name>URSTEN_0</name>
                           <description>The detection of a low level on the NRST pin does not generate a User reset.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>URSTEN_1</name>
                           <description>The detection of a low level on the NRST pin triggers a User reset.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
