                     </writeConstraint>
                     <enumeratedValues>
                        <name>SMBHHMSelect</name>
                        <enumeratedValue>
                           <name>SMBHHM_0</name>
                           <description>No SMBus Host Header Address received.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SMBHHM_1</name>
                           <description>A SMBus Host Header Address was received.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXFLOCK</name>
                     <description>Transmit FIFO Lock</description>
                     <bitOffset>23</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
