                  <field>
                     <name>SWITCH</name>
                     <description>Switch State for Intrusion Detection</description>
                     <bitOffset>15</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SWITCHSelect</name>
                        <enumeratedValue>
                           <name>SWITCH_0</name>
