                        <bitWidth>24</bitWidth>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>CTCS</name>
                  <description>Channel Transfer Counter Status Register </description>
                  <addressOffset>0x38</addressOffset>
                  <access>read-only</access>
                  <fields>
                     <field>
                        <name>TC</name>
                        <description>Channel Transfer Count</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>24</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>TCSelect</name>
                           <enumeratedValue>
                              <name>TC_1</name>
                              <description>Read the XDMAC_CTCSx.TC field to sample the number of bytes received by the XDMA.</description>
                              <value>1</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>TC_2</name>
                              <description>Perform a software flush of the channel by writing one to the XDMAC_GSWF register. This will push bytes from the internal DMA FIFO to the external memory and return an interrupt when the bytes can be read by the CPU.</description>
                              <value>2</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                  </fields>
               </register>
