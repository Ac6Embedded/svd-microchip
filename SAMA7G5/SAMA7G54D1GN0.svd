                  <fields>
                     <field>
                        <name>SUBS</name>
                        <description>Channel Source Microblock Stride</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>24</bitWidth>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>CDUS</name>
                  <description>Channel Destination Microblock Stride </description>
