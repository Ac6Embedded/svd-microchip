                     <enumeratedValues>
                        <name>RXFPTEFSelect</name>
                        <enumeratedValue>
                           <name>RXFPTEF_0</name>
                           <description>No Receive FIFO underflow occurred.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXFPTEF_1</name>
                           <description>Receive FIFO underflow error occurred due to an incorrect software access (read data exceeding available data in FIFO). Receiver must be reset by writing FLEX_SPI_CR.SWRST=1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
