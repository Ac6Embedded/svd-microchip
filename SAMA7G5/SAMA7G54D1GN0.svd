      <peripheral>
         <name>I2SMCC0</name>
         <version>44157202</version>
         <description>Inter-IC Sound Multi Channel Controller</description>
         <groupName>I2SMCC</groupName>
         <prependToName>I2SMCC_</prependToName>
         <baseAddress>0xE161C000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0xEC</size>
            <usage>registers</usage>
         </addressBlock>
         <interrupt>
            <name>I2SMCC0</name>
            <description>Inter-IC Sound Controller 0</description>
            <value>89</value>
         </interrupt>
         <registers>
            <register>
               <name>CR</name>
               <description>Control Register</description>
               <addressOffset>0x0</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>RXEN</name>
                     <description>Receiver Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXENSelect</name>
                        <enumeratedValue>
                           <name>RXEN_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXEN_1</name>
                           <description>Enables the I2SMCC receiver, if RXDIS is not '1'. Bit I2SMCC_SR.RXEN is set when the receiver is activated.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXDIS</name>
                     <description>Receiver Disable</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXDISSelect</name>
                        <enumeratedValue>
                           <name>RXDIS_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXDIS_1</name>
                           <description>Disables the I2SMCC receiver. Bit I2SMCC_SR.RXEN is cleared when the receiver is stopped.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CKEN</name>
                     <description>Clocks Enable</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CKENSelect</name>
                        <enumeratedValue>
                           <name>CKEN_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CKEN_1</name>
                           <description>Enables the I2SMCC clock generation, if CKDIS is not '1'.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CKDIS</name>
                     <description>Clocks Disable</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CKDISSelect</name>
                        <enumeratedValue>
                           <name>CKDIS_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CKDIS_1</name>
                           <description>Disables the I2SMCC clock generation.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXEN</name>
                     <description>Transmitter Enable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TXENSelect</name>
                        <enumeratedValue>
                           <name>TXEN_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXEN_1</name>
                           <description>Enables the I2SMCC transmitter, if TXDIS is not '1'. Bit I2SMCC_SR.TXEN is set when the Transmitter is started.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXDIS</name>
                     <description>Transmitter Disable</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TXDISSelect</name>
                        <enumeratedValue>
                           <name>TXDIS_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXDIS_1</name>
                           <description>Disables the I2SMCC transmitter. Bit I2SMCC_SR.TXEN is cleared when the Transmitter is stopped.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SWRST</name>
                     <description>Software Reset</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SWRSTSelect</name>
                        <enumeratedValue>
                           <name>SWRST_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SWRST_1</name>
                           <description>Resets all the registers in the I2SMCC. The I2SMCC is disabled after the reset.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MRA</name>
               <description>Mode Register A</description>
               <addressOffset>0x4</addressOffset>
               <fields>
                  <field>
                     <name>MODE</name>
                     <description>Inter-IC Sound Multi Channel Controller Mode</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>MODESelect</name>
                        <enumeratedValue>
                           <name>SLAVE</name>
                           <description>Client mode. I2SMCC_CK and I2SMCC_WS pin inputs used as bit clock and word select/frame synchronization.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MASTER</name>
                           <description>Host mode. Bit clock and word select/frame synchronization generated by I2SMCC from Peripheral Clock or GCLK if I2SMCC_MCK/WS/CK rates must be independent of system bus clock (See I2SMCC_MR.SRCCLK) and output to I2SMCC_CK and I2SMCC_WS pins. MCK is output as host clock on I2SMCC_MCK if I2SMCC_MRA.IMCKMODE is set.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATALENGTH</name>
                     <description>Data Word Length</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>3</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DATALENGTHSelect</name>
                        <enumeratedValue>
                           <name>32_BITS</name>
                           <description>Data length is set to 32 bits.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>24_BITS</name>
                           <description>Data length is set to 24 bits.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>20_BITS</name>
                           <description>Data length is set to 20 bits.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>18_BITS</name>
                           <description>Data length is set to 18 bits.</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16_BITS</name>
                           <description>Data length is set to 16 bits.</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>16_BITS_COMPACT</name>
                           <description>Data length is set to 16-bit compact stereo. Left sample in bits [15:0] and right sample in bits [31:16] of same word.</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8_BITS</name>
                           <description>Data length is set to 8 bits.</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8_BITS_COMPACT</name>
                           <description>Data length is set to 8-bit compact stereo. Left sample in bits [7:0] and right sample in bits [15:8] of the same word.</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WIRECFG</name>
                     <description>Wire Configuration</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WIRECFGSelect</name>
                        <enumeratedValue>
                           <name>I2S_1_TDM_0</name>
                           <description>In I2S and LJ formats, I2SMCC_DIN0 and I2SMCC_DOUT0 are used to transmit and receive I2S frames. In TDM and TDMLJ formats, I2SMCC_DIN0 and I2SMCC_DOUT0 are used to transmit and receive TDM frames.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>I2S_2_TDM_1</name>
                           <description>In I2S and LJ formats, I2SMCC_DIN[1:0] and I2SMCC_DOUT[1:0] are used to transmit and receive 2 I2S frames. In TDM and TDMLJ formats, I2SMCC_DIN1 and I2SMCC_DOUT1 are used to transmit and receive TDM frames.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>I2S_4_TDM_2</name>
                           <description>In I2S and LJ formats, I2SMCC_DIN[3:0] and I2SMCC_DOUT[3:0] are used to transmit and receive 4 I2S frames. In TDM and TDMLJ formats, I2SMCC_DIN2 and I2SMCC_DOUT2 are used to transmit and receive TDM frames.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TDM_3</name>
                           <description>In I2S and LJ formats, reserved for future use, do not use. In TDM and TDMLJ formats, I2SMCC_DIN3 and I2SMCC_DOUT3 are used to transmit and receive TDM frames.</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FORMAT</name>
                     <description>Data Format</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>FORMATSelect</name>
                        <enumeratedValue>
                           <name>I2S</name>
                           <description>I2S format, stereo with I2SMCC_WS low for left channel, and MSB of sample starting one I2SMCC_CK period after I2SMCC_WS edge.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LJ</name>
                           <description>Left-justified format, stereo with I2SMCC_WS high for left channel, and MSB of sample starting on I2SMCC_WS edge.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TDM</name>
                           <description>TDM format, with (NBCHAN + 1) channels, I2SMCC_WS high at beginning of first channel, and MSB of sample starting one I2SMCC_CK period after I2SMCC_WS edge.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TDMLJ</name>
                           <description>TDM format, left-justified, with (NBCHAN + 1) channels, I2SMCC_WS high at beginning of first channel, and MSB of sample starting on I2SMCC_WS edge.</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXMONO</name>
                     <description>Receive Mono</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXMONOSelect</name>
                        <enumeratedValue>
                           <name>RXMONO_0</name>
                           <description>Stereo.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXMONO_1</name>
                           <description>Mono, with left audio samples duplicated to right audio channel by the I2SMCC.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXLOOP</name>
                     <description>Loop-back Test Mode</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXLOOPSelect</name>
                        <enumeratedValue>
                           <name>RXLOOP_0</name>
                           <description>Normal mode.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXLOOP_1</name>
                           <description>I2SMCC_DOUT outputs of I2SMCC are internally connected to I2SMCC_DIN inputs.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXMONO</name>
                     <description>Transmit Mono</description>
                     <bitOffset>10</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TXMONOSelect</name>
                        <enumeratedValue>
                           <name>TXMONO_0</name>
                           <description>Stereo.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXMONO_1</name>
                           <description>Mono, with left audio samples duplicated to right audio channel by the I2SMCC.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXSAME</name>
                     <description>Transmit Data when Underrun</description>
                     <bitOffset>11</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TXSAMESelect</name>
                        <enumeratedValue>
                           <name>TXSAME_0</name>
                           <description>'0' is transmitted when underrun.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXSAME_1</name>
                           <description>Previous sample transmitted when underrun.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SRCCLK</name>
                     <description>Source Clock Selection</description>
                     <bitOffset>12</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SRCCLKSelect</name>
                        <enumeratedValue>
                           <name>SRCCLK_0</name>
                           <description>The Peripheral clock is selected as source clock for I2SMCC_MCK/WS/CK pins.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SRCCLK_1</name>
                           <description>The PMC.GCLKx clock is selected as source clock (I2SMCC_MCK/WS/CK rate can be independent of system bus clock).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NBCHAN</name>
                     <description>Number of TDM Channels-1</description>
                     <bitOffset>13</bitOffset>
                     <bitWidth>3</bitWidth>
                  </field>
                  <field>
                     <name>IMCKDIV</name>
                     <description>Selected Clock to I2SMCC Host Clock Ratio</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>6</bitWidth>
                  </field>
                  <field>
                     <name>TDMFS</name>
                     <description>TDM Frame Synchronization</description>
                     <bitOffset>22</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TDMFSSelect</name>
                        <enumeratedValue>
                           <name>SLOT</name>
                           <description>I2SMCC_WS pulse is high for one time slot at beginning of frame.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HALF</name>
                           <description>I2SMCC_WS pulse is high for half the time slots at beginning of frame.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BIT</name>
                           <description>I2SMCC_WS pulse is high for one bit period at beginning of frame, i.e., one I2SMCC_CK period.</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ISCKDIV</name>
                     <description>Selected Clock to I2SMCC Serial Clock Ratio</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>6</bitWidth>
                  </field>
                  <field>
                     <name>IMCKMODE</name>
                     <description>Host Clock Mode</description>
                     <bitOffset>30</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>IMCKMODESelect</name>
                        <enumeratedValue>
                           <name>IMCKMODE_0</name>
                           <description>No host clock generated.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IMCKMODE_1</name>
                           <description>Host clock generated.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IWS</name>
                     <description>I2SMCC_WS Slot Length</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>IWSSelect</name>
                        <enumeratedValue>
                           <name>IWS_0</name>
                           <description>I2SMCC_WS slot is 32 bits long for DATALENGTH = 18/20/24 bits.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IWS_1</name>
                           <description>I2SMCC_WS slot is 24 bits long for DATALENGTH = 18/20/24 bits.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MRB</name>
               <description>Mode Register B</description>
               <addressOffset>0x8</addressOffset>
               <fields>
                  <field>
                     <name>CRAMODE</name>
                     <description>Common Register Access Mode</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CRAMODESelect</name>
                        <enumeratedValue>
                           <name>LEFT_FIRST</name>
                           <description>All enabled I2S left channels are filled first, then I2S right channels.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>REGULAR</name>
                           <description>An enabled I2S left channel is filled, then the corresponding right channel, until all channels are filled.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FIFOEN</name>
                     <description>FIFO Enable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>FIFOENSelect</name>
                        <enumeratedValue>
                           <name>FIFOEN_0</name>
                           <description>The Receive and Transmit FIFOs are disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FIFOEN_1</name>
                           <description>The Receive and Transmit FIFOs are enabled. Transmit data can only be written through I2SMCC_THR. Receive data can only be read through I2SMCC_RHR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DMACHUNK</name>
                     <description>DMA Chunk Size</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DMACHUNKSelect</name>
                        <enumeratedValue>
                           <name>1_WORD</name>
                           <description>A DMA transfer request is issued when at least 1 word is empty in the FIFO.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>2_WORDS</name>
                           <description>A DMA transfer request is issued when at least 2 words are empty in the FIFO.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>4_WORDS</name>
                           <description>A DMA transfer request is issued when at least 4 words are empty in the FIFO. Limitations exist when operating in Mono or TDM. See Table 7-7 'TX DMA Chunk Configurations' and Table 7-8 'RX DMA Chunk Configurations'.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8_WORDS</name>
                           <description>A DMA transfer request is issued when at least 8 words are empty in the FIFO. Limitations exist when operating in Mono or TDM. See Table 7-7 'TX DMA Chunk Configurations' and Table 7-8 'RX DMA Chunk Configurations'.</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SR</name>
               <description>Status Register</description>
               <addressOffset>0xC</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>RXEN</name>
                     <description>Receiver Enabled</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXENSelect</name>
                        <enumeratedValue>
                           <name>RXEN_0</name>
                           <description>Cleared when the receiver is disabled, following a RXDIS or SWRST request in I2SMCC_CR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXEN_1</name>
                           <description>Set when the receiver is enabled, following a RXEN request in I2SMCC_CR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXEN</name>
                     <description>Transmitter Enabled</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TXENSelect</name>
                        <enumeratedValue>
                           <name>TXEN_0</name>
                           <description>Cleared when the transmitter is disabled, following a I2SMCC_CR.TXDIS or I2SMCC_CR.SWRST request.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXEN_1</name>
                           <description>Set when the transmitter is enabled, following a I2SMCC_CR.TXEN request.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IERA</name>
               <description>Interrupt Enable Register A</description>
               <addressOffset>0x10</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>TXLRDY0</name>
                     <description>I2S Transmit Left 0 or TDM Channel 2x ReadyInterrupt Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TXRRDY0</name>
                     <description>I2S Transmit Right 0 or TDM Channel [2x]+1 Ready Interrupt Enable</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TXLRDY1</name>
                     <description>I2S Transmit Left 1 or TDM Channel 2x ReadyInterrupt Enable</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TXRRDY1</name>
                     <description>I2S Transmit Right 1 or TDM Channel [2x]+1 Ready Interrupt Enable</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TXLRDY2</name>
                     <description>I2S Transmit Left 2 or TDM Channel 2x ReadyInterrupt Enable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TXRRDY2</name>
                     <description>I2S Transmit Right 2 or TDM Channel [2x]+1 Ready Interrupt Enable</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TXLRDY3</name>
                     <description>I2S Transmit Left 3 or TDM Channel 2x ReadyInterrupt Enable</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TXRRDY3</name>
