                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BPENSelect</name>
                        <enumeratedValue>
                           <name>BPEN_0</name>
                           <description>Calibration bypass is not enabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BPEN_1</name>
                           <description>Calibration bypass is enabled. CALPBP and CALNBP codes are applied to the calibration cell.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
