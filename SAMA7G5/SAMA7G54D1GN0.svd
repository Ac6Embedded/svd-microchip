                     </writeConstraint>
                     <enumeratedValues>
                        <name>VBUSOCPFSelect</name>
                        <enumeratedValue>
                           <name>VBUSOCPF_0</name>
                           <description>Not in an over-current protection state.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VBUSOCPF_1</name>
                           <description>Over-current fault latched.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FRCOFVBUS</name>
                     <description>Force Off VBUS (clear on write '1')</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>FRCOFVBUSSelect</name>
                        <enumeratedValue>
                           <name>FRCOFVBUS_0</name>
                           <description>No fault detected, no action (default and not supported).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FRCOFVBUS_1</name>
                           <description>VBUS source/sink has been forced off due to external fault.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ALLREGRES</name>
                     <description>All Registers Reset To Default (clear on write '1')</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ALLREGRESSelect</name>
                        <enumeratedValue>
                           <name>ALLREGRES_0</name>
                           <description>The registers have not been reset since the last clear of this bit.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ALLREGRES_1</name>
                           <description>The TCPC has reset all registers to their default value. This happens at initial power-up or if an unexpected power reset occurs.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
