            <register>
               <name>ISR</name>
               <description>Interrupt Status Register</description>
               <addressOffset>0x20</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000002</resetValue>
               <fields>
                  <field>
                     <name>RXRDY</name>
                     <description>Receive Ready Interrupt Status (cleared by reading PDMC_RHR)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXRDYSelect</name>
                        <enumeratedValue>
                           <name>RXRDY_0</name>
                           <description>There is no data in the RX FIFO.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXRDY_1</name>
                           <description>At least one data is in the RX FIFO and can be read through PDMC_RHR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXEMPTY</name>
                     <description>Receive FIFO Empty Interrupt Status (automatically cleared when an audio sample is generated)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXEMPTYSelect</name>
                        <enumeratedValue>
                           <name>RXEMPTY_0</name>
                           <description>At least one data is in the RX FIFO.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXEMPTY_1</name>
                           <description>The RX FIFO is empty.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXFULL</name>
                     <description>Receive FIFO Full Interrupt Status (cleared by reading PDMC_RHR)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXFULLSelect</name>
                        <enumeratedValue>
                           <name>RXFULL_0</name>
                           <description>The RX FIFO is not full and can still receive data.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXFULL_1</name>
                           <description>The RX FIFO is full and cannot receive more data.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXCHUNK</name>
                     <description>Receive FIFO Chunk Interrupt Status (cleared by reading PDMC_RHR)</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXCHUNKSelect</name>
                        <enumeratedValue>
                           <name>RXCHUNK_0</name>
                           <description>There is less than PDMC_MR.CHUNK data in the RX FIFO.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXCHUNK_1</name>
                           <description>At least PDMC_MR.CHUNK data can be read in the RX FIFO.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RXUDR</name>
