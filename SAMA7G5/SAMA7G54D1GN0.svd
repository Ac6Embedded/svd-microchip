            </register>
            <register>
               <name>TST</name>
               <description>UDPHS Test Register</description>
               <addressOffset>0xE0</addressOffset>
               <fields>
                  <field>
                     <name>SPEED_CFG</name>
                     <description>Speed Configuration</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SPEED_CFGSelect</name>
                        <enumeratedValue>
                           <name>NORMAL</name>
                           <description>Normal mode: UDPHS is in Full Speed mode, ready to make a High Speed identification, if the host supports it and then to automatically switch to High Speed mode.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HIGH_SPEED</name>
                           <description>Force High Speed: Set this value to force the hardware to work in High Speed mode. Only for debug or test purpose.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FULL_SPEED</name>
                           <description>Force Full Speed: Set this value to force the hardware to work only in Full Speed mode. In this configuration, UDPHS will not respond to a High Speed reset handshake.</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TST_J</name>
                     <description>Test J Mode</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TST_JSelect</name>
                        <enumeratedValue>
                           <name>TST_J_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TST_J_1</name>
                           <description>Set to send the J state on the UDPHS line. This enables the testing of the high output drive level on the D+ line.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TST_K</name>
                     <description>Test K Mode</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TST_KSelect</name>
                        <enumeratedValue>
                           <name>TST_K_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TST_K_1</name>
                           <description>Set to send the K state on the UDPHS line. This enables the testing of the high output drive level on the D- line.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TST_PKT</name>
                     <description>Test Packet Mode</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TST_PKTSelect</name>
                        <enumeratedValue>
                           <name>TST_PKT_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TST_PKT_1</name>
                           <description>Set to repetitively transmit the packet stored in the current bank. This enables the testing of rise and fall times, eye patterns, jitter, and any other dynamic waveform specifications.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OPMODE2</name>
                     <description>OpMode2</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OPMODE2Select</name>
                        <enumeratedValue>
                           <name>OPMODE2_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPMODE2_1</name>
                           <description>Set to force the OpMode signal (UTMI interface) to '10', to disable the bit-stuffing and the NRZI encoding.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <cluster>
               <dim>16</dim>
               <dimIncrement>0x20</dimIncrement>
               <name>UDPHS_EPT[%s]</name>
               <description/>
               <addressOffset>0x100</addressOffset>
               <register>
                  <name>EPTCFG</name>
                  <description>UDPHS Endpoint Configuration Register </description>
                  <addressOffset>0x0</addressOffset>
                  <fields>
                     <field>
                        <name>EPT_SIZE</name>
                        <description>Endpoint Size (cleared upon USB reset)</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>3</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>EPT_SIZESelect</name>
                           <enumeratedValue>
                              <name>EPT_SIZE_8</name>
                              <description>8 bytes</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_SIZE_16</name>
                              <description>16 bytes</description>
                              <value>1</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_SIZE_32</name>
                              <description>32 bytes</description>
                              <value>2</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_SIZE_64</name>
                              <description>64 bytes</description>
                              <value>3</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_SIZE_128</name>
                              <description>128 bytes</description>
                              <value>4</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_SIZE_256</name>
                              <description>256 bytes</description>
                              <value>5</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_SIZE_512</name>
                              <description>512 bytes</description>
                              <value>6</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_SIZE_1024</name>
                              <description>1024 bytes</description>
                              <value>7</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>EPT_DIR</name>
                        <description>Endpoint Direction (cleared upon USB reset)</description>
                        <bitOffset>3</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>EPT_DIRSelect</name>
                           <enumeratedValue>
                              <name>EPT_DIR_0</name>
                              <description>Clear this bit to configure OUT direction for Bulk, Interrupt and Isochronous endpoints.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_DIR_1</name>
                              <description>Set this bit to configure IN direction for Bulk, Interrupt and Isochronous endpoints.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>EPT_TYPE</name>
                        <description>Endpoint Type (cleared upon USB reset)</description>
                        <bitOffset>4</bitOffset>
                        <bitWidth>2</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>EPT_TYPESelect</name>
                           <enumeratedValue>
                              <name>CTRL8</name>
                              <description>Control endpoint</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>ISO</name>
                              <description>Isochronous endpoint</description>
                              <value>1</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BULK</name>
                              <description>Bulk endpoint</description>
                              <value>2</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>INT</name>
                              <description>Interrupt endpoint</description>
                              <value>3</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>BK_NUMBER</name>
                        <description>Number of Banks (cleared upon USB reset)</description>
                        <bitOffset>6</bitOffset>
                        <bitWidth>2</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>BK_NUMBERSelect</name>
                           <enumeratedValue>
                              <name>BK_NUMBER_0</name>
                              <description>Zero bank, the endpoint is not mapped in memory</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BK_NUMBER_1</name>
                              <description>One bank (bank 0)</description>
                              <value>1</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BK_NUMBER_2</name>
                              <description>Double bank (Ping-Pong: bank0/bank1)</description>
                              <value>2</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BK_NUMBER_3</name>
                              <description>Triple bank (bank0/bank1/bank2)</description>
                              <value>3</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>NB_TRANS</name>
                        <description>Number Of Transactions per Microframe (cleared upon USB reset)</description>
                        <bitOffset>8</bitOffset>
                        <bitWidth>2</bitWidth>
                     </field>
                     <field>
                        <name>EPT_MAPD</name>
                        <description>Endpoint Mapped (cleared upon USB reset)</description>
                        <bitOffset>31</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>EPT_MAPDSelect</name>
                           <enumeratedValue>
                              <name>EPT_MAPD_0</name>
                              <description>The user should reprogram the register with correct values.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_MAPD_1</name>
                              <description>Set by hardware when the endpoint size (EPT_SIZE) and the number of banks (BK_NUMBER) are correct regarding:</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>EPTCTLENB</name>
                  <description>UDPHS Endpoint Control Enable Register </description>
                  <addressOffset>0x4</addressOffset>
                  <access>write-only</access>
                  <fields>
                     <field>
                        <name>EPT_ENABL</name>
                        <description>Endpoint Enable</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>EPT_ENABLSelect</name>
                           <enumeratedValue>
                              <name>EPT_ENABL_0</name>
                              <description>No effect.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EPT_ENABL_1</name>
                              <description>Enable endpoint according to the device configuration.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>AUTO_VALID</name>
                        <description>Packet Auto-Valid Enable</description>
                        <bitOffset>1</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>AUTO_VALIDSelect</name>
                           <enumeratedValue>
                              <name>AUTO_VALID_0</name>
                              <description>No effect.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>AUTO_VALID_1</name>
                              <description>Enable this bit to automatically validate the current packet and switch to the next bank for both IN and OUT transfers.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>INTDIS_DMA</name>
                        <description>Interrupts Disable DMA</description>
                        <bitOffset>3</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>INTDIS_DMASelect</name>
                           <enumeratedValue>
                              <name>INTDIS_DMA_0</name>
                              <description>No effect.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>INTDIS_DMA_1</name>
                              <description>If set, when an enabled endpoint-originated interrupt is triggered, the DMA request is disabled.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>NYET_DIS</name>
                        <description>NYET Disable (Only for High Speed Bulk OUT endpoints)</description>
                        <bitOffset>4</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>NYET_DISSelect</name>
                           <enumeratedValue>
                              <name>NYET_DIS_0</name>
                              <description>No effect.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>NYET_DIS_1</name>
                              <description>Forces an ACK response to the next High Speed Bulk OUT transfer instead of a NYET response.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>ERR_OVFLW</name>
                        <description>Overflow Error Interrupt Enable</description>
                        <bitOffset>8</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>ERR_OVFLWSelect</name>
                           <enumeratedValue>
                              <name>ERR_OVFLW_0</name>
                              <description>No effect.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>ERR_OVFLW_1</name>
                              <description>Enable Overflow Error Interrupt.</description>
