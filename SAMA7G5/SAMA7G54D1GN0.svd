                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PKWOSelect</name>
                        <enumeratedValue>
                           <name>PKWO_0</name>
                           <description>The Private Key internal registers can be written multiple times through the Private Key bus.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PKWO_1</name>
                           <description>The Private Key internal registers can be written only once through the Private Key bus until hardware reset.</description>
                           <value>1</value>
