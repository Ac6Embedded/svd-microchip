                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EMUL_1</name>
                           <description>The Emulation mode of the User area is enabled, all accesses are computed in the Emulation memory.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RDDIS</name>
                     <description>Read Disable</description>
