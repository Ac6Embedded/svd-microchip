                     <bitOffset>0</bitOffset>
                     <bitWidth>8</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RCODESelect</name>
                        <enumeratedValue>
                           <name>IID_PUF_OK</name>
                           <description>The last operation was successful or an operation is in progress.</description>
                           <value>0x00</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_ERR_PRODUCT</name>
                           <description>The provided activation code is not correct.</description>
                           <value>0xF0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_ERR_PRODUCT_PH2</name>
                           <description>The activation code in the second phase is not correct.</description>
                           <value>0xF1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_ERR_TRANSFER</name>
                           <description>The provided activation code is corrupted.</description>
                           <value>0xF2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_ERR_TRANSFER_PH2</name>
                           <description>The activation code in the second phase is corrupted.</description>
                           <value>0xF3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_ERR_AUTH</name>
                           <description>Authentication of the provided activation code failed.</description>
                           <value>0xF4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_ERR_AUTH_PH2</name>
                           <description>Authentication of the provided activation code failed in the second phase.</description>
                           <value>0xF5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_ERR_PUF_QUALITY</name>
                           <description>Dedicated Embedded Static RAM PUF quality verification fails.</description>
                           <value>0xF6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_ERR_CONTEXT</name>
                           <description>An incorrect or unsupported context is provided.</description>
                           <value>0xF7</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_ERR_DESTINATION</name>
                           <description>A data destination that was set is not allowed according to other settings and the current PUF state.</description>
                           <value>0xF8</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_FAILURE_DRBG2_ENTROPY</name>
