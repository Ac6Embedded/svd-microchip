                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LVDSUNLOCK_1</name>
                           <description>LVDS PLL is unlocked.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>PLL_ISR1</name>
