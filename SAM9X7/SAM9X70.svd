                     <enumeratedValues>
                        <name>CP1Select</name>
                        <enumeratedValue>
                           <name>CP1_0</name>
                           <description>No compare 1 has occurred since the last read of the Status register.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CP1_1</name>
                           <description>A compare 1 has occurred since the last read of the Status register.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
