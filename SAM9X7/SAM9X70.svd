                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WDIDLEHLT_1</name>
                           <description>The WDT stops when the system is in Idle state.</description>
                           <value>1</value>
                        </enumeratedValue>
