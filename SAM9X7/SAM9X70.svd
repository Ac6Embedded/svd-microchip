                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CF_1</name>
                           <description>Port routing control logic default-routes all ports to this host controller.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
