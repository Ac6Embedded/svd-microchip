                           <name>DISMASKSelect</name>
                           <enumeratedValue>
                              <name>DISMASK_0</name>
                              <description>GMAC_ST2CW0R contains a 2-byte compare value with a 2-byte mask value.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>DISMASK_1</name>
                              <description>GMAC_ST2CW0R contains a 4-byte compare value.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                  </fields>
               </register>
