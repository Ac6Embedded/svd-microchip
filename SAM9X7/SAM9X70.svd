               <fields>
                  <field>
                     <name>RXEN</name>
                     <description>Receiver Enabled</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RXENSelect</name>
                        <enumeratedValue>
                           <name>RXEN_0</name>
                           <description>Cleared when the receiver is disabled, following a RXDIS or SWRST request in I2SMCC_CR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXEN_1</name>
                           <description>Set when the receiver is enabled, following a RXEN request in I2SMCC_CR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXEN</name>
                     <description>Transmitter Enabled</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TXENSelect</name>
                        <enumeratedValue>
                           <name>TXEN_0</name>
                           <description>Cleared when the transmitter is disabled, following a I2SMCC_CR.TXDIS or I2SMCC_CR.SWRST request.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXEN_1</name>
                           <description>Set when the transmitter is enabled, following a I2SMCC_CR.TXEN request.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
