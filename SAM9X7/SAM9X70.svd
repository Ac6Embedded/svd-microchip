                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>END_1</name>
                           <description>Data are sent in big-endian format to the memory.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
