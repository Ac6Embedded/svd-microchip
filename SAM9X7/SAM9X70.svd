      <peripheral>
         <name>RTT</name>
         <version>60810</version>
         <description>Real-time Timer</description>
         <baseAddress>0xFFFFFE20</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x18</size>
            <usage>registers</usage>
         </addressBlock>
         <interrupt>
            <name>SYSC</name>
            <description>Logical-OR interrupt of PMC, WDT, PIT, RSTC, RTT, RTC</description>
            <value>1</value>
         </interrupt>
         <registers>
            <register>
               <name>MR</name>
               <description>Mode Register</description>
               <addressOffset>0x0</addressOffset>
               <resetValue>0x00008000</resetValue>
               <fields>
                  <field>
                     <name>RTPRES</name>
                     <description>Real-Time Timer Prescaler Value</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
                  <field>
                     <name>ALMIEN</name>
                     <description>Alarm Interrupt Enable</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ALMIENSelect</name>
                        <enumeratedValue>
                           <name>ALMIEN_0</name>
                           <description>The RTT_SR.ALMS bit has no effect on interrupt.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ALMIEN_1</name>
                           <description>The RTT_SR.ALMS bit asserts interrupt.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RTTINCIEN</name>
                     <description>Real-Time Timer Increment Interrupt Enable</description>
                     <bitOffset>17</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RTTINCIENSelect</name>
                        <enumeratedValue>
                           <name>RTTINCIEN_0</name>
                           <description>The RTT_SR.RTTINC bit has no effect on interrupt.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTTINCIEN_1</name>
                           <description>The RTT_SR.RTTINC bit asserts interrupt.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RTTRST</name>
                     <description>Real-Time Timer Restart</description>
                     <bitOffset>18</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RTTRSTSelect</name>
                        <enumeratedValue>
                           <name>RTTRST_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTTRST_1</name>
                           <description>Reloads and restarts the clock divider with the new programmed value. This also resets the 32-bit counter.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RTTDIS</name>
                     <description>Real-Time Timer Disable</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RTTDISSelect</name>
                        <enumeratedValue>
                           <name>RTTDIS_0</name>
                           <description>The Real-Time Timer is enabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTTDIS_1</name>
                           <description>The Real-Time Timer is disabled (no dynamic power consumption).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>INC2AEN</name>
                     <description>RTTINC2 Alarm and Interrupt Enable</description>
                     <bitOffset>21</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>INC2AENSelect</name>
                        <enumeratedValue>
                           <name>INC2AEN_0</name>
                           <description>The RTTINC2 flag is not a source of the RTT alarm signal nor a source of interrupt.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>INC2AEN_1</name>
                           <description>The RTTINC2 flag is a source of the RTT alarm signal and a source of interrupt.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RTC1HZ</name>
                     <description>Real-Time Clock 1Hz Clock Selection</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RTC1HZSelect</name>
                        <enumeratedValue>
                           <name>RTC1HZ_0</name>
                           <description>The RTT 32-bit counter is driven by the 16-bit prescaler roll-over events.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTC1HZ_1</name>
                           <description>The RTT 32-bit counter is driven by the 1Hz RTC clock.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>AR</name>
               <description>Alarm Register</description>
               <addressOffset>0x4</addressOffset>
               <resetValue>0xFFFFFFFF</resetValue>
               <fields>
                  <field>
                     <name>ALMV</name>
                     <description>Alarm Value</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>32</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>VR</name>
               <description>Value Register</description>
               <addressOffset>0x8</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>CRTV</name>
                     <description>Current Real-time Value</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>32</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>SR</name>
               <description>Status Register</description>
               <addressOffset>0xC</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>ALMS</name>
                     <description>Real-Time Alarm Status (cleared on read)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ALMSSelect</name>
                        <enumeratedValue>
                           <name>ALMS_0</name>
                           <description>The real-time zlarm has not occurred since the last read of RTT_SR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ALMS_1</name>
                           <description>The real-time alarm occurred since the last read of RTT_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RTTINC</name>
                     <description>Prescaler Roll-over Status (cleared on read)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RTTINCSelect</name>
                        <enumeratedValue>
                           <name>RTTINC_0</name>
                           <description>No prescaler roll-over occurred since the last read of the RTT_SR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTTINC_1</name>
                           <description>Prescaler roll-over occurred since the last read of the RTT_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RTTINC2</name>
                     <description>Predefined Number of Prescaler Roll-Over Status (cleared on read)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RTTINC2Select</name>
                        <enumeratedValue>
                           <name>RTTINC2_0</name>
                           <description>SELINC2=0 or the number of prescaler roll-overs programmed through the SELINC2 field in RTT_MODR has not been reached since the last read of the RTT_SR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTTINC2_1</name>
                           <description>The number of prescaler roll-overs programmed through the SELINC2 field has been reached since the last read of the RTT_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MODR</name>
               <description>Modulo Selection Register</description>
               <addressOffset>0x10</addressOffset>
               <fields>
                  <field>
                     <name>SELINC2</name>
                     <description>Selection of the 32-bit Counter Modulo to generate RTTINC2 Flag</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>3</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SELINC2Select</name>
                        <enumeratedValue>
                           <name>NO_RTTINC2</name>
                           <description>The RTTINC2 flag never rises.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOD64</name>
                           <description>The RTTINC2 flag is set when CRTV modulo 64 equals 0.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOD128</name>
                           <description>The RTTINC2 flag is set when CRTV modulo 128 equals 0.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOD256</name>
                           <description>The RTTINC2 flag is set when CRTV modulo 256 equals 0.</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOD512</name>
                           <description>The RTTINC2 flag is set when CRTV modulo 512 equals 0.</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOD1024</name>
                           <description>The RTTINC2 flag is set when CRTV modulo 1024 equals 0. Example: If RTPRES=32 then RTTINC2 flag rises once per second if the slow clock is 32.768 kHz.</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOD2048</name>
                           <description>The RTTINC2 flag is set when CRTV modulo 2048 equals 0.</description>
                           <value>6</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOD4096</name>
                           <description>The RTTINC2 flag is set when CRTV modulo 4096 equals 0.</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TSR</name>
               <description>TimeStamp Register</description>
               <addressOffset>0x14</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>TSTAMP</name>
                     <description>Real-Time Timer Value Timestamp</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>31</bitWidth>
                  </field>
                  <field>
                     <name>TS_OVF</name>
                     <description>Timestamp Overflow</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TS_OVFSelect</name>
                        <enumeratedValue>
                           <name>TS_OVF_0</name>
                           <description>RTT_ST.RTTINC2 was set but no new event occurred since the last read of RTT_SR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TS_OVF_1</name>
                           <description>RTT_ST.RTTINC2 was set and a second event occurred. To avoid any overflow, clear RTTINC2 by reading RTT_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>SCKC</name>
