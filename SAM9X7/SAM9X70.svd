                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UNLOCKU_1</name>
                           <description>UPLL is unlocked. To know the unlock type, the PMC_PISR1 register can be read.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
