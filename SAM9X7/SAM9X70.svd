               <name>TBQBAPQ[%s]</name>
               <description>Transmit Buffer Queue Base Address Register Priority Queue (index = 1)</description>
               <addressOffset>0x440</addressOffset>
               <fields>
                  <field>
                     <name>TXBQDIS</name>
                     <description>Transmit Buffer Queue Disable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TXBQDISSelect</name>
                        <enumeratedValue>
                           <name>TXBQDIS_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXBQDIS_1</name>
                           <description>Disables the transmit queue. This can be used to reduce the number of active queues and must be changed only while transmit is disabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TXBQBA</name>
                     <description>Transmit Buffer Queue Base Address</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>30</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <dim>5</dim>
               <dimIncrement>4</dimIncrement>
               <name>RBQBAPQ[%s]</name>
               <description>Receive Buffer Queue Base Address Register Priority Queue (index = 1)</description>
               <addressOffset>0x480</addressOffset>
               <fields>
                  <field>
                     <name>RXBQDIS</name>
                     <description>Receive Buffer Queue Disable</description>
