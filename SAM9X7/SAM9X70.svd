                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>RXRDY_TXKL_1</name>
                              <description>Kill the last written bank.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>TXRDY</name>
