               <addressOffset>0x10</addressOffset>
               <fields>
                  <field>
                     <name>RES0</name>
                     <description>USB PORTx Reset</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RES0Select</name>
                        <enumeratedValue>
                           <name>RES0_0</name>
                           <description>No effect (USB PORTx reset released, default value)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RES0_1</name>
                           <description>Resets USB PORTx.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RES1</name>
                     <description>USB PORTx Reset</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RES1Select</name>
                        <enumeratedValue>
                           <name>RES1_0</name>
                           <description>No effect (USB PORTx reset released, default value)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RES1_1</name>
                           <description>Resets USB PORTx.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RES2</name>
                     <description>USB PORTx Reset</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RES2Select</name>
                        <enumeratedValue>
                           <name>RES2_0</name>
                           <description>No effect (USB PORTx reset released, default value)</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RES2_1</name>
                           <description>Resets USB PORTx.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ARIE</name>
                     <description>OHCI Asynchronous Resume Interrupt Enable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ARIESelect</name>
                        <enumeratedValue>
                           <name>ARIE_0</name>
                           <description>Disables interrupt.</description>
                           <value>0</value>
                        </enumeratedValue>
