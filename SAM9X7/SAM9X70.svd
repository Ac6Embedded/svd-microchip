                           <name>CHID2_1</name>
                           <description>Interrupt for PWM channel x is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CHID3</name>
                     <description>Channel ID</description>
