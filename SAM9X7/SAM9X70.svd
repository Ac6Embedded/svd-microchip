                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ENIOPLLCKSelect</name>
                        <enumeratedValue>
                           <name>ENIOPLLCK_0</name>
                           <description>The clock generated by the PLL is not sent to the IO.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENIOPLLCK_1</name>
