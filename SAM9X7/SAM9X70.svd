                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN_Q3</name>
                     <description>Enhanced Scheduled Traffic Enable for Queue 3</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EN_Q3Select</name>
                        <enumeratedValue>
                           <name>EN_Q3_0</name>
                           <description>Disables the enhanced scheduled traffic for queue x.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN_Q3_1</name>
