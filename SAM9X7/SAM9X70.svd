                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>GCM</name>
                           <description>GCM: Galois/Counter mode</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>XTS</name>
                           <description>XTS: XEX-based tweaked-codebook mode</description>
                           <value>6</value>
                        </enumeratedValue>
