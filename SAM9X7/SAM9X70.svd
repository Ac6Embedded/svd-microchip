                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EN_Q0Select</name>
                        <enumeratedValue>
                           <name>EN_Q0_0</name>
                           <description>Disables the enhanced scheduled traffic for queue x.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN_Q0_1</name>
                           <description>Enables the enhanced scheduled traffic for queue x. EMAC has only 1 queue and ENST is enabled by writing EN_Q0.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN_Q1</name>
                     <description>Enhanced Scheduled Traffic Enable for Queue 1</description>
