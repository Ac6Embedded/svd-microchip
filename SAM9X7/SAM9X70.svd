            <register>
               <name>FSMR</name>
               <description>Fast Start-Up Mode Register</description>
               <addressOffset>0x70</addressOffset>
               <fields>
                  <field>
                     <name>RTTAL</name>
                     <description>RTT Alarm Enable</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RTTALSelect</name>
                        <enumeratedValue>
                           <name>RTTAL_0</name>
                           <description>The RTT alarm has no effect on the IP_Acronym.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTTAL_1</name>
                           <description>The RTT alarm enables a fast restart signal to the IP_Acronym.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RTCAL</name>
                     <description>RTC Alarm Enable</description>
                     <bitOffset>17</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RTCALSelect</name>
                        <enumeratedValue>
                           <name>RTCAL_0</name>
                           <description>The RTC alarm has no effect on the IP_Acronym.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RTCAL_1</name>
                           <description>The RTC alarm enables a fast restart signal to the IP_Acronym.</description>
                           <value>1</value>
                        </enumeratedValue>
