                  </field>
                  <field>
                     <name>NPCKT</name>
                     <description>New Packet</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
