                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXBQDIS_1</name>
                           <description>Disables the receive queue. This can be used to reduce the number of active queues and must be changed only while receive is disabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
