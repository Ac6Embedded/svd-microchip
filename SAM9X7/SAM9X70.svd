                     <enumeratedValues>
                        <name>TOUTSelect</name>
                        <enumeratedValue>
                           <name>TOUT_0</name>
                           <description>No QSPI time-out occurred.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TOUT_1</name>
                           <description>At least one QSPI time-out occurred.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
