                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TXEMPTY_1</name>
                           <description>Last data written in SSC_THR has been loaded in TSR and last data loaded in TSR has been transmitted.</description>
                           <value>1</value>
                        </enumeratedValue>
