               <addressOffset>0x0</addressOffset>
               <fields>
                  <field>
                     <name>WPEN</name>
                     <description>Write Protection Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WPENSelect</name>
                        <enumeratedValue>
                           <name>WPEN_0</name>
                           <description>Disables the write protection of the configuration registers if WPKEY corresponds to 0x535943 ('SYC' in ASCII).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WPEN_1</name>
                           <description>Enables the write protection of the configuration registers if WPKEY corresponds to 0x535943 ('SYC' in ASCII).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WPITEN</name>
                     <description>Write Protection RTC Interrupt Enable</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WPITENSelect</name>
                        <enumeratedValue>
                           <name>WPITEN_0</name>
                           <description>Disables the write protection of the RTC_IER/RTC_IDR configuration registers if WPKEY corresponds to 0x535943 ('SYC' in ASCII).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WPITEN_1</name>
                           <description>Enables the write protection of the RTC_IER/RTC_IDR configuration registers if WPKEY corresponds to 0x535943 ('SYC' in ASCII).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WPKEY</name>
                     <description>Write Protection Key</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>24</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WPKEYSelect</name>
                        <enumeratedValue>
                           <name>PASSWD</name>
                           <description>Writing any other value in this field aborts the write operation of the WPEN and WPITEN bits. Always reads as 0.</description>
                           <value>0x535943</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SYSC_WPSR</name>
               <description>Write Protection Status Register</description>
               <addressOffset>0x4</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>WPVS</name>
                     <description>Write Protection Register Violation Status</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WPVSSelect</name>
                        <enumeratedValue>
                           <name>WPVS_0</name>
                           <description>No write protection violation has occurred since the last read of SYSC_WPSR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WPVS_1</name>
                           <description>A write protection violation has occurred since the last read of SYSC_WPSR. The associated violation is reported into field WVSRC.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WVSRC</name>
                     <description>Write Violation Source</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
               </fields>
            </register>
         </registers>
