                     </writeConstraint>
                     <enumeratedValues>
                        <name>AUDIOUNLOCKSelect</name>
                        <enumeratedValue>
                           <name>AUDIOUNLOCK_0</name>
                           <description>Audio PLL is not unlocked.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>AUDIOUNLOCK_1</name>
                           <description>Audio PLL is unlocked. To know the unlock type, the PMC_PISR1 register can be read.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LVDSUNLOCK</name>
