                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MSBF_1</name>
                           <description>The most significant bit of the data register is sampled first in the bit stream.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DATNB</name>
