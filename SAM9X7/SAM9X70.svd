                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVRUN_1</name>
                           <description>Data has been loaded in SSC_RHR while previous data has not yet been read since the last read of the Status register.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
