               <addressOffset>0xF0</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>UDRAU</name>
                     <description>AUDIO PLL Underflow</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>UDRAUSelect</name>
                        <enumeratedValue>
                           <name>UDRAU_0</name>
                           <description>AUDIO PLL is not in Underflow state.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UDRAU_1</name>
                           <description>AUDIO PLL encountered an underflow.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVRAU</name>
                     <description>AUDIO PLL Overflow</description>
                     <bitOffset>18</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVRAUSelect</name>
                        <enumeratedValue>
                           <name>OVRAU_0</name>
