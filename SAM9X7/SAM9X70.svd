                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CHID3_1</name>
                           <description>Interrupt for PWM channel x is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>ISR</name>
