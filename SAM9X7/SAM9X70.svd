                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CCS_1</name>
                           <description>Device is present on port.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CSC</name>
                     <description>Connect Status Change (read/write clear)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CSCSelect</name>
                        <enumeratedValue>
                           <name>CSC_0</name>
                           <description>No change.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CSC_1</name>
