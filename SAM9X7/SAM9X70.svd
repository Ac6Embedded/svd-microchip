                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EN_Q1Select</name>
                        <enumeratedValue>
                           <name>EN_Q1_0</name>
                           <description>Disables the enhanced scheduled traffic for queue x.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN_Q1_1</name>
                           <description>Enables the enhanced scheduled traffic for queue x. EMAC has only 1 queue and ENST is enabled by writing EN_Q0.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN_Q2</name>
                     <description>Enhanced Scheduled Traffic Enable for Queue 2</description>
