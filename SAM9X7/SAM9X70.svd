                           <value>0x1F</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_LO_INITIALIZATION</name>
                           <description>The last operation was INITIALIZATION.</description>
                           <value>0x20</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_LO_ZEROIZE</name>
                           <description>The last operation was ZEROIZE.</description>
                           <value>0x2F</value>
