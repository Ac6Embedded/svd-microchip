            </register>
            <register>
               <dim>14</dim>
               <dimIncrement>4</dimIncrement>
               <name>MEAR[%s]</name>
               <description>Host x Error Address Register</description>
               <addressOffset>0x160</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>ERRADD</name>
                     <description>Host Error Address</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>32</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>WPMR</name>
               <description>Write Protect Mode Register</description>
               <addressOffset>0x1E4</addressOffset>
               <fields>
                  <field>
                     <name>WPEN</name>
                     <description>Write Protection Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WPENSelect</name>
                        <enumeratedValue>
                           <name>WPEN_0</name>
                           <description>Disables the write protection if WPKEY corresponds to 0x4D4154 ('MAT' in ASCII).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WPEN_1</name>
                           <description>Enables the write protection if WPKEY corresponds to 0x4D4154 ('MAT' in ASCII).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CFGFRZ</name>
                     <description>Configuration Freeze</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CFGFRZSelect</name>
                        <enumeratedValue>
                           <name>CFGFRZ_0</name>
                           <description>The MATRIX configuration is not frozen.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CFGFRZ_1</name>
                           <description>Freezes the MATRIX configuration until hardware reset. The registers that can be protected by the WPEN bit and the Write Protection Mode Register are no longer modifiable.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WPKEY</name>
                     <description>Write Protection Key</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>24</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WPKEYSelect</name>
                        <enumeratedValue>
                           <name>PASSWD</name>
                           <description>Writing any other value in this field aborts the write operation of the WPEN and CFGFRZ bits. Always reads as 0.</description>
                           <value>0x4D4154</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>WPSR</name>
               <description>Write Protect Status Register</description>
               <addressOffset>0x1E8</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>WPVS</name>
                     <description>Write Protection Violation Status</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WPVSSelect</name>
                        <enumeratedValue>
                           <name>WPVS_0</name>
                           <description>No write protection violation has occurred since the last write of the MATRIX_WPMR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WPVS_1</name>
                           <description>A write protection violation has occurred since the last write of the MATRIX_WPMR. If this violation is an unauthorized attempt to write a protected register, the associated violation is reported into field WPVSRC.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WPVSRC</name>
                     <description>Write Protection Violation Source</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral>
         <name>MPDDRC</name>
         <version>11043328</version>
         <description>DDR-SDRAM Controller</description>
         <baseAddress>0xFFFFE800</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0xEC</size>
            <usage>registers</usage>
         </addressBlock>
         <interrupt>
            <name>MC</name>
            <description>logical-OR interrupt of MPDDRC and SMC</description>
            <value>49</value>
         </interrupt>
         <registers>
            <register>
               <name>MR</name>
               <description>Mode Register</description>
               <addressOffset>0x0</addressOffset>
               <fields>
                  <field>
                     <name>MODE</name>
                     <description>MPDDRC Command Mode</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>3</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>MODESelect</name>
                        <enumeratedValue>
                           <name>NORMAL_CMD</name>
                           <description>Normal Mode. Any access to the MPDDRC is decoded normally. To activate this mode, the command must be followed by a write to the DDR-SDRAM.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOP_CMD</name>
                           <description>The MPDDRC issues a NOP command when the DDR-SDRAM device is accessed regardless of the cycle. To activate this mode, the command must be followed by a write to the DDR-SDRAM.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PRCGALL_CMD</name>
                           <description>The MPDDRC issues the All Banks Precharge command when the DDR-SDRAM device is accessed regardless of the cycle. To activate this mode, the command must be followed by a write to the SDRAM.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LMR_CMD</name>
                           <description>The MPDDRC issues a Load Mode Register command when the DDR-SDRAM device is accessed regardless of the cycle. To activate this mode, the command must be followed by a write to the DDR-SDRAM.</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RFSH_CMD</name>
                           <description>The MPDDRC issues an Autorefresh command when the DDR-SDRAM device is accessed regardless of the cycle. Previously, an All Banks Precharge command must be issued. To activate this mode, the command must be followed by a write to the DDR-SDRAM.</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXT_LMR_CMD</name>
                           <description>The MPDDRC issues an Extended Load Mode Register command when the SDRAM device is accessed regardless of the cycle. To activate this mode, the command must be followed by a write to the DDR-SDRAM. The write in the DDR-SDRAM must be done in the appropriate bank.</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DEEP_CALIB_MD</name>
                           <description>Deep Power mode: Access to Deep Powerdown mode Calibration command: to calibrate RTT and RON values for the Process Voltage Temperature (PVT) (DDR3-SDRAM device)</description>
                           <value>6</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>RTR</name>
               <description>Refresh Timer Register</description>
               <addressOffset>0x4</addressOffset>
               <fields>
                  <field>
                     <name>COUNT</name>
                     <description>MPDDRC Refresh Timer Count</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>12</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>CR</name>
               <description>Configuration Register</description>
               <addressOffset>0x8</addressOffset>
               <resetValue>0x00207024</resetValue>
               <fields>
                  <field>
                     <name>NC</name>
                     <description>Number of Column Bits</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NCSelect</name>
                        <enumeratedValue>
                           <name>DDR9_MDDR8_COL_BITS</name>
                           <description>9 bits to define the column number, up to 512 columns, for DDR2/DDR3-SDRAM 8 bits to define the column number, up to 256 columns, for LPDDR1-SDRAM</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR10_MDDR9_COL_BITS</name>
                           <description>10 bits to define the column number, up to 1024 columns, for DDR2/DDR3-SDRAM 9 bits to define the column number, up to 512 columns, for LPDDR1-SDRAM</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR11_MDDR10_COL_BITS</name>
                           <description>11 bits to define the column number, up to 2048 columns, for DDR2/DDR3-SDRAM 10 bits to define the column number, up to 1024 columns, for LPDDR1-SDRAM</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR12_MDDR11_COL_BITS</name>
                           <description>12 bits to define the column number, up to 4096 columns, for DDR2/DDR3-SDRAM 11 bits to define the column number, up to 2048 columns, for LPDDR1-SDRAM</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NR</name>
                     <description>Number of Row Bits</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NRSelect</name>
                        <enumeratedValue>
                           <name>11_ROW_BITS</name>
                           <description>11 bits to define the row number, up to 2048 rows</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>12_ROW_BITS</name>
                           <description>12 bits to define the row number, up to 4096 rows</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>13_ROW_BITS</name>
                           <description>13 bits to define the row number, up to 8192 rows</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>14_ROW_BITS</name>
                           <description>14 bits to define the row number, up to 16384 rows</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CAS</name>
                     <description>CAS Latency</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>3</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CASSelect</name>
                        <enumeratedValue>
                           <name>DDR_CAS3</name>
                           <description>DDR2 CAS Latency 3</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR_CAS4</name>
                           <description>DDR2 CAS Latency 4</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR_CAS5</name>
                           <description>DDR2/DDR3 CAS Latency 5</description>
                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR_CAS6</name>
                           <description>DDR3 CAS Latency 6</description>
                           <value>6</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DLL</name>
                     <description>Reset DLL</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DLLSelect</name>
                        <enumeratedValue>
                           <name>RESET_DISABLED</name>
                           <description>Disable DLL reset</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RESET_ENABLED</name>
                           <description>Enable DLL reset</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DIC_DS</name>
                     <description>Output Driver Impedance Control (Drive Strength)</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DIC_DSSelect</name>
                        <enumeratedValue>
                           <name>DDR2_NORMALSTRENGTH_DDR3_RZQ_6</name>
                           <description>Normal drive strength (DDR2)- RZQ_6 (40 [NOM], DDR3)</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR2_WEAKSTRENGTH_DDR3_RZQ_7</name>
                           <description>Weak drive strength (DDR2)- RZQ_7 (34 [NOM], DDR3)</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DIS_DLL</name>
                     <description>Disable DLL</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DIS_DLLSelect</name>
                        <enumeratedValue>
                           <name>DIS_DLL_0</name>
                           <description>Enable DLL.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIS_DLL_1</name>
                           <description>Disable DLL.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OCD</name>
                     <description>Off-chip Driver</description>
                     <bitOffset>12</bitOffset>
                     <bitWidth>3</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OCDSelect</name>
                        <enumeratedValue>
                           <name>DDR2_EXITCALIB</name>
                           <description>Exit from OCD Calibration mode and maintain settings</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR2_DEFAULT_CALIB</name>
                           <description>OCD calibration default</description>
                           <value>7</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SUP_DDR3</name>
                     <description>Supply DDR3-SDRAM or DDR3L-SDRAM</description>
                     <bitOffset>15</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SUP_DDR3Select</name>
                        <enumeratedValue>
                           <name>SUP_DDR3_0</name>
                           <description>1.35V DDR3L-SDRAM is used.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SUP_DDR3_1</name>
                           <description>1.5V DDR3-SDRAM is used.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DQMS</name>
                     <description>Mask Data is Shared</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DQMSSelect</name>
                        <enumeratedValue>
                           <name>NOT_SHARED</name>
                           <description>DQM is not shared with another controller</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SHARED</name>
                           <description>DQM is shared with another controller</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NB</name>
                     <description>Number of Banks</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NBSelect</name>
                        <enumeratedValue>
                           <name>4_BANKS</name>
                           <description>4-bank memory devices</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>8_BANKS</name>
                           <description>8 banks. Only possible when using DDR2-SDRAMand DDR3-SDRAM devices.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NDQS</name>
                     <description>Not DQS.</description>
                     <bitOffset>21</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NDQSSelect</name>
