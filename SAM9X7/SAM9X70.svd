                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PAGESIZE_8SEC</name>
                           <description>8 errors for main area (4096 or 8192 bytes)</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
