            </register>
            <register>
               <name>FRER_TIMEOUT</name>
               <description>Frame Elimination Timeout Register</description>
               <addressOffset>0x8A0</addressOffset>
               <fields>
                  <field>
                     <name>TIMEOUT</name>
                     <description>Sequence Recovery Timer Restart Period for Credit Based Streams</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>FRER_REDTAG</name>
               <description>Frame Elimination Redundancy Tag Register</description>
               <addressOffset>0x8A4</addressOffset>
               <resetValue>0x4000F1C1</resetValue>
               <fields>
                  <field>
                     <name>RED_TAG</name>
                     <description>Redundancy Tag (R-TAG)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
                  <field>
                     <name>SIX_BYTE_TAG</name>
                     <description>Six-byte Tag Enable</description>
                     <bitOffset>30</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SIX_BYTE_TAGSelect</name>
                        <enumeratedValue>
                           <name>SIX_BYTE_TAG_0</name>
                           <description>Defines a four-byte tag as per 802.1CB standard revision 2.4 and earlier.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SIX_BYTE_TAG_1</name>
                           <description>Enables the six-byte tag as per 802.1CB standard revision 2.4 and later.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>STRIP_R_TAG</name>
                     <description>Stripping Redundancy Tag Enable</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>STRIP_R_TAGSelect</name>
                        <enumeratedValue>
                           <name>STRIP_R_TAG_0</name>
                           <description>Disables the stripping function. When the statistics counters need to reflect the actual number of octets received, then the stripping functionality must be disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>STRIP_R_TAG_1</name>
                           <description>Enables the stripping function, the receive octet counters reflect post deletion frame size so the frame elimination functionality is transparent to higher level management.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <cluster>
               <dim>6</dim>
               <dimIncrement>0x10</dimIncrement>
               <name>GMAC_FRER[%s]</name>
               <description/>
               <addressOffset>0x8C0</addressOffset>
               <register>
                  <name>FRER_CTRL_A</name>
                  <description>Frame Elimination Control A Register </description>
                  <addressOffset>0x0</addressOffset>
                  <fields>
                     <field>
                        <name>MEMBER_STREAM_1</name>
                        <description>Pointer to Screener Type 2 Register</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>4</bitWidth>
                     </field>
                     <field>
                        <name>MEMBER_STREAM_2</name>
                        <description>Pointer to Screener Type 2 Register</description>
                        <bitOffset>4</bitOffset>
                        <bitWidth>4</bitWidth>
                     </field>
                     <field>
                        <name>OFFSET_VALUE</name>
                        <description>Offset in Bytes from Start Packet Delimiter to MSB for 802.1CB Sequence Number</description>
                        <bitOffset>8</bitOffset>
                        <bitWidth>9</bitWidth>
                     </field>
                     <field>
                        <name>USE_R_TAG</name>
                        <description>Redundancy Tag Enable</description>
                        <bitOffset>28</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>USE_R_TAGSelect</name>
                           <enumeratedValue>
                              <name>USE_R_TAG_0</name>
                              <description>Identifies bottom of sequence number with OFFSET_VALUE.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>USE_R_TAG_1</name>
                              <description>Identifies sequence number with redundancy tag.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>EN_SEQRECRST_TIMER</name>
                        <description>802.1CB Sequence Recovery Reset Timer Enable</description>
                        <bitOffset>29</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>EN_SEQRECRST_TIMERSelect</name>
                           <enumeratedValue>
                              <name>EN_SEQRECRST_TIMER_0</name>
                              <description>Disables the sequence recovery reset timer.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EN_SEQRECRST_TIMER_1</name>
                              <description>Enables the sequence recovery reset timer.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>EN_VECTOR_REC_ALG</name>
                        <description>802.1CB Vector Recovery Algorithm Enable</description>
                        <bitOffset>30</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>EN_VECTOR_REC_ALGSelect</name>
                           <enumeratedValue>
                              <name>EN_VECTOR_REC_ALG_0</name>
                              <description>Enables the match recovery algorithm.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EN_VECTOR_REC_ALG_1</name>
                              <description>Enables the vector recovery algorithm.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>EN_ELIMINATION</name>
                        <description>802.1CB Elimination of Received Frames Enable</description>
                        <bitOffset>31</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>EN_ELIMINATIONSelect</name>
                           <enumeratedValue>
                              <name>EN_ELIMINATION_0</name>
                              <description>Disables the elimination of received frames.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>EN_ELIMINATION_1</name>
                              <description>Enables the elimination of received frames.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>FRER_CTRL_B</name>
                  <description>Frame Elimination Control B Register </description>
                  <addressOffset>0x4</addressOffset>
                  <fields>
                     <field>
                        <name>SEQ_REC_WINDOW</name>
                        <description>Vector Recovery Window</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>6</bitWidth>
                     </field>
                     <field>
                        <name>SEQ_NUM_LENGTH</name>
                        <description>Number of Significants bits of the 802.1CB Sequence Number</description>
                        <bitOffset>8</bitOffset>
                        <bitWidth>5</bitWidth>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>FRER_STAT_A</name>
                  <description>Frame Elimination Statistics A Register </description>
                  <addressOffset>0x8</addressOffset>
                  <access>read-only</access>
                  <fields>
                     <field>
                        <name>LATENT_ERRS</name>
                        <description>Number of Sequence Numbers Seen Without a Duplicate (Clear on read)</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>10</bitWidth>
                     </field>
                     <field>
                        <name>VEC_REC_ROGUE</name>
                        <description>Number of Dropped Frames (Clear on read)</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>10</bitWidth>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>FRER_STAT_B</name>
                  <description>Frame Elimination Statistics B Register </description>
                  <addressOffset>0xC</addressOffset>
                  <access>read-only</access>
                  <fields>
                     <field>
                        <name>OUT_OF_ORDER</name>
                        <description>Out of Order Sequence Numbers Received (Clear on read)</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>10</bitWidth>
                     </field>
                     <field>
                        <name>SEQRST_COUNT</name>
                        <description>Number of Times the Sequence Recovery Reset Timer Decrements to Zero (Clear on read)</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>8</bitWidth>
                     </field>
                  </fields>
               </register>
            </cluster>
            <register>
               <dim>6</dim>
               <dimIncrement>4</dimIncrement>
               <name>RX_FLUSH_Q[%s]</name>
               <description>Receive Queue Flush Register (index = 0)</description>
               <addressOffset>0xB00</addressOffset>
               <fields>
                  <field>
                     <name>DROP_ALL</name>
                     <description>Drop All Frames</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DROP_ALLSelect</name>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLED</name>
                           <description>Drops all frames of this queue.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DROP_ON_RESRC_ERR</name>
                     <description>Drop on Resource Error</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DROP_ON_RESRC_ERRSelect</name>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLED</name>
                           <description>If a free DMA descriptor for this queue cannot be obtained (also referred to as lack of descriptor resource and occurs when the software either cannot free up descriptors quickly enough to meet the receive traffic rate or has deliberately decided not to free any descriptors), all new frames received on this queue will be automatically discarded.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LIMIT_NUM_BYTES</name>
                     <description>Limitation of the Number of 128-Byte Chunk of Data Stored in the Memory of this Queue</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>LIMIT_NUM_BYTESSelect</name>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLED</name>
                           <description>Limits the number of 128 byte chunks of data received for this queue and already stored in the memory of the queue awaiting DMA memory writes to the value defined in the field MAX_VAL.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LIMIT_FRAME_SIZE</name>
                     <description>Maximum Frame-length Received</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>LIMIT_FRAME_SIZESelect</name>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLED</name>
                           <description>When set, MAX_VAL indicates the maximum frame-length in bytes that may be received. Frames exceeding this length will be dropped. This traffic policing function is relevant to the 802.1Qci standard which specifies stream filtering based on a maximum service data unit (SDU) size.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MAX_VAL</name>
                     <description>Maximum Value for the Received Frame Size or Number of 128-Byte Chunk</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <dim>6</dim>
               <dimIncrement>4</dimIncrement>
               <name>SCR2_RATE_LIMIT[%s]</name>
               <description>Screening 2 Rate Limit Register (index = 0)</description>
               <addressOffset>0xB40</addressOffset>
               <fields>
                  <field>
                     <name>INTERVAL_TIME</name>
                     <description>Interval Time for Maximum Rate Checking</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
                  <field>
                     <name>MAX_RATE_VAL</name>
                     <description>Maximum Rate Value for the Interval Time</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>SCR2_RATE_STATUS</name>
               <description>Screening 2 Rate Status Register</description>
               <addressOffset>0xB80</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>EXCESS_RATE_Q0</name>
                     <description>Excessive Screener Rate Queue 0</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EXCESS_RATE_Q0Select</name>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q0_0</name>
                           <description>No excessive rate in screener since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q0_1</name>
                           <description>A screener rate limiting mechanism has been triggered since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EXCESS_RATE_Q1</name>
                     <description>Excessive Screener Rate Queue 1</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EXCESS_RATE_Q1Select</name>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q1_0</name>
                           <description>No excessive rate in screener since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q1_1</name>
                           <description>A screener rate limiting mechanism has been triggered since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EXCESS_RATE_Q2</name>
                     <description>Excessive Screener Rate Queue 2</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EXCESS_RATE_Q2Select</name>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q2_0</name>
                           <description>No excessive rate in screener since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q2_1</name>
                           <description>A screener rate limiting mechanism has been triggered since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EXCESS_RATE_Q3</name>
                     <description>Excessive Screener Rate Queue 3</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EXCESS_RATE_Q3Select</name>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q3_0</name>
                           <description>No excessive rate in screener since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q3_1</name>
                           <description>A screener rate limiting mechanism has been triggered since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EXCESS_RATE_Q4</name>
                     <description>Excessive Screener Rate Queue 4</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EXCESS_RATE_Q4Select</name>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q4_0</name>
                           <description>No excessive rate in screener since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q4_1</name>
                           <description>A screener rate limiting mechanism has been triggered since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EXCESS_RATE_Q5</name>
                     <description>Excessive Screener Rate Queue 5</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EXCESS_RATE_Q5Select</name>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q5_0</name>
                           <description>No excessive rate in screener since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q5_1</name>
                           <description>A screener rate limiting mechanism has been triggered since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EXCESS_RATE_Q6</name>
                     <description>Excessive Screener Rate Queue 6</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EXCESS_RATE_Q6Select</name>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q6_0</name>
                           <description>No excessive rate in screener since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q6_1</name>
                           <description>A screener rate limiting mechanism has been triggered since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EXCESS_RATE_Q7</name>
                     <description>Excessive Screener Rate Queue 7</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EXCESS_RATE_Q7Select</name>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q7_0</name>
                           <description>No excessive rate in screener since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EXCESS_RATE_Q7_1</name>
                           <description>A screener rate limiting mechanism has been triggered since the last read of GMAC_SCR2_RATE_STATUS.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MMSL_CR</name>
               <description>MMSL Control Register</description>
               <addressOffset>0xF00</addressOffset>
               <resetValue>0x00000020</resetValue>
               <fields>
                  <field>
                     <name>ADD_FRAG_SIZE</name>
                     <description>PMAC Minimum Number of Bytes before Preemption</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ADD_FRAG_SIZESelect</name>
                        <enumeratedValue>
                           <name>64_BYTES</name>
                           <description>A minimum of 64 bytes can be sent by pMAC before any preemption. The value can be changed only when PRE_ENABLE is cleared</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>128_BYTES</name>
                           <description>A minimum of 128 bytes can be sent by pMAC before any preemption. The value can be changed only when PRE_ENABLE is cleared</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>192_BYTES</name>
                           <description>A minimum of 192 bytes can be sent by pMAC before any preemption. The value can be changed only when PRE_ENABLE is cleared</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>256_BYTES</name>
                           <description>A minimum of 256 bytes can be sent by pMAC before any preemption. The value can be changed only when PRE_ENABLE is cleared</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>VERIFY_DISABLE</name>
                     <description>802.3br Support Check for the Link Partner</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>VERIFY_DISABLESelect</name>
                        <enumeratedValue>
                           <name>VERIFY_DISABLE_0</name>
                           <description>Enables the 802.3br support check for the link partner.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VERIFY_DISABLE_1</name>
                           <description>Disables the 802.3br support check for the link partner and preemption is enabled as soon as PRE_ENABLE=1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PRE_ENABLE</name>
                     <description>Preemption Operation Enable</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PRE_ENABLESelect</name>
                        <enumeratedValue>
                           <name>PRE_ENABLE_0</name>
                           <description>Disables the preemption operation and verify mpackets will not be responded to or sent. If a preemption is in progress, the current preemption will complete and no more preemption will occur.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PRE_ENABLE_1</name>
                           <description>Enables the preemption by starting the verification procedure when VERIFY_DISABLE=0. Preemption can occur only once the verification process completes. If VERIFY_DISABLE=1, preemption can occur immediately.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RESTART_VER</name>
                     <description>Restart the Verification Procedure (Write-only)</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RESTART_VERSelect</name>
                        <enumeratedValue>
                           <name>RESTART_VER_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RESTART_VER_1</name>
                           <description>Restarts the verification procedure. Writing a one to this bit has no effect if any of the following are true: PRE_ENABLE=0, VERIFY_DISABLE=1 or the verification procedure is already in progress. When preemption is active, ROUTE_RX_TO_PMAC must be set to zero before writing to the RESTART_VER bit. This bit always returns zero when read.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ROUTE_RX_TO_PMAC</name>
                     <description>Route Received Frames to Preemptive MAC</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ROUTE_RX_TO_PMACSelect</name>
                        <enumeratedValue>
                           <name>ROUTE_RX_TO_PMAC_0</name>
                           <description>Routes all received to express MAC (eMAC).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ROUTE_RX_TO_PMAC_1</name>
                           <description>Routes all received frames to preemptive MAC (pMAC).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MMSL_SR</name>
               <description>MMSL Status Register</description>
               <addressOffset>0xF04</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>PRE_ACTIVE</name>
                     <description>Preemption Status</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PRE_ACTIVESelect</name>
                        <enumeratedValue>
                           <name>PRE_ACTIVE_0</name>
                           <description>Preemption is inactive.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PRE_ACTIVE_1</name>
                           <description>Preemption is active when the verification process is completed or when GMAC_MMSL_CR.VERIFY_DISABLE=1 and GMAC_MMSL_CR.PRE_ACTIVE=1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RESPOND_STATUS</name>
                     <description>Response Status</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RESPOND_STATUSSelect</name>
                        <enumeratedValue>
                           <name>R_IDLE</name>
                           <description>Idle</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SEND_RESPOND</name>
                           <description>Sending</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>VERIFY_STATUS</name>
                     <description>Verification Status</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>3</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>VERIFY_STATUSSelect</name>
                        <enumeratedValue>
                           <name>INIT_VERIFICATION</name>
                           <description>Initialization</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VERIFICATION_IDLE</name>
                           <description>Idle</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SEND_VERIFY</name>
                           <description>Sending a verify command</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WAIT_FOR_RESPONSE</name>
                           <description>Waiting for a response</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VERIFIED</name>
                           <description>Verified</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>VERIFY_FAIL</name>
                           <description>Failure during the verify operation</description>
                           <value>5</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RCV_R_ERR</name>
                     <description>Incorrect Response Mpacket Received (Clear on read)</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RCV_R_ERRSelect</name>
                        <enumeratedValue>
                           <name>RCV_R_ERR_0</name>
                           <description>No error since the last read of GMAC_MMSL_SR</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCV_R_ERR_1</name>
                           <description>An incorrect response mPacket has been received since the last read of GMAC_MMSL_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RCV_V_ERR</name>
                     <description>Incorrect Verification Mpacket Received (Clear on read)</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RCV_V_ERRSelect</name>
                        <enumeratedValue>
                           <name>RCV_V_ERR_0</name>
                           <description>No error since the last read of GMAC_MMSL_SR</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RCV_V_ERR_1</name>
                           <description>An incorrect verification mPacket has been received since the last read of GMAC_MMSL_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SMDS_ERR</name>
                     <description>SMD-S Received When Waiting an SMD-C (Clear on read)</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SMDS_ERRSelect</name>
                        <enumeratedValue>
                           <name>SMDS_ERR_0</name>
                           <description>No error since the last read of GMAC_MMSL_SR</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SMDS_ERR_1</name>
                           <description>An SMD-S has been received when an SMD-C was expected, since the last read of GMAC_MMSL_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SMDC_ERR</name>
                     <description>SMD-C Received When Waiting an SMD-S (Clear on read)</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SMDC_ERRSelect</name>
                        <enumeratedValue>
                           <name>SMDC_ERR_0</name>
                           <description>No error since the last read of GMAC_MMSL_SR</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SMDC_ERR_1</name>
                           <description>An SMD-C has been received when an SMD-S was expected, since the last read of GMAC_MMSL_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FRER_COUNT_ERR</name>
                     <description>Frame Counter Error (Clear on read)</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>FRER_COUNT_ERRSelect</name>
                        <enumeratedValue>
                           <name>FRER_COUNT_ERR_0</name>
                           <description>No error since the last read of GMAC_MMSL_SR</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FRER_COUNT_ERR_1</name>
                           <description>A frame counter error occurred since the last read of GMAC_MMSL_SR. A frame counter error occurs when the SMD-C received indicates a different frame count than expected (i.e. the fragment belongs to another frame and not to the Start packet already received before this) or when a fragment error happened, which means the field following the SMD-C received was encoding a different fragment count than it was supposed to be.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SMD_ERR</name>
                     <description>Illegal Start Mpacket Delimiter Received (Clear on read)</description>
                     <bitOffset>10</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SMD_ERRSelect</name>
                        <enumeratedValue>
                           <name>SMD_ERR_0</name>
                           <description>No error since the last read of GMAC_MMSL_SR</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SMD_ERR_1</name>
                           <description>An illegal SMD (different from Express, Verify, Response, Start Preemptible or Continuation Preemptible SMD) has been received since the last read of GMAC_MMSL_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>MMSL_ESR</name>
               <description>MMSL Error Statistics Register</description>
               <addressOffset>0xF08</addressOffset>
               <access>read-only</access>
               <fields>
