                           </enumeratedValue>
                           <enumeratedValue>
                              <name>CPD_1</name>
                              <description>Writing to PWM_CUPDx will modify the period at the next period start event.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
