            </register>
            <register>
               <name>SR</name>
               <description>Status Register</description>
               <addressOffset>0x8</addressOffset>
               <resetValue>0x00000001</resetValue>
               <fields>
                  <field>
                     <name>BUSY</name>
                     <description>Operation in Progress</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BUSYSelect</name>
                        <enumeratedValue>
                           <name>BUSY_0</name>
                           <description>No operation is in progress. A new operation can be initiated.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BUSY_1</name>
                           <description>An operation is in progress. No new operation must be launched.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OK</name>
                     <description>Last Operation Successfully Achieved</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OKSelect</name>
                        <enumeratedValue>
                           <name>OK_0</name>
                           <description>ERROR bit must be checked.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OK_1</name>
                           <description>The last operation completed successfully.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ERROR</name>
                     <description>Last Operation Failed</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ERRORSelect</name>
                        <enumeratedValue>
                           <name>ERROR_0</name>
                           <description>The last operation completed successfully.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ERROR_1</name>
                           <description>The last operation failed.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ZEROIZED</name>
                     <description>PUF Zeroization in Progress</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ZEROIZEDSelect</name>
                        <enumeratedValue>
                           <name>ZEROIZED_0</name>
                           <description>No zeroization is in progress.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ZEROIZED_1</name>
                           <description>A zeroization action is in progress or the PUF is in Locked state.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>REJECTED</name>
                     <description>Last Command Rejection Status (cleared by writing a 1)</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>REJECTEDSelect</name>
                        <enumeratedValue>
                           <name>REJECTED_0</name>
                           <description>No rejection event occurred since the last clearing access.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>REJECTED_1</name>
                           <description>A rejection event occurred when the last command has been launched. Cleared by writing a 1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DIREQ</name>
                     <description>Data In Request Status</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DIREQSelect</name>
                        <enumeratedValue>
                           <name>DIREQ_0</name>
                           <description>No data-in transfer is in progress.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DIREQ_1</name>
                           <description>A data-in transfer is in progress following a request via PUF_DIR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DOREQ</name>
                     <description>Data Out Request Status</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DOREQSelect</name>
                        <enumeratedValue>
                           <name>DOREQ_0</name>
                           <description>No data-out transfer is in progress.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DOREQ_1</name>
                           <description>A data-out transfer is in progress following a request via PUF_DOR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RESEEDW</name>
                     <description>Reseed Warning</description>
                     <bitOffset>29</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RESEEDWSelect</name>
                        <enumeratedValue>
                           <name>NO_ACTION</name>
                           <description>No action required.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RECOMMENDED_ACTION</name>
                           <description>The reseed counter of the DRBG is close to its limit, it is recommended to reseed at the first suitable moment. This bit is the same as in PUF_ORR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RESEEDR</name>
                     <description>Reseed Required</description>
                     <bitOffset>30</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RESEEDRSelect</name>
                        <enumeratedValue>
                           <name>NO_ACTION</name>
                           <description>No action required.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>REQUIRED_ACTION</name>
                           <description>The maximum number of DRBG2 requests has been done. A reseed must be performed before other operations can be done. This bit is the same as in PUF_ORR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>AR</name>
               <description>Allow Register</description>
               <addressOffset>0xC</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>ENROLL</name>
                     <description>Enroll Operation</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>START</name>
                     <description>Start Operation</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RECO</name>
                     <description>Reconstruct Operation</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>STOP</name>
                     <description>Stop Operation</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>GETKEY</name>
                     <description>Get Key Operation</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>UNWRAP</name>
                     <description>Unwrap Operation</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>WGENRAND</name>
                     <description>Wrap Generated Random Operation</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>WRAP</name>
                     <description>Wrap Operation</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>GENRAND</name>
                     <description>Generate Random Operation</description>
                     <bitOffset>15</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RESEED</name>
                     <description>Reseed Operation</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TESTMEM</name>
                     <description>Test Memory Operation</description>
                     <bitOffset>30</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>TESTPUF</name>
                     <description>Test PUF Operation</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>IER</name>
               <description>Interrupt Enable Register</description>
               <addressOffset>0x10</addressOffset>
               <fields>
                  <field>
                     <name>INTEN</name>
                     <description>Interruption Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>INTENSelect</name>
                        <enumeratedValue>
                           <name>INTEN_0</name>
                           <description>Disables the interruption.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>INTEN_1</name>
                           <description>Enables the PUF to trigger an interruption from the sources selected in PUF_IMR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IMR</name>
               <description>Interrupt Mask Register</description>
               <addressOffset>0x14</addressOffset>
               <fields>
                  <field>
                     <name>BUSY</name>
                     <description>Operation Start Event</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>OK</name>
                     <description>Last Operation Successful Achievement Event</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>ERROR</name>
                     <description>Last Operation Fail Event</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>ZEROIZED</name>
                     <description>Zeroized Operation Completed Event</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>REJECTED</name>
                     <description>Last Activation Code Rejection Event</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DIREQ</name>
                     <description>Data In Request Event</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DOREQ</name>
                     <description>Data Out Request Event</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RESEEDW</name>
                     <description>Reseed Warning Event</description>
                     <bitOffset>29</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RESEEDR</name>
                     <description>Reseed Action Required Event</description>
                     <bitOffset>30</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>ISR</name>
               <description>Interrupt Status Register</description>
               <addressOffset>0x18</addressOffset>
               <fields>
                  <field>
                     <name>BUSY</name>
                     <description>Operation in Progress (cleared by writing a 1)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>OK</name>
                     <description>Last Operation Achievement (cleared by writing a 1)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>ERROR</name>
                     <description>Last Operation Fail (cleared by writing a 1)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>ZEROIZED</name>
                     <description>Zeroized Operation Completed (cleared by writing a 1)</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>REJECTED</name>
                     <description>Last Activation Code Rejection (cleared by writing a 1)</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DIREQ</name>
                     <description>Data In Request (cleared by writing a 1)</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DOREQ</name>
                     <description>Data Out Request (cleared by writing a 1)</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RESEEDW</name>
                     <description>Reseed Warning (cleared by writing a 1)</description>
                     <bitOffset>29</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RESEEDR</name>
                     <description>Reseed Action Required (cleared by writing a 1)</description>
                     <bitOffset>30</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>DATA_DEST</name>
               <description>Data Destination Register</description>
               <addressOffset>0x20</addressOffset>
               <fields>
                  <field>
                     <name>DO</name>
                     <description>Data Output on PUF_DOR</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DOSelect</name>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>PUF_DOR cannot be used to read data from PUF operations.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DO_VIA_DOR</name>
                           <description>PUF_DOR is enabled to read data from PUF operations.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DATA_SRC</name>
               <description>Data Source Register</description>
               <addressOffset>0x24</addressOffset>
               <fields>
                  <field>
                     <name>DI</name>
                     <description>Data Input Loaded from PUF_DIR</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DISelect</name>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>PUF_DIR cannot be used to transfer data to PUF.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DI_VIA_DIR</name>
                           <description>PUF_DIR is enabled to load data to PUF.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>KEY_INDEX</name>
               <description>Key Index Register</description>
               <addressOffset>0x28</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>KI</name>
                     <description>Key Index</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>DIR</name>
               <description>Data Input Register</description>
               <addressOffset>0xA0</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>DI</name>
                     <description>Data Input Value</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>32</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>DOR</name>
               <description>Data Output Register</description>
               <addressOffset>0xA8</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>DO</name>
                     <description>Data Output Value</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>32</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>MISC</name>
               <description>Miscellaneous Register</description>
               <addressOffset>0xC0</addressOffset>
               <resetValue>0x00000001</resetValue>
               <fields>
                  <field>
                     <name>DEND</name>
                     <description>Data Endianness</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DENDSelect</name>
                        <enumeratedValue>
                           <name>LITTLE</name>
                           <description>Little-endian mode.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BIG</name>
                           <description>Big-endian mode. This is the default value.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IF_SR</name>
               <description>Interface Status Register</description>
               <addressOffset>0xD0</addressOffset>
               <fields>
                  <field>
                     <name>BUSERR</name>
                     <description>Bus Access Error (cleared by writing a 1)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BUSERRSelect</name>
                        <enumeratedValue>
                           <name>NONE</name>
                           <description>No incorrect access performed since the last write access (BUSERR=1).</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ERROR</name>
                           <description>An incorrect access has been performed. Cleared by writing a 1.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TEST</name>
               <description>Test Register</description>
               <addressOffset>0xD8</addressOffset>
               <fields>
                  <field>
                     <name>BISTEN</name>
                     <description>Built-In Self-Test Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BISTENSelect</name>
                        <enumeratedValue>
                           <name>BISTEN_0</name>
                           <description>Disables the BIST, must be performed once BIST completion event occurred (BISTOK=1).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BISTEN_1</name>
                           <description>Starts the BIST.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BISTRUN</name>
                     <description>Built-In Self-Test Run Status</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BISTRUNSelect</name>
                        <enumeratedValue>
                           <name>BISTRUN_0</name>
                           <description>BIST is not active or has not started yet.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BISTRUN_1</name>
                           <description>BIST is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BISTACTIVE</name>
                     <description>Built-In Self-Test Activity Status</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BISTACTIVESelect</name>
                        <enumeratedValue>
                           <name>BISTACTIVE_0</name>
                           <description>BIST has completed if BISTRUN=1.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BISTACTIVE_1</name>
                           <description>If BISTRUN=1, BIST is in progress.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BISTOK</name>
                     <description>Built-In Self-Test Run Passed</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BISTOKSelect</name>
                        <enumeratedValue>
                           <name>BISTOK_0</name>
                           <description>No action</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BISTOK_1</name>
                           <description>If BISTRUN=1 and BISTACTIVE=0, BIST has passed successfully.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BISTERR</name>
                     <description>Built-In Self-Test Error</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BISTERRSelect</name>
                        <enumeratedValue>
                           <name>BISTERR_0</name>
                           <description>No action</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BISTERR_1</name>
                           <description>If BISTRUN=1 and BISTACTIVE=0, BIST has failed.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BISTALLOW</name>
                     <description>Built-In Self-Test Allowed</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BISTALLOWSelect</name>
                        <enumeratedValue>
                           <name>BISTALLOW_0</name>
                           <description>BIST Start (BISTEN) command is disabled and has no effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BISTALLOW_1</name>
                           <description>BIST Start command (BISTEN) is allowed.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>PSR</name>
               <description>Score Register</description>
               <addressOffset>0xDC</addressOffset>
               <access>read-only</access>
               <resetValue>0x0000000F</resetValue>
               <fields>
                  <field>
                     <name>SCORE</name>
                     <description>Last Test Score</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <dim>2</dim>
               <dimIncrement>4</dimIncrement>
               <name>HW_RUC[%s]</name>
               <description>Hardware Restrict User Context x Register</description>
               <addressOffset>0xE0</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>RUC0</name>
                     <description>Restrict User Context Bit 0</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RUC0Select</name>
                        <enumeratedValue>
                           <name>RUC0_0</name>
                           <description>This bit can be used in the user context 0 field.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RUC0_1</name>
                           <description>This bit cannot be used in the user context 0 field.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RUC1</name>
                     <description>Restrict User Context Bit 1</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RUC1Select</name>
                        <enumeratedValue>
                           <name>RUC1_0</name>
                           <description>This bit can be used in the user context 0 field.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RUC1_1</name>
                           <description>This bit cannot be used in the user context 0 field.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RUC2</name>
                     <description>Restrict User Context Bit 2</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RUC2Select</name>
                        <enumeratedValue>
                           <name>RUC2_0</name>
                           <description>This bit can be used in the user context 0 field.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RUC2_1</name>
                           <description>This bit cannot be used in the user context 0 field.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RUC3</name>
                     <description>Restrict User Context Bit 3</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RUC3Select</name>
                        <enumeratedValue>
                           <name>RUC3_0</name>
                           <description>This bit can be used in the user context 0 field.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RUC3_1</name>
                           <description>This bit cannot be used in the user context 0 field.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RUC4</name>
                     <description>Restrict User Context Bit 4</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RUC4Select</name>
                        <enumeratedValue>
                           <name>RUC4_0</name>
                           <description>This bit can be used in the user context 0 field.</description>
