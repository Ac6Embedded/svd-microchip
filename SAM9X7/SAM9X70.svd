                           <value>0xFD</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_FAILURE_SETTINGS</name>
                           <description>Initialization cannot finish due to illegal values in PUF_HW_SETTINGS.</description>
                           <value>0xFE</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_FAILURE_SRAM</name>
                           <description>PUF SRAM access has failed.</description>
                           <value>0xFF</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RESEEDW</name>
                     <description>Reseed Warning</description>
                     <bitOffset>14</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RESEEDWSelect</name>
                        <enumeratedValue>
                           <name>NO_ACTION</name>
                           <description>No action required.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RECOMMENDED_ACTION</name>
                           <description>The DRBG reseed counter is close to its limit, it is recommended to reseed at the first suitable moment. This bit is the same as in PUF_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RESEEDR</name>
                     <description>Reseed Required</description>
                     <bitOffset>15</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RESEEDRSelect</name>
                        <enumeratedValue>
                           <name>NO_ACTION</name>
                           <description>No action required.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>REQUIRED_ACTION</name>
                           <description>The maximum number of DRBG2 requests has been done. A reseed must be performed before other operations can be done. This bit is the same as in PUF_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LOPNUM</name>
                     <description>Last Operation Number</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>8</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>LOPNUMSelect</name>
                        <enumeratedValue>
                           <name>IID_PUF_LO_PROGRESS</name>
                           <description>An operation is in progress.</description>
                           <value>0x00</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_LO_ENROLL</name>
                           <description>The last operation was ENROLL.</description>
                           <value>0x01</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_LO_START</name>
