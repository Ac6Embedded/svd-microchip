                     <bitOffset>29</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ENPLLCKSelect</name>
                        <enumeratedValue>
                           <name>ENPLLCK_0</name>
                           <description>The clock generated by the PLL is not send to the IP_Acronym.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENPLLCK_1</name>
