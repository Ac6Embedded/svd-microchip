                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SMRM_1</name>
                           <description>Serial Memory registers are written via peripheral bus access.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
