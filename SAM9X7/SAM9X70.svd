                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RXRDY_1</name>
                           <description>Data has been received and loaded in SSC_RHR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
