                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WRITE_RO</name>
                           <description>A write access has been performed on a read-only register (warning).</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CONF_CHG</name>
                           <description>A change has been made into the configuration (error).</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>KEY_ERROR</name>
                           <description>A write has been computed in OTPC_CR or OTPC_WPMR register with a wrong value in the related KEY field (error).</description>
                           <value>3</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DATA_ACC</name>
                           <description>The non-secure world application tried to read a packet from the secure world (error).</description>
                           <value>4</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ECLASS</name>
                     <description>Software Error Class</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
