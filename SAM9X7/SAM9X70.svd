                           <name>TWIN_QUAD</name>
                           <description>Twin-Quad protocol</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OCTAFLASH</name>
                           <description>OctaFlash protocol</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HYPERFLASH</name>
                           <description>HyperFlash protocol</description>
                           <value>3</value>
                        </enumeratedValue>
