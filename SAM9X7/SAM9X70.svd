                           <name>EOC4_1</name>
                           <description>The corresponding analog channel is enabled and conversion is complete.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EOC5</name>
                     <description>End of Conversion 5 (automatically set / cleared)</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EOC5Select</name>
                        <enumeratedValue>
                           <name>EOC5_0</name>
                           <description>The corresponding analog channel is disabled, or the conversion is not finished. This flag is cleared when reading the corresponding ADC_CDRx registers.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EOC5_1</name>
                           <description>The corresponding analog channel is enabled and conversion is complete.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EOC6</name>
                     <description>End of Conversion 6 (automatically set / cleared)</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EOC6Select</name>
                        <enumeratedValue>
                           <name>EOC6_0</name>
                           <description>The corresponding analog channel is disabled, or the conversion is not finished. This flag is cleared when reading the corresponding ADC_CDRx registers.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EOC6_1</name>
                           <description>The corresponding analog channel is enabled and conversion is complete.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EOC7</name>
                     <description>End of Conversion 7 (automatically set / cleared)</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EOC7Select</name>
                        <enumeratedValue>
                           <name>EOC7_0</name>
                           <description>The corresponding analog channel is disabled, or the conversion is not finished. This flag is cleared when reading the corresponding ADC_CDRx registers.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EOC7_1</name>
                           <description>The corresponding analog channel is enabled and conversion is complete.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>LCCHG</name>
                     <description>Last Channel Change (cleared on read)</description>
                     <bitOffset>19</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>LCCHGSelect</name>
                        <enumeratedValue>
                           <name>LCCHG_0</name>
                           <description>There is no comparison match (defined in the Last Channel Compare Window register (ADC_LCCWR) since the last read of ADC_ISR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LCCHG_1</name>
                           <description>The converted value reported on ADC_CDR7 has changed since the last read of ADC_ISR, according to what is defined in ADC_LCTMR and ADC_LCCWR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>XRDY</name>
                     <description>Touchscreen XPOS Measure Ready (cleared on read)</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>XRDYSelect</name>
                        <enumeratedValue>
                           <name>XRDY_0</name>
                           <description>No measure has been performed since the last read of ADC_XPOSR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>XRDY_1</name>
                           <description>At least one measure has been performed since the last read of ADC_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>YRDY</name>
                     <description>Touchscreen YPOS Measure Ready (cleared on read)</description>
                     <bitOffset>21</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>YRDYSelect</name>
                        <enumeratedValue>
                           <name>YRDY_0</name>
                           <description>No measure has been performed since the last read of ADC_YPOSR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>YRDY_1</name>
                           <description>At least one measure has been performed since the last read of ADC_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PRDY</name>
                     <description>Touchscreen Pressure Measure Ready (cleared on read)</description>
                     <bitOffset>22</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PRDYSelect</name>
                        <enumeratedValue>
                           <name>PRDY_0</name>
                           <description>No measure has been performed since the last read of ADC_PRESSR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PRDY_1</name>
                           <description>At least one measure has been performed since the last read of ADC_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DRDY</name>
                     <description>Data Ready (automatically set / cleared)</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DRDYSelect</name>
                        <enumeratedValue>
                           <name>DRDY_0</name>
                           <description>No data has been converted since the last read of ADC_LCDR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DRDY_1</name>
                           <description>At least one data has been converted and is available in ADC_LCDR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>GOVRE</name>
                     <description>General Overrun Error (cleared on read)</description>
                     <bitOffset>25</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>GOVRESelect</name>
                        <enumeratedValue>
                           <name>GOVRE_0</name>
                           <description>No general overrun error occurred since the last read of ADC_ISR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>GOVRE_1</name>
                           <description>At least one general overrun error has occurred since the last read of ADC_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>COMPE</name>
                     <description>Comparison Event (cleared on read)</description>
                     <bitOffset>26</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>COMPESelect</name>
                        <enumeratedValue>
                           <name>COMPE_0</name>
                           <description>No comparison event since the last read of ADC_ISR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>COMPE_1</name>
                           <description>At least one comparison event (defined in ADC_EMR and ADC_CWR) has occurred since the last read of ADC_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PEN</name>
                     <description>Pen contact (cleared on read)</description>
                     <bitOffset>29</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PENSelect</name>
                        <enumeratedValue>
                           <name>PEN_0</name>
                           <description>No pen contact since the last read of ADC_ISR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PEN_1</name>
                           <description>At least one pen contact since the last read of ADC_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NOPEN</name>
                     <description>No Pen Contact (cleared on read)</description>
                     <bitOffset>30</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NOPENSelect</name>
                        <enumeratedValue>
                           <name>NOPEN_0</name>
                           <description>No loss of pen contact since the last read of ADC_ISR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NOPEN_1</name>
                           <description>At least one loss of pen contact since the last read of ADC_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PENS</name>
                     <description>Pen Detect Status</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PENSSelect</name>
                        <enumeratedValue>
                           <name>PENS_0</name>
                           <description>The pen does not press the screen.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PENS_1</name>
                           <description>The pen presses the screen.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>LCTMR</name>
               <description>Last Channel Trigger Mode Register</description>
               <addressOffset>0x34</addressOffset>
               <fields>
                  <field>
                     <name>DUALTRIG</name>
                     <description>Dual Trigger ON</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DUALTRIGSelect</name>
                        <enumeratedValue>
                           <name>DUALTRIG_0</name>
                           <description>All channels are triggered by event defined by ADC_MR.TRGSEL.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DUALTRIG_1</name>
                           <description>Last channel (higher index) trigger period is defined by RTC_MR.OUT1.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CMPMOD</name>
                     <description>Last Channel Comparison Mode</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CMPMODSelect</name>
                        <enumeratedValue>
                           <name>LOW</name>
                           <description>Generates the ADC_ISR.LCCHG flag when the converted data is lower than the low threshold of the window.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HIGH</name>
                           <description>Generates the ADC_ISR.LCCHG flag when the converted data is higher than the high threshold of the window.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IN</name>
                           <description>Generates the ADC_ISR.LCCHG flag when the converted data is in the comparison window.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OUT</name>
                           <description>Generates the ADC_ISR.LCCHG flag when the converted data is out of the comparison window.</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>LCCWR</name>
               <description>Last Channel Compare Window Register</description>
               <addressOffset>0x38</addressOffset>
               <fields>
                  <field>
                     <name>LOWTHRES</name>
                     <description>Low Threshold</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>12</bitWidth>
                  </field>
                  <field>
                     <name>HIGHTHRES</name>
                     <description>High Threshold</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>12</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>OVER</name>
               <description>Overrun Status Register</description>
               <addressOffset>0x3C</addressOffset>
               <access>read-only</access>
               <fields>
                  <field>
                     <name>OVRE0</name>
                     <description>Overrun Error 0</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVRE0Select</name>
                        <enumeratedValue>
                           <name>OVRE0_0</name>
                           <description>No overrun error on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVRE0_1</name>
                           <description>An overrun error has occurred on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVRE1</name>
                     <description>Overrun Error 1</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVRE1Select</name>
                        <enumeratedValue>
                           <name>OVRE1_0</name>
                           <description>No overrun error on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVRE1_1</name>
                           <description>An overrun error has occurred on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVRE2</name>
                     <description>Overrun Error 2</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVRE2Select</name>
                        <enumeratedValue>
                           <name>OVRE2_0</name>
                           <description>No overrun error on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVRE2_1</name>
                           <description>An overrun error has occurred on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVRE3</name>
                     <description>Overrun Error 3</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVRE3Select</name>
                        <enumeratedValue>
                           <name>OVRE3_0</name>
                           <description>No overrun error on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVRE3_1</name>
                           <description>An overrun error has occurred on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVRE4</name>
                     <description>Overrun Error 4</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVRE4Select</name>
                        <enumeratedValue>
                           <name>OVRE4_0</name>
                           <description>No overrun error on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVRE4_1</name>
                           <description>An overrun error has occurred on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVRE5</name>
                     <description>Overrun Error 5</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVRE5Select</name>
                        <enumeratedValue>
                           <name>OVRE5_0</name>
                           <description>No overrun error on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVRE5_1</name>
                           <description>An overrun error has occurred on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVRE6</name>
                     <description>Overrun Error 6</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVRE6Select</name>
                        <enumeratedValue>
                           <name>OVRE6_0</name>
                           <description>No overrun error on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVRE6_1</name>
                           <description>An overrun error has occurred on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OVRE7</name>
                     <description>Overrun Error 7</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OVRE7Select</name>
                        <enumeratedValue>
                           <name>OVRE7_0</name>
                           <description>No overrun error on the corresponding channel since the last read of ADC_OVER.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OVRE7_1</name>
                           <description>An overrun error has occurred on the corresponding channel since the last read of ADC_OVER.</description>
