            <cluster>
               <dim>6</dim>
               <dimIncrement>0x10</dimIncrement>
               <dimIndex>1-6</dimIndex>
               <name>UDPHS_DMA%s</name>
               <description/>
               <addressOffset>0x310</addressOffset>
               <register>
                  <name>DMANXTDSC</name>
                  <description>UDPHS DMA Next Descriptor Address Register </description>
                  <addressOffset>0x0</addressOffset>
                  <fields>
                     <field>
                        <name>NXT_DSC_ADD</name>
                        <description>Next Descriptor Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>DMAADDRESS</name>
                  <description>UDPHS DMA Channel Address Register </description>
                  <addressOffset>0x4</addressOffset>
                  <fields>
                     <field>
                        <name>BUFF_ADD</name>
                        <description>Buffer Address</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>32</bitWidth>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>DMACONTROL</name>
                  <description>UDPHS DMA Channel Control Register </description>
                  <addressOffset>0x8</addressOffset>
                  <fields>
                     <field>
                        <name>CHANN_ENB</name>
                        <description>(Channel Enable Command)</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>CHANN_ENBSelect</name>
                           <enumeratedValue>
                              <name>CHANN_ENB_0</name>
                              <description>DMA channel is disabled at and no transfer will occur upon request. This bit is also cleared by hardware when the channel source bus is disabled at end of buffer.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>CHANN_ENB_1</name>
                              <description>UDPHS_DMASTATUS register CHANN_ENB bit will be set, thus enabling DMA channel data transfer. Then any pending request will start the transfer. This may be used to start or resume any requested transfer.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>LDNXT_DSC</name>
                        <description>Load Next Channel Transfer Descriptor Enable (Command)</description>
                        <bitOffset>1</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>LDNXT_DSCSelect</name>
                           <enumeratedValue>
                              <name>LDNXT_DSC_0</name>
                              <description>No channel register is loaded after the end of the channel transfer.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>LDNXT_DSC_1</name>
                              <description>The channel controller loads the next descriptor after the end of the current transfer, i.e., when the UDPHS_DMASTATUS/CHANN_ENB bit is reset.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>END_TR_EN</name>
                        <description>End of Transfer Enable (Control)</description>
                        <bitOffset>2</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>END_TR_ENSelect</name>
                           <enumeratedValue>
                              <name>END_TR_EN_0</name>
                              <description>USB end of transfer is ignored.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>END_TR_EN_1</name>
                              <description>UDPHS device can put an end to the current buffer transfer.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>END_B_EN</name>
                        <description>End of Buffer Enable (Control)</description>
                        <bitOffset>3</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>END_B_ENSelect</name>
                           <enumeratedValue>
                              <name>END_B_EN_0</name>
                              <description>DMA Buffer End has no impact on USB packet transfer.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>END_B_EN_1</name>
                              <description>Endpoint can validate the packet (according to the values programmed in the UDPHS_EPTCTLx register AUTO_VALID and SHRT_PCKT fields) at DMA Buffer End, i.e., when the UDPHS_DMASTATUS register BUFF_COUNT reaches 0.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>END_TR_IT</name>
                        <description>End of Transfer Interrupt Enable</description>
                        <bitOffset>4</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>END_TR_ITSelect</name>
                           <enumeratedValue>
                              <name>END_TR_IT_0</name>
                              <description>UDPHS device initiated buffer transfer completion will not trigger any interrupt at UDPHS_STATUSx/END_TR_ST rising.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>END_TR_IT_1</name>
                              <description>An interrupt is sent after the buffer transfer is complete, if the UDPHS device has ended the buffer transfer.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>END_BUFFIT</name>
                        <description>End of Buffer Interrupt Enable</description>
                        <bitOffset>5</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>END_BUFFITSelect</name>
                           <enumeratedValue>
                              <name>END_BUFFIT_0</name>
                              <description>UDPHS_DMA_STATUSx/END_BF_ST rising will not trigger any interrupt.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>END_BUFFIT_1</name>
                              <description>An interrupt is generated when the UDPHS_DMASTATUSx register BUFF_COUNT reaches zero.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>DESC_LD_IT</name>
                        <description>Descriptor Loaded Interrupt Enable</description>
                        <bitOffset>6</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>DESC_LD_ITSelect</name>
                           <enumeratedValue>
                              <name>DESC_LD_IT_0</name>
                              <description>UDPHS_DMASTATUSx/DESC_LDST rising will not trigger any interrupt.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>DESC_LD_IT_1</name>
                              <description>An interrupt is generated when a descriptor has been loaded from the bus.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>BURST_LCK</name>
                        <description>Burst Lock Enable</description>
                        <bitOffset>7</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>BURST_LCKSelect</name>
                           <enumeratedValue>
                              <name>BURST_LCK_0</name>
                              <description>The DMA never locks bus access.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BURST_LCK_1</name>
                              <description>USB packets system bus data bursts are locked for maximum optimization of the bus bandwidth usage and maximization of fly-by system bus burst duration.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>BUFF_LENGTH</name>
                        <description>Buffer Byte Length (Write-only)</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>16</bitWidth>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>DMASTATUS</name>
                  <description>UDPHS DMA Channel Status Register </description>
                  <addressOffset>0xC</addressOffset>
                  <fields>
                     <field>
                        <name>CHANN_ENB</name>
                        <description>Channel Enable Status</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>CHANN_ENBSelect</name>
                           <enumeratedValue>
                              <name>CHANN_ENB_0</name>
                              <description>The DMA channel no longer transfers data, and may load the next descriptor if the UDPHS_DMACONTROLx register LDNXT_DSC bit is set.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>CHANN_ENB_1</name>
                              <description>The DMA channel is currently enabled and transfers data upon request.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>CHANN_ACT</name>
                        <description>Channel Active Status</description>
                        <bitOffset>1</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>CHANN_ACTSelect</name>
                           <enumeratedValue>
                              <name>CHANN_ACT_0</name>
                              <description>The DMA channel is no longer trying to source the packet data.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>CHANN_ACT_1</name>
                              <description>The DMA channel is currently trying to source packet data, i.e., selected as the highest-priority requesting channel.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>END_TR_ST</name>
                        <description>End of Channel Transfer Status</description>
                        <bitOffset>4</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>END_TR_STSelect</name>
                           <enumeratedValue>
                              <name>END_TR_ST_0</name>
                              <description>Cleared automatically when read by software.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>END_TR_ST_1</name>
                              <description>Set by hardware when the last packet transfer is complete, if the UDPHS device has ended the transfer.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>END_BF_ST</name>
                        <description>End of Channel Buffer Status</description>
                        <bitOffset>5</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>END_BF_STSelect</name>
                           <enumeratedValue>
                              <name>END_BF_ST_0</name>
                              <description>Cleared automatically when read by software.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>END_BF_ST_1</name>
                              <description>Set by hardware when the BUFF_COUNT countdown reaches zero.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>DESC_LDST</name>
                        <description>Descriptor Loaded Status</description>
                        <bitOffset>6</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>DESC_LDSTSelect</name>
                           <enumeratedValue>
                              <name>DESC_LDST_0</name>
                              <description>Cleared automatically when read by software.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>DESC_LDST_1</name>
                              <description>Set by hardware when a descriptor has been loaded from the system bus.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>BUFF_COUNT</name>
                        <description>Buffer Byte Count</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>16</bitWidth>
                     </field>
                  </fields>
               </register>
            </cluster>
         </registers>
      </peripheral>
      <peripheral>
         <name>UHPHS_OHCI</name>
         <version>441640</version>
         <description>USB Host Full-Speed Port</description>
         <groupName>UHPFS</groupName>
         <prependToName>UHPFS_</prependToName>
         <baseAddress>0x00600000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x60</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>HcRevision</name>
               <description>OHCI Revision Number Register</description>
               <addressOffset>0x0</addressOffset>
               <access>read-only</access>
               <resetValue>0x00000010</resetValue>
               <fields>
                  <field>
                     <name>REV</name>
                     <description>OHCI Revision Number</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>8</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>REVSelect</name>
                        <enumeratedValue>
                           <name>0x10</name>
                           <description>This read-only field contains the BCD representation of the version of the HCI specification that is implemented by this HC. For example, a value of 11h corresponds to version 1.1. All of the HC implementations that are compliant with this specification will have a value of 10h.</description>
                           <value>0x10</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>HcControl</name>
               <description>HC Operating Mode Register</description>
               <addressOffset>0x4</addressOffset>
               <fields>
                  <field>
                     <name>CBSR</name>
                     <description>Control/Bulk Service Ratio</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CBSRSelect</name>
                        <enumeratedValue>
                           <name>CBSR_0</name>
                           <description>1 control ED per bulk ED.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0x1</name>
                           <description>2 control EDs per bulk ED.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0x2</name>
                           <description>3 control EDs per bulk ED.</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0x3</name>
                           <description>4 control EDs per bulk ED.</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PLE</name>
                     <description>Periodic List Enable</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PLESelect</name>
                        <enumeratedValue>
                           <name>PLE_0</name>
                           <description>Periodic ED lists are not processed. Periodic list processing is disabled beginning with the next frame.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PLE_1</name>
                           <description>Enables processing of the periodic ED lists. Periodic list processing begins in the next frame.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IE</name>
                     <description>Isochronous Enable</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>IESelect</name>
                        <enumeratedValue>
                           <name>IE_0</name>
                           <description>Isochronous EDs are not processed. The USB1.1 host controller checks this bit every time it finds an isochronous ED in the periodic list.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IE_1</name>
                           <description>Enables processing of isochronous EDs in the next frame, if not in the current frame.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CLE</name>
                     <description>ControL List Enable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CLESelect</name>
                        <enumeratedValue>
                           <name>CLE_0</name>
                           <description>The control ED list is not processed in the next 1 ms frame. The host controller driver can modify the control ED list. If the driver removes the ED pointed to by the UHPFS_HcControlCurrentED register from the ED list, it must update the UHPFS_HcControlCurrentED register to point to a current ED before it reenables the control list.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CLE_1</name>
                           <description>Enables processing of the control ED list. The UHPFS_HcControlHeadED register must be 0 or point to a valid ED before setting this bit. The UHPFS_HcControlCurrentED register must be 0 or point to a valid ED before setting this bit.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BLE</name>
                     <description>Bulk List Enable</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BLESelect</name>
                        <enumeratedValue>
                           <name>BLE_0</name>
                           <description>The bulk ED list is not processed in the next 1 ms frame. The host controller driver can modify the bulk ED list. If the driver removes the ED pointed to by the UHPFS_HcBulkCurrentED register from the ED list, it must update the UHPFS_HcBulkCurrentED register to point to a current ED before it reenables the bulk list.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BLE_1</name>
                           <description>Enables processing of the bulk ED list. The UHPFS_HcBulkHeadED register must be 0 or point to a valid ED before setting this bit. The UHPFS_HcBulkCurrentED register must be 0 or point to a valid ED before setting this bit.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>HCFS</name>
                     <description>Host Controller Functional State</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>HCFSSelect</name>
                        <enumeratedValue>
                           <name>HCFS_0</name>
                           <description>USB reset.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0x1</name>
                           <description>USB resume.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0x2</name>
                           <description>USB operational.</description>
                           <value>0x2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>0x3</name>
                           <description>USB suspend.</description>
                           <value>0x3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>IR</name>
                     <description>Interrupt Routing</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>IRSelect</name>
                        <enumeratedValue>
                           <name>IR_0</name>
                           <description>The USB1.1 host controller does not provide an SMI interrupt. This bit must be 0 to allow the USB1.1 host controller interrupt to propagate to the MPU level 2 interrupt controller.</description>
                           <value>0</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RWC</name>
                     <description>Remote Wakeup Connected</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>RWE</name>
                     <description>Remote Wakeup Enable</description>
                     <bitOffset>10</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>HcCommandStatus</name>
               <description>HC Command and Status Register</description>
               <addressOffset>0x8</addressOffset>
               <fields>
                  <field>
                     <name>HCR</name>
                     <description>Host Controller Reset (read/write)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>HCRSelect</name>
                        <enumeratedValue>
                           <name>HCR_0</name>
                           <description>No effect.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>HCR_1</name>
                           <description>Initiates a software reset of the USB1.1 host controller. This transitions the USB1.1 host controller to the USB suspend state. This resets most USB1.1 host controller OHCI registers. OHCI register accesses must not be attempted until a read of this bit returns a 0. A write of 1 to this bit does not reset the root hub and does not signal USB reset to downstream USB functions.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CLF</name>
                     <description>Control List Filled (read/write)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>BLF</name>
                     <description>Bulk List Filled (read/write)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>OCR</name>
                     <description>Ownership Change Request (read/write)</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>SOC</name>
                     <description>Scheduling Overrun Count (read-only)</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>2</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>HcInterruptStatus</name>
               <description>HC Interrupt and Status Register</description>
               <addressOffset>0xC</addressOffset>
               <fields>
                  <field>
                     <name>SO</name>
                     <description>Scheduling Overrun (read/write, write '1' to clear)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SOSelect</name>
                        <enumeratedValue>
                           <name>SO_0</name>
                           <description>A scheduling overrun has not occurred.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SO_1</name>
                           <description>A scheduling overrun has occurred.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WDH</name>
                     <description>Write Done Head (read/write, write '1' to clear)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WDHSelect</name>
                        <enumeratedValue>
                           <name>WDH_0</name>
                           <description>USB1.1 host controller has not updated the UHPFS_HcDoneHead register.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WDH_1</name>
                           <description>USB1.1 host controller has updated the UHPFS_HcDoneHead register.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SF</name>
                     <description>Start of Frame (read/write, write '1' to clear)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SFSelect</name>
                        <enumeratedValue>
                           <name>SF_0</name>
                           <description>A SOF has not been issued.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SF_1</name>
                           <description>A SOF has been issued.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RD</name>
                     <description>Resume Detected (read/write, write '1' to clear)</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RDSelect</name>
                        <enumeratedValue>
                           <name>RD_0</name>
                           <description>A downstream device has not issued a resume request.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RD_1</name>
                           <description>A downstream device has issued a resume request.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>UE</name>
                     <description>Unrecoverable Error (read/write, write '1' to clear)</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>UESelect</name>
                        <enumeratedValue>
                           <name>UE_0</name>
                           <description>An unrecoverable error has not occurred.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UE_1</name>
                           <description>An unrecoverable error has occurred on the OCPI bus, or that an isochronous TD PSW field condition code was not set to Not Accessed when the USB1.1 host controller attempted to perform a transfer using that PSW/offset pair.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FNO</name>
                     <description>Frame Number Overflow (read/write, write '1' to clear)</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>FNOSelect</name>
                        <enumeratedValue>
                           <name>FNO_0</name>
                           <description>A frame number overflow has not occurred.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FNO_1</name>
                           <description>A frame number overflow has occurred.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RHSC</name>
                     <description>Root Hub Status Change (read/write, write '1' to clear)</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RHSCSelect</name>
                        <enumeratedValue>
                           <name>RHSC_0</name>
                           <description>A root hub status change has not occurred.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RHSC_1</name>
                           <description>A root hub status change has occurred.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OC</name>
                     <description>Ownership Change (read-only)</description>
                     <bitOffset>30</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>HcInterruptEnable</name>
               <description>HC Interrupt Enable Register</description>
               <addressOffset>0x10</addressOffset>
               <fields>
                  <field>
                     <name>SO</name>
                     <description>Scheduling Overrun (read/write, write '1' to set)</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SOSelect</name>
                        <enumeratedValue>
                           <name>SO_0</name>
                           <description>Scheduling overrun interrupts do not propagate.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SO_1</name>
                           <description>When MIE is 1, allows scheduling overrun interrupts to propagate to the level 2 interrupt controller.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WDH</name>
                     <description>Write Done Head (read/write, write '1' to set)</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WDHSelect</name>
                        <enumeratedValue>
                           <name>WDH_0</name>
                           <description>Write done head interrupts do not propagate.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WDH_1</name>
                           <description>When MIE is 1, allows write done head interrupts to propagate to the level 2 interrupt controller.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SF</name>
                     <description>Start of Frame (read/write, write '1' to set)</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SFSelect</name>
                        <enumeratedValue>
                           <name>SF_0</name>
