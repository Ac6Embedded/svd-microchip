                     </writeConstraint>
                     <enumeratedValues>
                        <name>PITENSelect</name>
                        <enumeratedValue>
                           <name>PITEN_0</name>
                           <description>The Periodic Interval Timer is disabled when the PIV value is reached.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PITEN_1</name>
                           <description>The Periodic Interval Timer is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PITIEN</name>
                     <description>Periodic Interval Timer Interrupt Enable</description>
                     <bitOffset>25</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PITIENSelect</name>
                        <enumeratedValue>
                           <name>PITIEN_0</name>
                           <description>The bit PITS in PIT_SR has no effect on interrupt.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PITIEN_1</name>
                           <description>The bit PITS in PIT_SR asserts interrupt.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>SR</name>
