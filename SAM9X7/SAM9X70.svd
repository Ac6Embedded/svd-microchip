                           <value>0xFB</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_FAILURE_DRBG1_ENTROPY</name>
                           <description>The entropy test for DRBG1 failed.</description>
                           <value>0xFC</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>IID_PUF_FAILURE_DRBG_HEALTH</name>
