                        <bitWidth>16</bitWidth>
                     </field>
                     <field>
                        <name>FILTSORD</name>
                        <description>Filter Source or Destination MAC Address</description>
                        <bitOffset>16</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>FILTSORDSelect</name>
                           <enumeratedValue>
                              <name>FILTSORD_0</name>
                              <description>The filter is a destination address filter.</description>
                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>FILTSORD_1</name>
                              <description>The filter is a source address filter.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
