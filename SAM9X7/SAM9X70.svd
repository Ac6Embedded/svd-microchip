                        <name>FILTBMASK</name>
                        <description>Filter Bytes Mask</description>
                        <bitOffset>24</bitOffset>
                        <bitWidth>6</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>FILTBMASKSelect</name>
                           <enumeratedValue>
                              <name>BIT1</name>
                              <description>Controls whether the first byte has been received.</description>
                              <value>0x1</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BIT2</name>
                              <description>Controls whether the second byte has been received.</description>
                              <value>0x2</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BIT3</name>
                              <description>Controls whether the third byte has been received.</description>
                              <value>0x4</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BIT4</name>
                              <description>Controls whether the fourth byte has been received.</description>
                              <value>0x8</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BIT5</name>
                              <description>Controls whether the fifth byte has been received.</description>
                              <value>0x10</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>BIT6</name>
                              <description>Controls whether the sixth byte has been received</description>
                              <value>0x20</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                  </fields>
               </register>
            </cluster>
