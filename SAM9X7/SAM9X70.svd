                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>PO</name>
                     <description>Port Owner (read/write)</description>
                     <bitOffset>13</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>POSelect</name>
                        <enumeratedValue>
                           <name>PO_0</name>
                           <description>This bit unconditionally goes to a 0 when the bit UHPHS_CONFIGFLAG.CF makes a 0 to 1 transition.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PO_1</name>
                           <description>This bit unconditionally goes to 1 whenever the bit UHPHS_CONFIGFLAG.CF=0.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PIC</name>
                     <description>Port Indicator Control (read/write)</description>
                     <bitOffset>14</bitOffset>
                     <bitWidth>2</bitWidth>
                  </field>
                  <field>
                     <name>PTC</name>
                     <description>Port Test Control (read/write)</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>WKCNNT_E</name>
                     <description>Wake on Connect Enable (read/write)</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WKCNNT_ESelect</name>
                        <enumeratedValue>
                           <name>WKCNNT_E_0</name>
