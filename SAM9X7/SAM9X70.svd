                        <name>CP0Select</name>
                        <enumeratedValue>
                           <name>CP0_0</name>
                           <description>No compare 0 has occurred since the last read of the Status register.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CP0_1</name>
                           <description>A compare 0 has occurred since the last read of the Status register.</description>
                           <value>1</value>
