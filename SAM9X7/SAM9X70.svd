                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EN_Q2Select</name>
                        <enumeratedValue>
                           <name>EN_Q2_0</name>
