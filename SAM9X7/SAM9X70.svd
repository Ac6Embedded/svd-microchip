                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>APEN_1</name>
                           <description>Auto Padding feature is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>APM</name>
                     <description>Auto Padding Mode</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>APMSelect</name>
                        <enumeratedValue>
                           <name>APM_0</name>
                           <description>Auto Padding performed according to IPSec standard.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>APM_1</name>
                           <description>Auto Padding performed according to SSL standard.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PLIPEN</name>
                     <description>Protocol Layer Improved Performance Enable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PLIPENSelect</name>
                        <enumeratedValue>
                           <name>PLIPEN_0</name>
                           <description>Protocol layer improved performance is disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PLIPEN_1</name>
                           <description>Protocol layer improved performance is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PLIPD</name>
                     <description>Protocol Layer Improved Performance Decipher</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PLIPDSelect</name>
                        <enumeratedValue>
                           <name>PLIPD_0</name>
                           <description>Protocol layer improved performance is in ciphering mode.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PLIPD_1</name>
                           <description>Protocol layer improved performance is in deciphering mode.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PKRS</name>
                     <description>Private Key Internal Register Select</description>
                     <bitOffset>7</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PKRSSelect</name>
                        <enumeratedValue>
                           <name>PKRS_0</name>
                           <description>The key used by the AES is in the AES_KEYWRx registers.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PKRS_1</name>
                           <description>The key used by the AES is in the Private Key internal registers written via the Private Key bus.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PADLEN</name>
                     <description>Auto Padding Length</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
                  <field>
                     <name>NHEAD</name>
                     <description>IPSec Next Header</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
                  <field>
                     <name>BPE</name>
                     <description>Block Processing End</description>
                     <bitOffset>31</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BPESelect</name>
                        <enumeratedValue>
                           <name>BPE_0</name>
                           <description>AES_ISR.DATRDY flag reports only the end message encryption processing. No intermediate block processing is reported when SMOD=2. When a DMA is used to transfer data, BPE must be cleared.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BPE_1</name>
                           <description>AES_ISR.DATRDY flag reports each end of block processing when SMOD=2. When AES_IDATARx are not loaded by a DMA and SMOD=2, this bit can be written to 1 to rise the AES_ISR.DATRDY flag when a new data block can be written.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
