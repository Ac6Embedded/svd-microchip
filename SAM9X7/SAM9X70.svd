                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLED</name>
                           <description>Transfers are performed in Double Data Rate mode, whereas the instruction field is still transferred in Single Data Rate mode.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
