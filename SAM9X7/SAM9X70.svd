                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WRDIS_1</name>
                           <description>The write capability of the OTPC_DR register is disabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>KBDST</name>
                     <description>Key Bus Destination</description>
