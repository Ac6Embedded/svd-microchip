                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN_Q4</name>
                     <description>Enhanced Scheduled Traffic Enable for Queue 4</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EN_Q4Select</name>
                        <enumeratedValue>
                           <name>EN_Q4_0</name>
                           <description>Disables the enhanced scheduled traffic for queue x.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EN_Q4_1</name>
                           <description>Enables the enhanced scheduled traffic for queue x. EMAC has only 1 queue and ENST is enabled by writing EN_Q0.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EN_Q5</name>
                     <description>Enhanced Scheduled Traffic Enable for Queue 5</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EN_Q5Select</name>
                        <enumeratedValue>
                           <name>EN_Q5_0</name>
                           <description>Disables the enhanced scheduled traffic for queue x.</description>
