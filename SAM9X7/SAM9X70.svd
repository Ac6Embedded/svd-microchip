                     <enumeratedValues>
                        <name>ASPMESelect</name>
                        <enumeratedValue>
                           <name>ASPME_0</name>
                           <description>Park mode is enabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ASPME_1</name>
                           <description>Park mode is disabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ITC</name>
                     <description>Interrupt Threshold Control (read/write)</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
               </fields>
