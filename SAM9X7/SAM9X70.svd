                           <value>5</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR3_CAS6</name>
                           <description>DDR3 CAS write latency 6, DLL enabled or not, DLL On/Off mode</description>
                           <value>6</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>TPR0</name>
               <description>Timing Parameter 0 Register</description>
               <addressOffset>0xC</addressOffset>
               <resetValue>0x20227225</resetValue>
               <fields>
                  <field>
                     <name>TRAS</name>
                     <description>Active to Precharge Delay</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TRCD</name>
                     <description>Row to Column Delay</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TWR</name>
                     <description>Write Recovery Delay</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TRC</name>
                     <description>Row Cycle Delay</description>
                     <bitOffset>12</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TRP</name>
                     <description>Row Precharge Delay</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TRRD</name>
                     <description>Active BankA to Active BankB</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TWTR</name>
                     <description>Internal Write to Read Delay</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>3</bitWidth>
                  </field>
                  <field>
                     <name>TMRD</name>
                     <description>Load Mode Register Command to Activate or Refresh Command</description>
                     <bitOffset>28</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>TPR1</name>
               <description>Timing Parameter 1 Register</description>
               <addressOffset>0x10</addressOffset>
               <resetValue>0x03C80808</resetValue>
               <fields>
                  <field>
                     <name>TRFC</name>
                     <description>Row Refresh Cycle</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>7</bitWidth>
                  </field>
                  <field>
                     <name>TXSNR</name>
                     <description>Exit Self-refresh Delay to Non-Read Command</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
                  <field>
                     <name>TXSRD</name>
                     <description>Exit Self-refresh Delay to Read Command</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
                  <field>
                     <name>TXP</name>
                     <description>Exit Powerdown Delay to First Command</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>TPR2</name>
               <description>Timing Parameter 2 Register</description>
               <addressOffset>0x14</addressOffset>
               <resetValue>0x00042062</resetValue>
               <fields>
                  <field>
                     <name>TXARD</name>
                     <description>Exit Active Power Down Delay to Read Command in Mode 'Fast Exit'</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TXARDS</name>
                     <description>Exit Active Power Down Delay to Read Command in Mode 'Slow Exit'</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TRPA</name>
                     <description>Row Precharge All Delay</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TRTP</name>
                     <description>Read to Precharge</description>
                     <bitOffset>12</bitOffset>
                     <bitWidth>3</bitWidth>
                  </field>
                  <field>
                     <name>TFAW</name>
                     <description>Four Active Windows</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>TMOD</name>
                     <description>Mode Register Set Command Update Delay</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>LPR</name>
               <description>Low-Power Register</description>
               <addressOffset>0x1C</addressOffset>
               <resetValue>0x00010000</resetValue>
               <fields>
                  <field>
                     <name>LPCB</name>
                     <description>Low-power Command Bit</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>LPCBSelect</name>
                        <enumeratedValue>
                           <name>NOLOWPOWER</name>
                           <description>Low-power feature is inhibited. No Powerdown, Self-refresh and Deep power modes are issued to the DDR-SDRAM device.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SELFREFRESH</name>
                           <description>The MPDDRC issues a self-refresh command to the DDR-SDRAM device, the clock(s) is/are deactivated and the CKE signal is set low. The DDR-SDRAM device leaves the Self-refresh mode when accessed and reenters it after the access.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>POWERDOWN</name>
                           <description>The MPDDRC issues a Powerdown command to the DDR-SDRAM device after each access, the CKE signal is set low. The DDR-SDRAM device leaves the Powerdown mode when accessed and reenters it after the access.</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CLK_FR</name>
                     <description>Clock Frozen Command Bit</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CLK_FRSelect</name>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>Clock(s) is/are not frozen.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLED</name>
                           <description>Clock(s) is/are frozen.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TIMEOUT</name>
                     <description>Time Between Last Transfer and Low-Power Mode</description>
                     <bitOffset>12</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TIMEOUTSelect</name>
                        <enumeratedValue>
                           <name>NONE</name>
                           <description>SDRAM Low-power mode is activated immediately after the end of the last transfer.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DELAY_64_CLK</name>
                           <description>SDRAM Low-power mode is activated 64 clock cycles after the end of the last transfer.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DELAY_128_CLK</name>
                           <description>SDRAM Low-power mode is activated 128 clock cycles after the end of the last transfer.</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SELFAUTO</name>
                     <description>Self-refresh Exit Autorefresh</description>
                     <bitOffset>14</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SELFAUTOSelect</name>
                        <enumeratedValue>
                           <name>SELFAUTO_0</name>
                           <description>Upon exiting Self-refresh mode, active command is immediately performed after tXSNR. The autorefresh command is issued every 15.6 s or less.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SELFAUTO_1</name>
                           <description>Upon exiting Self-refresh mode, autorefresh command is immediately performed after tXSNR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>SRT</name>
                     <description>High Temperature Self-refresh Rate</description>
                     <bitOffset>15</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SRTSelect</name>
                        <enumeratedValue>
                           <name>SRT_0</name>
                           <description>1x refresh rate. Industrial and automative devices with temperatures that do not exceed 85C.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SRT_1</name>
                           <description>2x refresh rate. Provides a faster rate on industrial and automotive devices if temperature exceeds 85C.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>APDE</name>
                     <description>Active Power Down Exit Time</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>APDESelect</name>
                        <enumeratedValue>
                           <name>DDR2_FAST_EXIT</name>
                           <description>Fast Exit from Power Down. DDR2-SDRAM and DDR3-SDRAM devices only.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR2_SLOW_EXIT</name>
                           <description>Slow Exit from Power Down. DDR2-SDRAM and DDR3-SDRAM devices only.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>ASR</name>
                     <description>Auto Self-refresh</description>
                     <bitOffset>17</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ASRSelect</name>
                        <enumeratedValue>
                           <name>ASR_0</name>
                           <description>Manual Self-refresh reference must be applied.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ASR_1</name>
                           <description>DRAM manages Self-refresh entry in either the normal or extended temperature range. In this mode, DRAM manages Self-refresh power consumption when operating conditions change - lower at low temperatures and higher at high temperatures.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>UPD_MR</name>
                     <description>Update Load Mode Register and Extended Mode Register</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>UPD_MRSelect</name>
                        <enumeratedValue>
                           <name>NO_UPDATE</name>
                           <description>Update of Load Mode and Extended Mode registers is disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UPDATE_SHAREDBUS</name>
                           <description>MPDDRC shares an external bus. Automatic update is done during a refresh command and a pending read or write access in the SDRAM device.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UPDATE_NOSHAREDBUS</name>
                           <description>MPDDRC does not share an external bus. Automatic update is done before entering Self-refresh mode.</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CHG_FRQ</name>
                     <description>Change Clock Frequency During Self-refresh Mode</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>SELF_DONE</name>
                     <description>Self-refresh is Done (read-only)</description>
                     <bitOffset>25</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>DISTOEN_DONE</name>
                     <description>DLL Disabled to DLL Enabled is Done (read-only)</description>
                     <bitOffset>26</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>MD</name>
               <description>Memory Device Register</description>
               <addressOffset>0x20</addressOffset>
               <resetValue>0x00000013</resetValue>
               <fields>
                  <field>
                     <name>MD</name>
                     <description>Memory Device</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>3</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>MDSelect</name>
                        <enumeratedValue>
                           <name>DDR3_SDRAM</name>
                           <description>DDR3-SDRAM</description>
                           <value>4</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR2_SDRAM</name>
                           <description>DDR2-SDRAM</description>
                           <value>6</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DBW</name>
                     <description>Data Bus Width</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DBWSelect</name>
                        <enumeratedValue>
                           <name>DBW_16_BITS</name>
                           <description>Data bus width is 16 bits.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DDR3_CAL</name>
               <description>DDR3 Calibration Register</description>
               <addressOffset>0x2C</addressOffset>
               <fields>
                  <field>
                     <name>COUNT_CAL</name>
                     <description>DDR3 Calibration Timer Count</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>16</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>DDR3_TIM_CAL</name>
               <description>DDR3 Timing Calibration Register</description>
               <addressOffset>0x30</addressOffset>
               <resetValue>0x00000006</resetValue>
               <fields>
                  <field>
                     <name>ZQCS</name>
                     <description>ZQ Calibration Short</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>IO_CALIBR</name>
               <description>I/O Calibration Register</description>
               <addressOffset>0x34</addressOffset>
               <resetValue>0x00870000</resetValue>
               <fields>
                  <field>
                     <name>CK_F_RANGE</name>
                     <description>DDRCK Maximum Clock Frequency Range</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>5</bitWidth>
                  </field>
                  <field>
                     <name>EN_CALIB</name>
                     <description>Enable Calibration</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EN_CALIBSelect</name>
                        <enumeratedValue>
                           <name>DISABLE_CALIBRATION</name>
                           <description>Calibration is disabled.</description>
                           <value>0x0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLE_CALIBRATION</name>
                           <description>Calibration is enabled.</description>
                           <value>0x1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TZQIO</name>
                     <description>IO Calibration</description>
                     <bitOffset>6</bitOffset>
                     <bitWidth>9</bitWidth>
                  </field>
                  <field>
                     <name>CALCODEP</name>
                     <description>Number of P-type Transistors (read-only)</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
                  <field>
                     <name>CALCODEN</name>
                     <description>Number of N-type Transistors (read-only)</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>OCMS</name>
               <description>OCMS Register</description>
               <addressOffset>0x38</addressOffset>
               <fields>
                  <field>
                     <name>SCR_EN</name>
                     <description>Scrambling Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SCR_ENSelect</name>
                        <enumeratedValue>
                           <name>SCR_EN_0</name>
                           <description>Disables 'Off-chip' scrambling for SDRAM access.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SCR_EN_1</name>
                           <description>Enables 'Off-chip' scrambling for SDRAM access.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TAMPCLR</name>
                     <description>Tamper Clear Enable</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TAMPCLRSelect</name>
                        <enumeratedValue>
                           <name>TAMPCLR_0</name>
                           <description>A tamper detection event has no effect on MPDDRC scrambling keys.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>TAMPCLR_1</name>
                           <description>A tamper detection event immediately clears MPDDRC scrambling keys.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>OCMS_KEY1</name>
               <description>OCMS KEY1 Register</description>
               <addressOffset>0x3C</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>KEY1</name>
                     <description>Off-chip Memory Scrambling (OCMS) Key Part 1</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>32</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>OCMS_KEY2</name>
               <description>OCMS KEY2 Register</description>
               <addressOffset>0x40</addressOffset>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>KEY2</name>
                     <description>Off-chip Memory Scrambling (OCMS) Key Part 2</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>32</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>CONF_ARBITER</name>
               <description>Configuration Arbiter Register</description>
               <addressOffset>0x44</addressOffset>
               <fields>
                  <field>
                     <name>ARB</name>
                     <description>Type of Arbitration</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>ARBSelect</name>
                        <enumeratedValue>
                           <name>ROUND</name>
                           <description>Round-Robin Policy</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NB_REQUEST</name>
                           <description>Request Policy</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BANDWIDTH</name>
                           <description>Bandwidth Policy</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>LQOS</name>
                           <description>Quality of Service Policy</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>KEEP_LAYER</name>
                     <description>Layer (Port) Kept by Host</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>KEEP_LAYERSelect</name>
                        <enumeratedValue>
                           <name>KEEP_LAYER_0</name>
                           <description>No impact on arbitration scheme.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>KEEP_LAYER_1</name>
                           <description>Some hosts, such as LCD or DMA, drive a signal named HNBREQ on the system bus to indicate the number of transfers to be performed. The host with the highest LQOS value and a HNBREQ value different from 0 continues to be granted, even during a last data phase with IDLE cycles. This function is effective if the type of arbitration is LQOS.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BDW_MAX_CUR</name>
                     <description>Bandwidth Max or Current</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BDW_MAX_CURSelect</name>
                        <enumeratedValue>
                           <name>BDW_MAX_CUR_0</name>
                           <description>Current bandwidth is displayed.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BDW_MAX_CUR_1</name>
                           <description>Maximum of the bandwidth is displayed.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RQ_WD_P0</name>
                     <description>Request or Word from Port X</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RQ_WD_P0Select</name>
                        <enumeratedValue>
                           <name>RQ_WD_P0_0</name>
                           <description>Number of requests is selected.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RQ_WD_P0_1</name>
                           <description>Number of words is selected.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RQ_WD_P1</name>
                     <description>Request or Word from Port X</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RQ_WD_P1Select</name>
                        <enumeratedValue>
                           <name>RQ_WD_P1_0</name>
                           <description>Number of requests is selected.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RQ_WD_P1_1</name>
                           <description>Number of words is selected.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>RQ_WD_P2</name>
                     <description>Request or Word from Port X</description>
                     <bitOffset>10</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>RQ_WD_P2Select</name>
                        <enumeratedValue>
                           <name>RQ_WD_P2_0</name>
                           <description>Number of requests is selected.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>RQ_WD_P2_1</name>
                           <description>Number of words is selected.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
