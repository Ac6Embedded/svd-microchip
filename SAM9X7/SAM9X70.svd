                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PITS_1</name>
                           <description>The Periodic Interval timer has reached PIV since the last read of PIT_PIVR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
