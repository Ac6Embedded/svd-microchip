                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WKCNNT_E_1</name>
                           <description>Enables the port to be sensitive to device connects as wake-up events.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>WKDSCNNT_E</name>
                     <description>Wake on Disconnect Enable (read/write)</description>
                     <bitOffset>21</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>WKDSCNNT_ESelect</name>
                        <enumeratedValue>
                           <name>WKDSCNNT_E_0</name>
                           <description>Disables the port to be sensitive to device disconnects as wake-up events.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WKDSCNNT_E_1</name>
                           <description>Enables the port to be sensitive to device disconnects as wake-up events.</description>
                           <value>1</value>
                        </enumeratedValue>
