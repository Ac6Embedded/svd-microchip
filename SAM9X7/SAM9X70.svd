                              <value>0</value>
                           </enumeratedValue>
                           <enumeratedValue>
                              <name>NDAIF_1</name>
                              <description>The channel descriptor is retrieved through system interface 1.</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                     <field>
                        <name>NDA</name>
                        <description>Channel Next Descriptor Address</description>
                        <bitOffset>2</bitOffset>
                        <bitWidth>30</bitWidth>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>CNDC</name>
                  <description>Channel Next Descriptor Control Register </description>
                  <addressOffset>0x1C</addressOffset>
                  <fields>
                     <field>
                        <name>NDE</name>
                        <description>Channel Next Descriptor Enable</description>
                        <bitOffset>0</bitOffset>
                        <bitWidth>1</bitWidth>
                        <writeConstraint>
                           <useEnumeratedValues>true</useEnumeratedValues>
                        </writeConstraint>
                        <enumeratedValues>
                           <name>NDESelect</name>
                           <enumeratedValue>
                              <name>DSCR_FETCH_DIS</name>
