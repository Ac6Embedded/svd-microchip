                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PLLACK</name>
                           <description>PLLACK is selected.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>UPLLCK</name>
