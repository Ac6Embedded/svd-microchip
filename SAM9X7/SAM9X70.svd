                     <bitWidth>8</bitWidth>
                  </field>
                  <field>
                     <name>SMD_ERROR_COUNT</name>
                     <description>Number of Rejected Frames or Fragments due to unknown SMD (Clear on read)</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
               </fields>
