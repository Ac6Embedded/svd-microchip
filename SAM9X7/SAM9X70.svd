                  <field>
                     <name>INTSSL</name>
                     <description>Interrupt Signal for Each Slot</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>2</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>HCVR</name>
               <description>Host Controller Version Register</description>
               <addressOffset>0xFE</addressOffset>
               <size>16</size>
               <access>read-only</access>
               <resetValue>0x1802</resetValue>
               <fields>
                  <field>
                     <name>SVER</name>
                     <description>Specification Version Number</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>8</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>SVERSelect</name>
                        <enumeratedValue>
                           <name>SD1</name>
                           <description>SD Host Specification Version 1.00</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SD2</name>
                           <description>SD Host Specification Version 2.00, including the feature of the ADMA and Test Register</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SD3</name>
                           <description>SD Host Specification Version 3.00</description>
                           <value>2</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>VVER</name>
                     <description>Vendor Version Number</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>8</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>APSR</name>
               <description>Additional Present State Register</description>
               <addressOffset>0x200</addressOffset>
               <access>read-only</access>
               <resetValue>0x0000000F</resetValue>
               <fields>
                  <field>
                     <name>HDATLL</name>
                     <description>DAT[7:4] High Line Level</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>4</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>MC1R</name>
               <description>e.MMC Control 1 Register</description>
               <addressOffset>0x204</addressOffset>
               <size>8</size>
               <fields>
                  <field>
                     <name>CMDTYP</name>
                     <description>e.MMC Command Type</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CMDTYPSelect</name>
                        <enumeratedValue>
                           <name>NORMAL</name>
                           <description>The command is not an e.MMC specific command.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>WAITIRQ</name>
                           <description>This bit must be set to 1 when the e.MMC is in Interrupt mode (CMD40). See 'Interrupt Mode' in the Embedded MultiMedia Card (e.MMC) Electrical Standard 4.51.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>STREAM</name>
                           <description>This bit must be set to 1 in the case of Stream Read(CMD11) or Stream Write (CMD20). Only effective for e.MMC up to revision 4.41.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>BOOT</name>
                           <description>Starts a Boot Operation mode at the next write to SDMMC_CR. Boot data are read directly from e.MMC device.</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DDR</name>
                     <description>e.MMC HSDDR Mode</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DDRSelect</name>
                        <enumeratedValue>
                           <name>DDR_0</name>
                           <description>High Speed DDR is not selected.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR_1</name>
                           <description>High Speed DDR is selected.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OPD</name>
                     <description>e.MMC Open Drain Mode</description>
                     <bitOffset>4</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OPDSelect</name>
                        <enumeratedValue>
                           <name>OPD_0</name>
                           <description>The command line is in push-pull.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OPD_1</name>
                           <description>The command line is in open drain.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>BOOTA</name>
                     <description>e.MMC Boot Acknowledge Enable</description>
                     <bitOffset>5</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>MC2R</name>
               <description>e.MMC Control 2 Register</description>
               <addressOffset>0x205</addressOffset>
               <size>8</size>
               <access>write-only</access>
               <fields>
                  <field>
                     <name>SRESP</name>
                     <description>e.MMC Abort Wait IRQ</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
                  <field>
                     <name>ABOOT</name>
                     <description>e.MMC Abort Boot</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                  </field>
               </fields>
            </register>
            <register>
               <name>ACR</name>
               <description>AHB Control Register</description>
               <addressOffset>0x208</addressOffset>
               <fields>
                  <field>
                     <name>BMAX</name>
                     <description>AHB Maximum Burst</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>2</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>BMAXSelect</name>
                        <enumeratedValue>
                           <name>INCR16</name>
                           <description>The maximum burst size is INCR16.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>INCR8</name>
                           <description>The maximum burst size is INCR8.</description>
                           <value>1</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>INCR4</name>
                           <description>The maximum burst size is INCR4.</description>
                           <value>2</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>SINGLE</name>
                           <description>Only SINGLE transfers are performed.</description>
                           <value>3</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CC2R</name>
               <description>Clock Control 2 Register</description>
               <addressOffset>0x20C</addressOffset>
               <fields>
                  <field>
                     <name>FSDCLKD</name>
                     <description>Force SDCLK Disabled</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>FSDCLKDSelect</name>
                        <enumeratedValue>
                           <name>FSDCLKD_0</name>
                           <description>The SDCLK is forced and it cannot be stopped immediately after the transaction.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FSDCLKD_1</name>
                           <description>The SDCLK is not forced and it can be stopped immediately after the transaction.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>CACR</name>
               <description>Capabilities Control Register</description>
               <addressOffset>0x230</addressOffset>
               <fields>
                  <field>
                     <name>CAPWREN</name>
                     <description>Capabilities Write Enable</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CAPWRENSelect</name>
                        <enumeratedValue>
                           <name>CAPWREN_0</name>
                           <description>Capabilities registers (SDMMC_CA0R, SDMMC_CA1R and SDMMC_MCCAR) cannot be written.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CAPWREN_1</name>
                           <description>Capabilities registers (SDMMC_CA0R, SDMMC_CA1R and SDMMC_MCCAR) can be written.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>KEY</name>
                     <description>Key</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>8</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>KEYSelect</name>
                        <enumeratedValue>
                           <name>KEY</name>
                           <description>Writing any other value in this field aborts the write operation of the CAPWREN bit. Always reads as 0.</description>
                           <value>0x46</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>DBGR</name>
               <description>Debug Register</description>
               <addressOffset>0x234</addressOffset>
               <fields>
                  <field>
                     <name>NIDBG</name>
                     <description>Nonintrusive Debug</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NIDBGSelect</name>
                        <enumeratedValue>
                           <name>DISABLED</name>
                           <description>Reading the SDMMC_BDPR via debugger increments the dual port RAM read pointer.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>ENABLED</name>
                           <description>Reading the SDMMC_BDPR via debugger does not increment the dual port RAM read pointer.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
      </peripheral>
      <peripheral derivedFrom="SDMMC0">
         <name>SDMMC1</name>
         <baseAddress>0x90000000</baseAddress>
         <interrupt>
            <name>SDMMC1</name>
            <description>Secure Data Memory Card Controller 1</description>
            <value>26</value>
         </interrupt>
      </peripheral>
      <peripheral>
         <name>SFR</name>
         <version>051590</version>
         <description>Special Function Registers</description>
         <baseAddress>0xF8050000</baseAddress>
         <addressBlock>
            <offset>0</offset>
            <size>0x264</size>
            <usage>registers</usage>
         </addressBlock>
         <registers>
            <register>
               <name>CCFG_EBICSA</name>
               <description>EBI Chip Select Register</description>
               <addressOffset>0x4</addressOffset>
               <resetValue>0x00000300</resetValue>
               <fields>
                  <field>
                     <name>EBI_CS1A</name>
                     <description>EBI Chip Select 1 Assignment</description>
                     <bitOffset>1</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EBI_CS1ASelect</name>
                        <enumeratedValue>
                           <name>EBI_CS1A_0</name>
                           <description>EBI Chip Select 1 is assigned to the Static Memory Controller (SMC).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EBI_CS1A_1</name>
                           <description>EBI Chip Select 1 is assigned to the AHB Multiport DDR-SDRAM Controller (MPDDRC).</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EBI_CS2A</name>
                     <description>EBI Chip Select 2 Assignment</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EBI_CS2ASelect</name>
                        <enumeratedValue>
                           <name>EBI_CS2A_0</name>
                           <description>EBI Chip Select 2 is only assigned to the SMC and EBI_NCS2 behaves as defined by the SMC.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EBI_CS2A_1</name>
                           <description>EBI Chip Select 2 is assigned to the SMC and the NAND Flash logic is activated.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EBI_DBPUC</name>
                     <description>EBI Data Bus Pullup Configuration</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EBI_DBPUCSelect</name>
                        <enumeratedValue>
                           <name>EBI_DBPUC_0</name>
                           <description>EBI D0-D15 Data Bus bits are internally pulled up to the VDDIOM power supply.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EBI_DBPUC_1</name>
                           <description>EBI D0-D15 Data Bus bits are not internally pulled up.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>EBI_DBPDC</name>
                     <description>EBI Data Bus Pulldown Configuration</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>EBI_DBPDCSelect</name>
                        <enumeratedValue>
                           <name>EBI_DBPDC_0</name>
                           <description>EBI D0-D15 Data Bus bits are not internally pulled down.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>EBI_DBPDC_1</name>
                           <description>EBI D0-D15 Data Bus bits are internally pulled down to the ground.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DQIEN_F</name>
                     <description>Force Analog Input Comparator Configuration</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DQIEN_FSelect</name>
                        <enumeratedValue>
                           <name>DQIEN_F_0</name>
                           <description>No effect</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DQIEN_F_1</name>
                           <description>Enables the input comparator in the VDDIOM I/O data lines. Must be set to one in an initialization phase whenever an MPDDRC external component (DDR2 or LPDDR) and an SMC external component (e.g., NAND Flash) are multiplexed on the D0-D15 bus.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>NFD0_ON_D16</name>
                     <description>NAND Flash Databus Selection</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>NFD0_ON_D16Select</name>
                        <enumeratedValue>
                           <name>NFD0_ON_D16_0</name>
                           <description>NAND Flash I/Os are connected to D0-D7 (default).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>NFD0_ON_D16_1</name>
                           <description>NAND Flash I/Os are connected to D16-D23.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>DDR_MP_EN</name>
                     <description>DDR Multiport Enable</description>
                     <bitOffset>25</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>DDR_MP_ENSelect</name>
                        <enumeratedValue>
                           <name>DDR_MP_EN_0</name>
                           <description>DDR Multiport is disabled (default).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>DDR_MP_EN_1</name>
                           <description>DDR Multiport is enabled, performance is increased.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>OHCIICR</name>
