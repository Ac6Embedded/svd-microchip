                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OSC32EN_1</name>
                           <description>32.768 kHz crystal oscillator is enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>OSC32BYP</name>
                     <description>32.768 kHz Crystal Oscillator Bypass</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>OSC32BYPSelect</name>
                        <enumeratedValue>
                           <name>OSC32BYP_0</name>
                           <description>32.768 kHz crystal oscillator is not bypassed.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>OSC32BYP_1</name>
                           <description>32.768 kHz crystal oscillator is bypassed and accepts an external slow clock on XIN32.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>TD_OSCSEL</name>
                     <description>Timing Domain Slow Clock Selector</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>TD_OSCSELSelect</name>
                        <enumeratedValue>
                           <name>RC</name>
                           <description>Slow clock of the timing domain is driven by the embedded 32 kHz (typical) RC oscillator.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>XTAL</name>
                           <description>Slow clock of the timing domain is driven by the 32.768 kHz crystal oscillator.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
         </registers>
