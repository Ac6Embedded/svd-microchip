                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CHID1_1</name>
                           <description>At least one new channel period has been achieved since the last read of PWM_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CHID2</name>
                     <description>Channel ID</description>
                     <bitOffset>2</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CHID2Select</name>
                        <enumeratedValue>
                           <name>CHID2_0</name>
                           <description>No new channel period has been achieved since the last read of PWM_ISR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CHID2_1</name>
                           <description>At least one new channel period has been achieved since the last read of PWM_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CHID3</name>
                     <description>Channel ID</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CHID3Select</name>
                        <enumeratedValue>
                           <name>CHID3_0</name>
                           <description>No new channel period has been achieved since the last read of PWM_ISR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CHID3_1</name>
                           <description>At least one new channel period has been achieved since the last read of PWM_ISR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <cluster>
               <dim>4</dim>
