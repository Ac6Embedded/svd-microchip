                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>APENSelect</name>
                        <enumeratedValue>
                           <name>APEN_0</name>
