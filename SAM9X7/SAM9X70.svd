            <register>
               <name>SR</name>
               <description>Status Register</description>
               <addressOffset>0x68</addressOffset>
               <access>read-only</access>
               <resetValue>0x00030008</resetValue>
               <fields>
                  <field>
                     <name>MOSCXTS</name>
                     <description>Main Crystal Oscillator Status</description>
                     <bitOffset>0</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>MOSCXTSSelect</name>
                        <enumeratedValue>
                           <name>MOSCXTS_0</name>
                           <description>The main crystal oscillator is not stabilized.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOSCXTS_1</name>
                           <description>The main crystal oscillator is stabilized.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MCKRDY</name>
                     <description>Main System Bus Clock Status</description>
                     <bitOffset>3</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>MCKRDYSelect</name>
                        <enumeratedValue>
                           <name>MCKRDY_0</name>
                           <description>Main System Bus Clock is not ready.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MCKRDY_1</name>
                           <description>Main System Bus Clock is ready.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PCKRDY0</name>
                     <description>Programmable Clock Ready Status</description>
                     <bitOffset>8</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PCKRDY0Select</name>
                        <enumeratedValue>
                           <name>PCKRDY0_0</name>
                           <description>Programmable Clock x is not ready.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PCKRDY0_1</name>
                           <description>Programmable Clock x is ready.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PCKRDY1</name>
                     <description>Programmable Clock Ready Status</description>
                     <bitOffset>9</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PCKRDY1Select</name>
                        <enumeratedValue>
                           <name>PCKRDY1_0</name>
                           <description>Programmable Clock x is not ready.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PCKRDY1_1</name>
                           <description>Programmable Clock x is ready.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MOSCSELS</name>
                     <description>Main Clock Source Oscillator Selection Status</description>
                     <bitOffset>16</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>MOSCSELSSelect</name>
                        <enumeratedValue>
                           <name>MOSCSELS_0</name>
                           <description>Selection is in progress.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOSCSELS_1</name>
                           <description>Selection is done.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MOSCRCS</name>
                     <description>Main RC Oscillator Status</description>
                     <bitOffset>17</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>MOSCRCSSelect</name>
                        <enumeratedValue>
                           <name>MOSCRCS_0</name>
                           <description>The main RC oscillator is not stabilized.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MOSCRCS_1</name>
                           <description>The main RC oscillator is stabilized.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CFDEV</name>
                     <description>Clock Failure Detector Event</description>
                     <bitOffset>18</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CFDEVSelect</name>
                        <enumeratedValue>
                           <name>CFDEV_0</name>
                           <description>No clock failure detection of the main crystal oscillator clock has occurred since the last read of PMC_SR.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CFDEV_1</name>
                           <description>At least one clock failure detection of the main crystal oscillator clock has occurred since the last read of PMC_SR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>CFDS</name>
                     <description>Clock Failure Detector Status</description>
                     <bitOffset>19</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>CFDSSelect</name>
                        <enumeratedValue>
                           <name>CFDS_0</name>
                           <description>A clock failure of the main crystal oscillator clock is not detected.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>CFDS_1</name>
                           <description>A clock failure of the main crystal oscillator clock is detected.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>FOS</name>
                     <description>Clock Failure Detector Fault Output Status</description>
                     <bitOffset>20</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>FOSSelect</name>
                        <enumeratedValue>
                           <name>FOS_0</name>
                           <description>The fault output of the clock failure detector is inactive.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>FOS_1</name>
                           <description>The fault output of the clock failure detector is active. This status is cleared by writing a '1' to FOCLR in PMC_FOCR.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>XT32KERR</name>
                     <description>Slow Crystal Oscillator Error</description>
                     <bitOffset>21</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>XT32KERRSelect</name>
                        <enumeratedValue>
                           <name>XT32KERR_0</name>
                           <description>The frequency of the 32.768 kHz crystal oscillator is correct (32.768 kHz +- 1%) or the monitoring is disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>XT32KERR_1</name>
                           <description>The frequency of the 32.768 kHz crystal oscillator is incorrect or has been incorrect for an elapsed period of time since the monitoring has been enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>MCKMON</name>
                     <description>Main System Bus Clock Clock Monitor Error</description>
                     <bitOffset>23</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>MCKMONSelect</name>
                        <enumeratedValue>
                           <name>MCKMON_0</name>
                           <description>Main System Bus Clock is correct or the CPU clock monitor is disabled.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>MCKMON_1</name>
                           <description>Main System Bus is incorrect or has been incorrect for an elapsed period of time since the monitoring has been enabled.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>GCLKRDY</name>
                     <description>GCLK Ready</description>
                     <bitOffset>24</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>GCLKRDYSelect</name>
                        <enumeratedValue>
                           <name>GCLKRDY_0</name>
                           <description>A GCLK is not ready to use (clock switching in progress).</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>GCLKRDY_1</name>
                           <description>All GCLKs are switched to their selected source clock and ready to use.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
                  <field>
                     <name>PLL_INT</name>
                     <description>PLL Interrupt Status</description>
                     <bitOffset>25</bitOffset>
                     <bitWidth>1</bitWidth>
                     <writeConstraint>
                        <useEnumeratedValues>true</useEnumeratedValues>
                     </writeConstraint>
                     <enumeratedValues>
                        <name>PLL_INTSelect</name>
                        <enumeratedValue>
                           <name>PLL_INT_0</name>
                           <description>No PLL interrupt has occurred.</description>
                           <value>0</value>
                        </enumeratedValue>
                        <enumeratedValue>
                           <name>PLL_INT_1</name>
                           <description>A PLL interrupt has occurred. PLL interrupt is defined by the configuration of the PMC_IMR register.</description>
                           <value>1</value>
                        </enumeratedValue>
                     </enumeratedValues>
                  </field>
               </fields>
            </register>
            <register>
               <name>IMR</name>
