                              <description>Overflow condition has occurred at least once. (This information is only relevant for peripheral synchronized transfers.)</description>
                              <value>1</value>
                           </enumeratedValue>
                        </enumeratedValues>
                     </field>
                  </fields>
               </register>
               <register>
                  <name>CSA</name>
